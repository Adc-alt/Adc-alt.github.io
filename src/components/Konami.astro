---
/**
 * Easter egg: ↑↑↓↓←→←→ B A invierte los neones del tema.
 * Único JS de la página. ~20 líneas, sin dependencias.
 */
---

<script>
  const CODE = [
    "ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown",
    "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight",
    "b", "a",
  ];
  let i = 0;

  addEventListener("keydown", (e) => {
    // Sin distinguir mayúsculas, y sin robar teclas a quien esté escribiendo.
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

    i = e.key.toLowerCase() === CODE[i].toLowerCase() ? i + 1 : 0;
    if (i < CODE.length) return;

    i = 0;
    const root = document.documentElement;
    const on = root.dataset.konami === "on";
    root.dataset.konami = on ? "off" : "on";

    const s = root.style;
    if (on) {
      s.removeProperty("--color-neon-cyan");
      s.removeProperty("--color-neon-magenta");
    } else {
      s.setProperty("--color-neon-cyan", "#ff3d9a");
      s.setProperty("--color-neon-magenta", "#35e7f5");
    }

    const msg = document.createElement("div");
    msg.textContent = on ? "SYSTEM RESTORED" : "CHEAT MODE ENABLED";
    msg.setAttribute("role", "status");
    msg.style.cssText =
      "position:fixed;inset-inline:0;top:35%;z-index:99;text-align:center;" +
      "font-family:var(--font-display);font-size:.8rem;color:var(--color-neon-amber);" +
      "text-shadow:0 0 18px currentColor;pointer-events:none";
    document.body.append(msg);
    setTimeout(() => msg.remove(), 1600);
  });
</script>
