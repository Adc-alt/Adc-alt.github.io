---
interface Props {
  /** Etiqueta pequeña de HUD sobre el título. */
  kicker?: string;
  title: string;
  /** Nivel real del encabezado. El estilo no cambia; la jerarquía sí. */
  as?: "h2" | "h3";
}

const { kicker, title, as: Tag = "h2" }: Props = Astro.props;
---

<div class="mb-8 space-y-3">
  {
    kicker && (
      <p class="hud-label flex flex-wrap items-center gap-x-2">
        <span class="inline-block h-px w-6 bg-neon-cyan/60" aria-hidden="true" />
        {kicker}
      </p>
    )
  }
  <Tag class="text-[clamp(0.8rem,3.8vw,1.2rem)] text-ink">{title}</Tag>
</div>
