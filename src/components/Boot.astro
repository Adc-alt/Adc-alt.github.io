---
/**
 * A BIOS POST-style boot screen. A curtain, not a maze.
 *
 * Traced from the first page of https://senna.social/. The measurements, the
 * colours and the timings are NOT decisions made here: they are measured off
 * the reference with the inspector. Touch one and the resemblance goes.
 *
 *   Measurements, reasons and captures → docs/superpowers/specs/2026-08-14-boot-screen-senna-parity.md
 *   Text and timings                   → ./boot-data.mjs (with a test that locks them)
 *
 * How it behaves, in case it needs debugging:
 *  - Which routes it appears on is decided by whoever mounts it, via the `paths`
 *    prop; by default the two addresses of the root, which since phase 2 is the
 *    whole site. The 404 does not mount it on purpose: you reach a 404 by
 *    accident, and that is no moment for an animation.
 *  - All the JS is `is:inline` and synchronous. If the browser does not run JS,
 *    the overlay stays at `display:none` and the portfolio works the same. That
 *    is why the script SHOWS it instead of hiding it: the other way round, a JS
 *    failure would leave the site covered by a black screen.
 *  - The first script goes BEFORE the markup: that way a repeat visitor does not
 *    see even one frame of the boot screen.
 */
import {
  HEAD, LOADING, SPECS, COUNT, DEVICES, TAIL, PROMPT, T, AUTO_MS,
} from "./boot-data.mjs";

interface Props {
  /**
   * Routes where it may appear. By default only the root, which has two
   * addresses because GitHub Pages serves the same page at "/" and at
   * "/index.html".
   */
  paths?: string[];
  /**
   * The localStorage key for "already seen this". One per booting route: if two
   * routes share a key, the second never boots for anyone who saw the first.
   */
  seenKey?: string;
}

const { paths = ["/", "/index.html"], seenKey = "boot_seen" } = Astro.props;
---

{/* 1. Anti-flash. It goes before the markup on purpose: it decides whether the
      screen exists at all, so a repeat visitor does not see a single frame. */}
<script is:inline define:vars={{ paths, seenKey }}>
  (function () {
    // `define:vars` is the only way for an inline script to see the
    // frontmatter, and there is no alternative here: this script runs BEFORE
    // the markup, so it cannot read the value off a data-* in the DOM the way
    // script 2 does. Astro serialises it as a `const` in front of the IIFE.
    if (paths.indexOf(location.pathname) === -1) return;
    try {
      if (localStorage.getItem(seenKey)) return;
    } catch (e) {
      /* private mode: boot anyway */
    }
    document.documentElement.setAttribute("data-boot", "on");
  })();
</script>

{/* `data-*` is the bridge to the inline script: an `is:inline` cannot see the
    frontmatter variables, so the value travels through the DOM. */}
<div id="boot" data-auto={AUTO_MS} data-seen-key={seenKey}>
  <div class="boot-inner">
    <div class="boot-screen">
      {/* The aria-hidden goes here and NOT on the wrapper: if it covered the
          button too, the overlay would become a dead end for a screen reader,
          and an aria-hidden="false" on the child does not rescue it. */}
      <div class="boot-text" aria-hidden="true">
        <div class="boot-container">
          {/* A compliance seal, in the slot where PCs of the era put the Energy
              Star sticker. 42x58 like the reference's, but drawn here: theirs is
              their own PNG and is not copied. */}
          <svg
            class="boot-icon r"
            data-d={T.icon}
            viewBox="0 0 21 29"
            width="42"
            height="58"
            role="presentation"
          >
            <circle cx="10.5" cy="9.5" r="8" fill="none" stroke="#d94f3d" stroke-width="2"></circle>
            <circle cx="10.5" cy="9.5" r="4.5" fill="none" stroke="#d94f3d" stroke-width="1.4"></circle>
            <path d="M5.5 16.5 L3.5 28 L10.5 24 L17.5 28 L15.5 16.5 Z" fill="#d94f3d"></path>
          </svg>

          <div class="text-container">
            <span class="r" data-d={T.title}>{HEAD.title}</span>
            <span class="r" data-d={T.copy}>{HEAD.copy}</span>
          </div>

          <div class="boot-logo r" data-d={T.logo}>
            {/* The maker's doodle, where the reference has its own. Same idea —
                one yellow pen stroke: a halo over a signature that ends in a
                face — but drawn here, letter by letter, with my name in it.
                Their PNG is theirs and is not copied.

                #fdff54 IS measured off their PNG (4164 opaque pixels of that
                exact value), the same way the green of the strapline below was.
                Two colours, one homage; the drawing is not shared.

                266x148 is the reference's own logo box minus the strapline,
                which here is live text and not part of the drawing. */}
            <svg viewBox="0 0 266 148" width="266" height="148" role="presentation">
              <g
                fill="none"
                stroke="#fdff54"
                stroke-width="3.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {/* halo */}
                <path d="M26 126 C6 118 2 92 8 66 C16 32 62 8 118 6 C170 4 214 22 234 52 C244 68 246 76 244 84"></path>
                {/* a */}
                <path d="M35 96 C31 90 22 90 17 97 C12 104 13 113 19 116 C25 119 32 114 34 107"></path>
                <path d="M34 93 L35 112 C35 117 39 118 42 113"></path>
                {/* n */}
                <path d="M42 114 C43 106 44 100 45 94 C47 89 54 89 57 96 C58 102 58 109 58 114 C58 117 61 118 63 115"></path>
                {/* t, stem then crossbar */}
                <path d="M63 115 C65 105 68 88 70 74 C71 67 68 66 67 72 C65 82 64 102 65 111 C65 116 70 117 74 112"></path>
                <path d="M58 89 L79 86"></path>
                {/* h */}
                <path d="M78 114 C80 100 82 82 84 70 C85 63 90 63 89 71 C88 81 84 97 83 108 C82 113 83 114 84 112 C86 98 89 91 93 90 C98 89 101 95 101 102 C101 108 101 111 101 114 C101 117 104 118 106 115"></path>
                {/* o */}
                <path d="M106 115 C108 105 112 94 119 92 C126 90 129 98 127 106 C125 114 118 118 113 114 C108 110 109 100 116 95 C122 91 128 92 131 96"></path>
                {/* n */}
                <path d="M131 114 C132 106 133 100 134 94 C136 89 143 89 146 96 C147 102 147 109 147 114 C147 117 150 118 152 115"></path>
                {/* y, with the descender that turns into the flourish */}
                <path d="M152 96 C151 104 151 111 153 114 C156 118 161 116 164 110 C167 103 168 98 169 94 C169 104 168 116 165 126 C161 138 153 143 147 139"></path>
                {/* the join from the y into the face */}
                <path d="M169 95 C172 91 174 89 176 88"></path>
                {/* the face. The eyes are filled, everything else is a stroke. */}
                <circle cx="209" cy="96" r="35"></circle>
                <circle cx="199" cy="88" r="2.6" fill="#fdff54"></circle>
                <circle cx="218" cy="88" r="2.6" fill="#fdff54"></circle>
                <path d="M196 106 C202 114 214 114 220 105"></path>
              </g>
            </svg>
            <span class="boot-mark">{HEAD.mark}</span>
          </div>
        </div>

        <div class="boot-gap"></div>

        <span class="r" data-d={T.loading}>{LOADING}</span>

        <div class="boot-gap"></div>

        {
          SPECS.map((s, i) => (
            <div class="aligned-section aligned-section--wide">
              <span class="r" data-d={T.spec[i]}>{s.k}</span>
              {s.count ? (
                <>
                  <span
                    class="r number"
                    data-d={T.count}
                    data-numbers={COUNT.numbers.join(",")}
                    data-intervals={COUNT.intervals.join(",")}
                  >
                    {s.v}
                  </span>
                  <span class="r unit" data-d={T.spec[i]}>{s.unit}</span>
                </>
              ) : (
                <span class="r" data-d={T.spec[i]}>{s.v}</span>
              )}
            </div>
          ))
        }

        <div class="boot-gap"></div>

        {
          DEVICES.map((d, i) => (
            <div class="aligned-section">
              <span class="r" data-d={T.name[i]}>{d.k}</span>
              <span class="r" data-d={T.name[i]}>...</span>
              <span class="r" data-d={T.verdict[i]}>{d.s}</span>
            </div>
          ))
        }

        <div class="boot-gap"></div>

        {/* The space is hard-coded (\u00a0):a normal one at the start of an
            inline-block collapses and it would read "inserted :lego-island-two.pcm". */}
        <span class="r" data-d={T.tailKey}>{TAIL.k}</span><span
          class="r"
          data-d={T.tailValue}>{"\u00a0" + TAIL.v}</span
        >
      </div>

      {/* The reference uses a <span> here. A <span> cannot be tabbed to and a
          screen reader does not announce it, so the overlay would have no way
          out without a mouse. The text is identical; only the tag changes. */}
      <button id="boot-enter" class="r blinking" type="button" data-d={T.prompt}>
        {PROMPT}
      </button>
    </div>
  </div>
</div>

{/* 2. Behaviour. Inline and synchronous, no imports: this is the one that TAKES
      IT AWAY — the one that shows it is script 1, above the markup. */}
<script is:inline>
  (function () {
    var el = document.getElementById("boot");
    if (!el) return;
    if (document.documentElement.getAttribute("data-boot") !== "on") {
      el.remove(); // not booting this time: out of the DOM and move on
      return;
    }

    var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    var done = false;
    // 0 = it waits, like the reference. See AUTO_MS in boot-data.mjs.
    var auto = Number(el.getAttribute("data-auto")) || 0;
    var timers = [];

    var btn = document.getElementById("boot-enter");
    // The exit listeners go first, before anything that could fail further
    // down: script 1 has already switched the screen on, and if a future edit
    // breaks the syntax of something below, without these the front page stays
    // black, unscrollable and with no way out for ever (boot_seen would never
    // get set either). `enter` is a `function`, so it is hoisted: referencing
    // it here is safe even though it is declared below.
    addEventListener("keydown", enter, true);
    addEventListener("pointerdown", enter, true);
    if (btn) btn.addEventListener("click", enter);

    if (auto > 0) timers.push(setTimeout(enter, auto));

    var nodes = el.querySelectorAll(".r");

    // Each element appears at ITS OWN time, not in a chain. The timings come
    // from the frontmatter via `data-d`: an `is:inline` cannot see Astro's
    // variables.
    for (var i = 0; i < nodes.length; i++) {
      (function (n) {
        var ms = reduce ? 0 : Number(n.getAttribute("data-d")) || 0;
        timers.push(
          setTimeout(function () {
            n.classList.add("on");
            if (n.hasAttribute("data-numbers") && !reduce) contar(n);
          }, ms),
        );
      })(nodes[i]);
    }

    // The memory counter. It starts at the NOMINAL time, not the visible one:
    // in the reference it comes out of the same setTimeout that switches the
    // line on, so its first 500ms run hidden behind the visibility. That is
    // deliberate.
    function contar(n) {
      var vals = n.getAttribute("data-numbers").split(",");
      var ivs = n.getAttribute("data-intervals").split(",").map(Number);
      var k = 0;
      n.textContent = vals[0];
      (function paso() {
        var espera = ivs[k];
        if (++k >= vals.length) return;
        timers.push(
          setTimeout(function () {
            n.textContent = vals[k];
            paso();
          }, espera),
        );
      })();
    }

    // `pointerdown` fires before `touchstart`/`click` in every browser with
    // Pointer Events: by the time the compatibility click of a tap arrives
    // (50-150ms later), `enter()` has already run and `#boot` has spent that
    // long shrinking (`crt-off`, `scaleY(0.008)`), which collapses its hit box
    // too. Without swallowing that click, it lands on whatever is under the
    // point that was tapped (menu links, cards). That is why no separate
    // `touchstart` listener is needed: `pointerdown` already covers the tap,
    // and all that is left is swallowing that late click.
    var eat = function (e) {
      e.preventDefault();
      e.stopPropagation();
    };

    function enter() {
      if (done) return;
      done = true;
      for (var i = 0; i < timers.length; i++) clearTimeout(timers[i]);
      removeEventListener("keydown", enter, true);
      removeEventListener("pointerdown", enter, true);
      // Installed HERE, inside enter(): the button's own click has already
      // reached its listener before this, so clicking with a mouse is
      // unaffected.
      addEventListener("click", eat, true);

      try {
        // From the DOM and not the frontmatter: this script has no
        // `define:vars`. No fallback on purpose: if `seenKey=""` were read here
        // as "boot_seen", script 1 (which does read `seenKey` from the
        // frontmatter via `define:vars`) would keep checking the empty key and
        // the boot screen would never stop repeating, besides trampling the
        // front page's key. Without the fallback, `seenKey=""` is odd but
        // consistent between the two scripts.
        localStorage.setItem(el.getAttribute("data-seen-key"), "1");
      } catch (e) {
        /* private mode */
      }

      // "off" instead of removing the attribute: it gives the scroll back but
      // keeps the screen visible while it shuts down.
      document.documentElement.setAttribute("data-boot", "off");

      var finish = function () {
        el.remove();
        document.documentElement.removeAttribute("data-boot");
        removeEventListener("click", eat, true);
        var main = document.getElementById("content");
        if (main) {
          main.setAttribute("tabindex", "-1");
          main.focus({ preventScroll: true });
        }
      };
      if (reduce) return finish();
      el.classList.add("is-off");
      setTimeout(finish, 300);
    }
  })();
</script>

<style>
  /* AcPlus IBM VGA 8x16 — VileR, https://int10h.org/oldschool-pc-fonts/ (CC BY-SA 4.0).
     The full licence travels with the file, in /fonts/, and the credit it
     requires is in the Contact window (the site footer it used to live in went
     away with the arcade look).

     ⚠️ It has to be the **AcPlus** variant (aspect-corrected), not Web/WebPlus.
     The original 8x16 was seen on a 720x400 VGA stretched onto a 4:3 screen —
     that is, with pixels taller than they are wide. AcPlus bakes that stretch
     in: the advance is 0.4167em (9.99px at 24px) instead of 0.5em. With WebPlus
     the letters come out square and wide, and that alone breaks the resemblance
     however well everything else lines up. */
  @font-face {
    font-family: "AcPlus IBM VGA 8x16";
    src: url("/fonts/AcPlus_IBM_VGA_8x16.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    /* `block`: nothing appears before 1.5s, so there is plenty of time to load
       it and nobody sees a line in the fallback typeface jumping. */
    font-display: block;
  }

  /* By default it does NOT exist. Only the inline script switches it on: if the
     JS fails, the visitor sees the portfolio and not a black screen with no way
     out. */
  #boot {
    display: none;
  }
  :global(html[data-boot="on"]) #boot,
  :global(html[data-boot="off"]) #boot {
    display: block;
    position: fixed;
    inset: 0;
    /* Above everything, including the site's CRT layers (z 58-60) and the
       skip-to-content link (z 100). */
    z-index: 200;
    overflow: hidden;
  }
  /* No scrolling behind while it boots. */
  :global(html[data-boot="on"] body) {
    overflow: hidden;
  }

  /* ── Base ────────────────────────────────────────────────────────────────
     Reference: body{background:#060606;color:#b3b3b3}
                span{color:#dedede;font-size:24px;line-height:1.3}
     The BODY of the POST is monochrome: grey on black, like a real VGA text
     mode. The only colour that breaks that is the green of `.boot-mark`
     (§ Header, below), and it is separate on purpose: it is the manufacturer's
     mark, not POST text — in the reference it also lives outside this
     monochrome. Any OTHER colour would break the resemblance and turn this into
     a terminal theme. */
  #boot {
    background: #060606;
    color: #b3b3b3;
    font-family: "AcPlus IBM VGA 8x16", var(--font-mono), monospace;
    font-size: 24px;
    line-height: 1.3;
  }
  /* A 390px phone cannot take 24px. Because the columns are in `ch`, the whole
     grid shrinks with the font and keeps its shape. It is the one thing that is
     not copied, because the reference simply overflows on a phone. */
  @media (max-width: 700px) {
    #boot {
      font-size: 16px;
    }
  }

  /* The reference's `main{padding:1%}`, plus the 8px margin on its body. */
  .boot-inner {
    padding: calc(8px + 1%);
    height: 100dvh;
    overflow: hidden;
  }
  #boot span {
    display: inline-block;
    color: #dedede;
  }

  /* ── The appearance ──────────────────────────────────────────────────────
     Copied literally from the reference, and it is NOT a fade even though it
     looks like one. `visibility` lasts 0s but has a 0.5s DELAY, so the opacity
     goes from 0 to 1 with the element still `hidden`. By the time you can see
     it, it is already opaque: each line appears all at once, 500ms after the
     time `boot-data.mjs` gives.

     Measured on the reference: "Loading..." has a delay of 1400 and becomes
     visible at 1898ms, with opacity already at 1. It is a bug of theirs, but
     you can see it, so it gets copied.
     ⚠️ Do NOT "fix" it by removing the visibility line: you would change the
     character of the whole screen. */
  .r {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s 0.5s;
  }
  .r.on {
    opacity: 1;
    visibility: visible;
  }

  /* The reference's <br><br> sit outside the spans, that is, at its body's line
     height (16px) and not the 24px of the text: 32px in the reference. Here it
     is expressed in `em` of the boot font (24px, or 16px below the 700px phone
     breakpoint) and not in fixed px, so the gap shrinks with it like the rest of
     the grid. */
  .boot-gap {
    height: 1.3em;
  }

  /* ── The grid ────────────────────────────────────────────────────────────
     Reference:
       .aligned-section              { display:flex; flex-wrap:wrap; gap:20px }
       .aligned-section span         { min-width:200px }
       .aligned-section span:nth-child(2) { min-width:40px; text-align:center }
       .number { width:20px; text-align:right }  .unit { margin-left:-20px }
       plus the specs block with gap:50px.

     Here it is in `ch` and not px: at 24px a `ch` of this font is 9.99px, so
     20ch is exactly those 200px — but it also shrinks by itself when the phone
     drops the font size. With fixed px it would not.

     Check: label at x=20, dots at 240, verdict at 300, spec value at 270 and the
     unit at 340. Those are the reference's. */
  .aligned-section {
    display: flex;
    flex-wrap: wrap; /* on a narrow screen it wraps, like the reference */
    gap: 2ch;
  }
  .aligned-section > span {
    min-width: 20ch;
  }
  .aligned-section > span:nth-child(2) {
    min-width: 4ch;
    text-align: center;
  }
  /* The memory counter is not a dot, it is a number: the reference declares
     `.number{width:20px;text-align:right}`, but the `min-width:40px` of the rule
     above RAISES that width to 40 — a min-width above a smaller width wins.
     Those 40px (not the 20 that `.number` states on its own) are what put `KB`
     at x=340, which is the number measured against the reference. That is why
     this is `4ch` and not the `2ch` that `.number` literally declares. Its
     `text-align:right` still loses against the `text-align:center` of that same
     rule above (0,2,1 against `.number`'s 0,2,0), and that dead declaration gets
     copied too: which is why the type selector `span` is NOT added here, as it
     would tie the specificity and let it win on order. */
  .aligned-section > .number {
    width: 4ch;
    text-align: right;
  }
  .aligned-section > span:last-child {
    text-align: left;
  }
  .aligned-section--wide {
    gap: 5ch;
  }
  .aligned-section > .unit {
    margin-left: -2ch;
  }

  /* ── Header ──────────────────────────────────────────────────────────────
     Icon on the left, two lines beside it, and the maker's mark floating on the
     right with its rule and its strapline, like a PC from 1998. */
  .boot-container {
    display: flex;
    align-items: flex-start;
    position: relative;
    width: 100%;
  }
  .boot-icon {
    flex: none;
    margin-right: 15px;
  }
  .text-container {
    display: flex;
    flex-direction: column;
  }
  /* Anchor: `.boot-container`, which is the nearest `position: relative` (not
     `.boot-screen`, which contributes nothing here). Same as the reference, and
     with the same box height (62.38px measured on both): the `top: 10%` resolves
     to the same 6.23px. */
  .boot-logo {
    position: absolute;
    right: 0;
    top: 10%;
    text-align: center;
  }
  /* #71f662: sampled from the reference logo's PNG (1452 opaque pixels of that
     exact value), not picked by eye. With `#boot .boot-mark` (1,1,0) it already
     beats `#boot span` (1,0,1) without needing `!important`. */
  #boot .boot-mark {
    display: block;
    padding-top: 4px;
    border-top: 2px solid #71f662;
    color: #71f662;
    white-space: nowrap;
    font-size: 0.8em;
  }
  /* On a phone there is no room: the text wins. */
  @media (max-width: 700px) {
    .boot-logo {
      display: none;
    }
  }

  /* ── The prompt ──────────────────────────────────────────────────────────
     It does not blink with opacity: it inverts the video, black on white and
     back, in hard steps. It is the block cursor of a text console. */
  #boot-enter {
    /* The reference's eight <br>: 112px of air, measured. */
    margin-top: calc(1.3em * 3.6);
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: #ffffff;
  }
  #boot-enter:focus-visible {
    outline: 2px solid #dedede;
    outline-offset: 4px;
  }
  .blinking {
    display: inline-block;
    animation: blink-effect 1s steps(1, start) infinite;
  }
  @keyframes blink-effect {
    0% {
      color: #ffffff;
      background-color: #060606;
    }
    50% {
      color: #060606;
      background-color: #ffffff;
    }
    100% {
      color: #ffffff;
      background-color: #060606;
    }
  }

  /* No scanlines, no vignette, no curvature: the reference has none of them and
     they are the first thing that turns a homage into a parody. The only effect
     is the tube switching off on exit, which covers the cut to the portfolio
     (the reference does not need it because it navigates to another page). */
  #boot.is-off {
    animation: crt-off 300ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes crt-off {
    0% {
      transform: scaleY(1) scaleX(1);
      filter: brightness(1);
    }
    55% {
      transform: scaleY(0.008) scaleX(1);
      filter: brightness(3.5);
    }
    100% {
      transform: scaleY(0.008) scaleX(0);
      filter: brightness(6);
      opacity: 0;
    }
  }

  /* No motion: the whole text at once, no counter, no blink and no shutdown. */
  @media (prefers-reduced-motion: reduce) {
    .r {
      transition: none;
    }
    .blinking {
      animation: none;
    }
    #boot.is-off {
      animation: none;
    }
  }
</style>
