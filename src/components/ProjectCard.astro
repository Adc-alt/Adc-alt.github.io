---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"proyectos">;
}

const { project } = Astro.props;
const { title, summary, stack, year, status, accent } = project.data;

const accentVar = {
  cyan: "var(--color-neon-cyan)",
  magenta: "var(--color-neon-magenta)",
  amber: "var(--color-neon-amber)",
  lime: "var(--color-neon-lime)",
}[accent];

// Sin acentos: se pintan en tipografía display. Ver el aviso en consts.ts.
const statusLabel = {
  live: "ACTIVO",
  wip: "EN CURSO",
  archived: "ARCHIVADO",
}[status];
---

<article
  class="panel panel-corners group relative flex h-full flex-col overflow-hidden p-5 transition-transform duration-200 hover:-translate-y-1"
  style={`--accent:${accentVar}`}
>
  <!-- Marquesina superior: la banda de color del mueble -->
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-0.5 opacity-60 transition-opacity duration-200 group-hover:opacity-100"
    style="background:var(--accent);box-shadow:0 0 16px var(--accent)"
  ></span>

  <header class="mb-3 flex items-start justify-between gap-3">
    <h3 class="text-[0.8rem] leading-relaxed" style="color:var(--accent)">
      <a href={`/proyectos/${project.id}/`} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>
    <span class="hud-label shrink-0 pt-1">{year}</span>
  </header>

  <p class="mb-5 flex-1 text-sm text-dim">{summary}</p>

  <footer class="space-y-3">
    <ul class="flex flex-wrap gap-1.5">
      {
        stack.map((tech) => (
          <li class="border border-[var(--edge)] px-2 py-0.5 text-[0.65rem] text-faint">
            {tech}
          </li>
        ))
      }
    </ul>

    <p class="hud-label flex items-center gap-2">
      <span
        aria-hidden="true"
        class="inline-block h-1.5 w-1.5 rounded-full"
        style="background:var(--accent);box-shadow:0 0 8px var(--accent)"
      ></span>
      {statusLabel}
    </p>
  </footer>
</article>
