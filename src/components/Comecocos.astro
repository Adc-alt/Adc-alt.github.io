---
/**
 * Comecocos jugable. Canvas 2D, sin dependencias, ~9 KB de JS.
 *
 * Es el único JS con peso del sitio y solo se carga aquí. Se pausa solo cuando
 * sale del viewport o cambias de pestaña, así que no come batería de fondo.
 *
 * El mapa vive en comecocos-maze.js y lo valida `pnpm test`.
 */
---

<div class="mx-auto w-full max-w-[30rem]">
  <div class="panel panel-corners p-3 sm:p-4">
    {/* ---------- HUD ---------- */}
    <div class="mb-3 flex items-end justify-between gap-2">
      <div>
        <p class="hud-label">Score</p>
        <p class="neon-amber font-display text-[0.75rem]" data-cc="score">000000</p>
      </div>
      <div class="text-center">
        <p class="hud-label">Nivel</p>
        <p class="font-display text-[0.75rem] text-ink" data-cc="level">01</p>
      </div>
      <div class="text-right">
        <p class="hud-label">Record</p>
        <p class="font-display text-[0.75rem] text-dim" data-cc="hi">000000</p>
      </div>
    </div>

    {/* ---------- PANTALLA ---------- */}
    <div class="relative">
      <canvas
        data-cc="canvas"
        width="448"
        height="496"
        class="block w-full max-w-[28rem] mx-auto"
        style="aspect-ratio:28/31"
        aria-label="Juego del comecocos. Se controla con las flechas del teclado o con la cruceta de abajo."
        role="img"></canvas>

      <div
        data-cc="overlay"
        class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-void/85 text-center"
      >
        <p
          data-cc="msg"
          class="neon-cyan font-display text-[0.7rem] tracking-widest sm:text-[0.85rem]"
        >
          Comecocos
        </p>
        <button type="button" data-cc="start" class="btn-arcade">Start</button>
      </div>
    </div>

    {/* ---------- VIDAS + CRUCETA ---------- */}
    <div class="mt-3 flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="hud-label">Vidas</span>
        <span data-cc="lives" class="flex gap-1.5"></span>
      </div>
      <button
        type="button"
        data-cc="pause"
        class="hud-label transition-colors hover:text-neon-cyan"
      >
        Pausa
      </button>
    </div>

    {/* La cruceta solo en pantallas donde no hay teclado a mano. */}
    <div class="mt-4 grid grid-cols-3 gap-1.5 justify-items-center sm:hidden">
      <span></span>
      <button type="button" class="cc-pad" data-dir="0" aria-label="Arriba">&#94;</button>
      <span></span>
      <button type="button" class="cc-pad" data-dir="1" aria-label="Izquierda">&lt;</button>
      <span></span>
      <button type="button" class="cc-pad" data-dir="3" aria-label="Derecha">&gt;</button>
      <span></span>
      <button type="button" class="cc-pad" data-dir="2" aria-label="Abajo">v</button>
      <span></span>
    </div>

    <p class="mt-3 text-center text-xs text-faint">
      Flechas o <kbd>WASD</kbd> para moverte. <kbd>Espacio</kbd> pausa.
    </p>
  </div>
</div>

<style>
  /* :global porque los iconos de vida los crea el JS: no llevan el atributo de
     scoping que Astro le pone al markup del template y la regla no les caeria. */
  :global(.cc-life) {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-neon-amber);
    box-shadow: 0 0 8px var(--color-neon-amber);
    /* El mordisco */
    clip-path: polygon(100% 32%, 45% 50%, 100% 68%, 100% 100%, 0 100%, 0 0, 100% 0);
  }

  .cc-pad {
    width: 100%;
    max-width: 4rem;
    aspect-ratio: 1;
    font-family: var(--font-display);
    font-size: 0.7rem;
    color: var(--color-neon-cyan);
    background: var(--color-panel-hi);
    border: 1px solid var(--edge);
    border-radius: var(--radius-cabinet);
    touch-action: manipulation;
    -webkit-user-select: none;
    user-select: none;
  }
  .cc-pad:active {
    background: color-mix(in oklab, var(--color-neon-cyan) 25%, var(--color-panel-hi));
  }
</style>

<script>
  import { MAZE, COLS, ROWS, HOUSE } from "./comecocos-maze.js";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-cc='canvas']");
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx) boot(canvas, ctx);

  function boot(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D) {
    // ---------------------------------------------------------------- setup
    const TS = 16;
    const HALF = TS / 2;
    const W = COLS * TS; // 448
    const H = ROWS * TS; // 496

    // El laberinto no cambia nunca: se pinta una vez aquí y luego se copia.
    const bg = document.createElement("canvas");
    bg.width = W;
    bg.height = H;
    const maybeBgc = bg.getContext("2d");
    if (!maybeBgc) return;
    const bgc: CanvasRenderingContext2D = maybeBgc;

    // Orden arriba, izquierda, abajo, derecha: es el desempate del arcade.
    const DX = [0, -1, 0, 1];
    const DY = [-1, 0, 1, 0];
    const ANG = [-Math.PI / 2, Math.PI, Math.PI / 2, 0];
    const rev = (d: number) => d ^ 2;

    const $ = (k: string) => document.querySelector<HTMLElement>(`[data-cc='${k}']`);
    const elScore = $("score"), elHi = $("hi"), elLevel = $("level"), elLives = $("lives");
    const elOverlay = $("overlay"), elMsg = $("msg");
    const elStart = $("start") as HTMLButtonElement | null;
    const elPause = $("pause");

    // Colores del tema. Se releen al empezar partida, así el Konami también
    // repinta el juego.
    let COL = readTheme();
    function readTheme() {
      const s = getComputedStyle(document.documentElement);
      const v = (n: string, f: string) => s.getPropertyValue(n).trim() || f;
      return {
        wall: v("--color-neon-cyan", "#35e7f5"),
        dot: v("--color-dim", "#99a1bd"),
        pac: v("--color-neon-amber", "#ffc53d"),
        void: v("--color-void", "#05060b"),
        fright: "#3a5bff",
        ghost: [
          v("--color-neon-magenta", "#ff3d9a"),
          "#ffa8d8",
          v("--color-neon-cyan", "#35e7f5"),
          v("--color-neon-lime", "#7cff6b"),
        ],
      };
    }

    // -------------------------------------------------------------- estado
    type Phase = "idle" | "ready" | "play" | "dead" | "clear" | "over";
    type GState = "house" | "leaving" | "out" | "eyes" | "entering";

    interface Ghost {
      x: number; y: number; dir: number; kind: number;
      home: { c: number; r: number };
      corner: { c: number; r: number };
      state: GState;
      /** Sale al comer estos puntos... */
      dots: number;
      /** ...o cuando se agota este plazo, para el que se queda quieto. */
      delay: number;
      release: number;
    }

    let grid: string[][] = [];
    let dotsLeft = 0;
    let score = 0, level = 1, lives = 3;
    let hi = loadHi();
    let tick = 0, phaseTick = 0;
    let phase: Phase = "idle";
    let frightTicks = 0, chain = 0;
    let modeIdx = 0, modeTick = 0;

    // Scatter / chase alternos, en ticks de 60 Hz. El último es chase eterno.
    const MODES = [420, 1200, 420, 1200, 300, 1200, 300, Infinity];
    const scatterNow = () => modeIdx % 2 === 0;

    const pac = { x: 0, y: 0, dir: 1 };
    let want = 1;

    const SPAWN = (() => {
      for (let r = 0; r < ROWS; r++) {
        const c = MAZE[r].indexOf("P");
        if (c >= 0) return { c, r };
      }
      return { c: 13, r: 23 };
    })();

    // Salen por puntos comidos, como el original, con un plazo de gracia por si
    // el jugador se queda parado. Solo por tiempo, morir reinicia la cuenta y
    // el último fantasma no llega a salir nunca.
    const ghosts: Ghost[] = [
      { kind: 0, home: HOUSE.outside,    corner: { c: 26, r: 0 },  dots: 0,  delay: 0,   x: 0, y: 0, dir: 1, state: "out",   release: 0 },
      { kind: 1, home: { c: 13, r: 14 }, corner: { c: 1, r: 0 },   dots: 0,  delay: 60,  x: 0, y: 0, dir: 0, state: "house", release: 0 },
      { kind: 2, home: { c: 11, r: 14 }, corner: { c: 26, r: 30 }, dots: 20, delay: 300, x: 0, y: 0, dir: 0, state: "house", release: 0 },
      { kind: 3, home: { c: 16, r: 14 }, corner: { c: 1, r: 30 },  dots: 45, delay: 600, x: 0, y: 0, dir: 0, state: "house", release: 0 },
    ];
    let eatenThisLife = 0;

    // ------------------------------------------------------------ utilidades
    const cx = (c: number) => c * TS + HALF;
    const cy = (r: number) => r * TS + HALF;
    const tc = (x: number) => Math.floor(x / TS);
    const tr = (y: number) => Math.floor(y / TS);
    const centered = (a: { x: number; y: number }) =>
      (a.x - HALF) % TS === 0 && (a.y - HALF) % TS === 0;

    function tileAt(c: number, r: number) {
      if (r < 0 || r >= ROWS) return "#";
      return grid[r][((c % COLS) + COLS) % COLS];
    }
    function blocked(c: number, r: number, door: boolean) {
      const t = tileAt(c, r);
      return t === "#" || (t === "-" && !door);
    }
    function wrap(a: { x: number }) {
      // W es múltiplo de TS, así que envolver no desalinea nada.
      if (a.x < 0) a.x += W;
      else if (a.x >= W) a.x -= W;
    }

    function loadHi() {
      try { return Number(localStorage.getItem("cc-hi")) || 0; } catch { return 0; }
    }

    // -------------------------------------------------------------- partida
    function resetBoard() {
      grid = MAZE.map((row) => [...row]);
      dotsLeft = 0;
      for (const row of grid) {
        for (let i = 0; i < row.length; i++) {
          if (row[i] === "P") row[i] = " ";
          else if (row[i] === "." || row[i] === "o") dotsLeft++;
        }
      }
    }

    function resetActors() {
      pac.x = cx(SPAWN.c); pac.y = cy(SPAWN.r); pac.dir = 1;
      want = 1;
      frightTicks = 0; chain = 0;
      modeIdx = 0; modeTick = 0;
      eatenThisLife = 0;
      for (const g of ghosts) {
        g.x = cx(g.home.c); g.y = cy(g.home.r);
        g.dir = g.kind === 0 ? 1 : 0;
        g.state = g.kind === 0 ? "out" : "house";
        g.release = tick + g.delay;
      }
    }

    function newGame() {
      COL = readTheme();
      paintMaze(bgc);   // el Konami cambia los neones: hay que repintar el muro
      score = 0; level = 1; lives = 3; tick = 0;
      resetBoard(); resetActors();
      setPhase("ready");
      syncHud();
    }

    function setPhase(p: Phase) { phase = p; phaseTick = 0; }

    function addScore(n: number) {
      const before = score;
      score += n;
      if (before < 10000 && score >= 10000) lives++;   // vida extra
      if (score > hi) {
        hi = score;
        try { localStorage.setItem("cc-hi", String(hi)); } catch { /* modo privado */ }
      }
      syncHud();
    }

    function syncHud() {
      if (elScore) elScore.textContent = String(score).padStart(6, "0");
      if (elHi) elHi.textContent = String(hi).padStart(6, "0");
      if (elLevel) elLevel.textContent = String(level).padStart(2, "0");
      if (elLives) {
        elLives.replaceChildren(
          ...Array.from({ length: Math.max(0, lives) }, () => {
            const i = document.createElement("i");
            i.className = "cc-life";
            return i;
          }),
        );
      }
    }

    // ------------------------------------------------------------ movimiento
    /** Un paso de 1 px. Con pasos de 1 px siempre se cae justo en el centro. */
    function pacStep() {
      if (want === rev(pac.dir)) pac.dir = want;   // dar la vuelta vale siempre
      if (centered(pac)) {
        const c = tc(pac.x), r = tr(pac.y);
        if (!blocked(c + DX[want], r + DY[want], false)) pac.dir = want;
        if (blocked(c + DX[pac.dir], r + DY[pac.dir], false)) return;
      }
      pac.x += DX[pac.dir];
      pac.y += DY[pac.dir];
      wrap(pac);
    }

    function target(g: Ghost, c: number, r: number) {
      if (g.state === "eyes") return HOUSE.outside;
      if (scatterNow()) return g.corner;
      const pc = tc(pac.x), pr = tr(pac.y);
      if (g.kind === 0) return { c: pc, r: pr };
      if (g.kind === 1) return { c: pc + DX[pac.dir] * 4, r: pr + DY[pac.dir] * 4 };
      if (g.kind === 2) {
        // El vector Blinky→(2 casillas delante de Pac-Man), doblado.
        const ax = pc + DX[pac.dir] * 2, ay = pr + DY[pac.dir] * 2;
        return { c: 2 * ax - tc(ghosts[0].x), r: 2 * ay - tr(ghosts[0].y) };
      }
      // Clyde: persigue de lejos, huye a su esquina cuando se acerca.
      const d = (c - pc) ** 2 + (r - pr) ** 2;
      return d > 64 ? { c: pc, r: pr } : g.corner;
    }

    function chooseDir(g: Ghost) {
      const c = tc(g.x), r = tr(g.y);
      const back = rev(g.dir);
      const door = g.state === "eyes";
      const opts: number[] = [];
      for (let d = 0; d < 4; d++) {
        if (d !== back && !blocked(c + DX[d], r + DY[d], door)) opts.push(d);
      }
      if (opts.length === 0) { g.dir = back; return; }
      if (g.state === "out" && frightTicks > 0) {
        g.dir = opts[(Math.random() * opts.length) | 0];
        return;
      }
      const t = target(g, c, r);
      let best = opts[0], bd = Infinity;
      for (const d of opts) {
        const dx = c + DX[d] - t.c, dy = r + DY[d] - t.r;
        const dist = dx * dx + dy * dy;
        if (dist < bd) { bd = dist; best = d; }   // `<` estricto: gana el primero
      }
      g.dir = best;
    }

    const DOOR_X = cx(HOUSE.door.c);
    const OUT_Y = cy(HOUSE.outside.r);
    const IN_Y = cy(HOUSE.inside.r);

    /** Entrar y salir de la casa va guionizado: ahí no hay pasillos. */
    function scripted(g: Ghost) {
      if (g.state === "house") {
        const toca = eatenThisLife >= g.dots || tick >= g.release;
        if (toca && frightTicks === 0) g.state = "leaving";
        return;
      }
      if (g.state === "entering") {
        if (g.x !== DOOR_X) { g.x += Math.sign(DOOR_X - g.x); return; }
        if (g.y < IN_Y) { g.y++; return; }
        g.state = "house";
        g.release = tick + 60;
        return;
      }
      // leaving: primero al centro de la puerta, luego hacia arriba.
      if (g.y > OUT_Y && g.x !== DOOR_X) { g.x += Math.sign(DOOR_X - g.x); return; }
      if (g.y > OUT_Y) { g.y--; return; }
      g.state = "out";
      g.dir = 1;
    }

    function ghostStep(g: Ghost) {
      if (g.state !== "out" && g.state !== "eyes") return scripted(g);
      if (centered(g)) {
        const c = tc(g.x), r = tr(g.y);
        // Los ojos llegan a casa: se comprueba ANTES de elegir dirección, o se
        // quedan clavados sobre la puerta buscando una salida que no existe.
        if (g.state === "eyes" && c === HOUSE.outside.c && r === HOUSE.outside.r) {
          g.state = "entering";
          return;
        }
        chooseDir(g);
        if (blocked(c + DX[g.dir], r + DY[g.dir], g.state === "eyes")) return;
      }
      g.x += DX[g.dir];
      g.y += DY[g.dir];
      wrap(g);
    }

    const inTunnel = (g: Ghost) => tr(g.y) === 14 && (tc(g.x) < 6 || tc(g.x) > 21);

    /** Píxeles por tick. Cada uno se resuelve por separado, de 1 en 1. */
    function ghostSpeed(g: Ghost) {
      if (g.state === "eyes") return 6;
      if (g.state === "leaving") return 2;
      if (g.state === "house" || g.state === "entering") return 1;
      if (frightTicks > 0) return 2;
      return inTunnel(g) ? 2 : 3;
    }

    function reverseAll() {
      for (const g of ghosts) if (g.state === "out") g.dir = rev(g.dir);
    }

    function frighten() {
      frightTicks = Math.max(120, 480 - (level - 1) * 45);
      chain = 0;
      reverseAll();
    }

    function eat() {
      const c = tc(pac.x), r = tr(pac.y);
      const t = grid[r][c];
      if (t === ".") { grid[r][c] = " "; dotsLeft--; addScore(10); }
      else if (t === "o") { grid[r][c] = " "; dotsLeft--; addScore(50); frighten(); }
    }

    function collide() {
      const pc = tc(pac.x), pr = tr(pac.y);
      for (const g of ghosts) {
        if (g.state !== "out") continue;
        if (tc(g.x) !== pc || tr(g.y) !== pr) continue;
        if (frightTicks > 0) {
          g.state = "eyes";
          chain = Math.min(chain + 1, 4);
          addScore(200 * 2 ** (chain - 1));
        } else {
          setPhase("dead");
          return;
        }
      }
    }

    function update() {
      tick++;
      if (frightTicks > 0) {
        if (--frightTicks === 0) chain = 0;
      } else {
        if (++modeTick >= MODES[modeIdx]) {
          modeTick = 0;
          modeIdx = Math.min(modeIdx + 1, MODES.length - 1);
          reverseAll();
        }
      }

      for (let i = 0; i < 3; i++) pacStep();
      eat();
      for (const g of ghosts) {
        const n = ghostSpeed(g);
        for (let i = 0; i < n; i++) ghostStep(g);
      }
      collide();

      if (dotsLeft === 0) setPhase("clear");
    }

    function advance() {
      phaseTick++;
      if (phase === "ready" && phaseTick > 100) setPhase("play");
      else if (phase === "dead" && phaseTick > 130) {
        lives--;
        syncHud();
        if (lives <= 0) { setPhase("over"); overlay("Game Over", "Reintentar"); stop(); }
        else { resetActors(); setPhase("ready"); }
      } else if (phase === "clear" && phaseTick > 130) {
        level++;
        resetBoard(); resetActors();
        setPhase("ready");
        syncHud();
      }
    }

    // ------------------------------------------------------------- pintado
    // `bgc` llega por parámetro y no capturado: una `function` se hoistea, así
    // que TypeScript no puede saber que solo se llama tras el guard de null.
    function paintMaze(bgc: CanvasRenderingContext2D) {
      bgc.clearRect(0, 0, W, H);
      bgc.strokeStyle = COL.wall;
      bgc.lineWidth = 2;
      bgc.lineCap = "square";
      bgc.shadowColor = COL.wall;
      bgc.shadowBlur = 5;
      const isWall = (c: number, r: number) =>
        r < 0 || r >= ROWS ? true : MAZE[r][((c % COLS) + COLS) % COLS] === "#";
      const line = (x1: number, y1: number, x2: number, y2: number) => {
        bgc.beginPath(); bgc.moveTo(x1, y1); bgc.lineTo(x2, y2); bgc.stroke();
      };
      // Solo se dibuja el borde del muro que da a suelo: sale la línea fina
      // del original en vez de un bloque macizo.
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          if (MAZE[r][c] !== "#") continue;
          const x = c * TS, y = r * TS;
          if (!isWall(c, r - 1)) line(x, y + 1, x + TS, y + 1);
          if (!isWall(c, r + 1)) line(x, y + TS - 1, x + TS, y + TS - 1);
          if (!isWall(c - 1, r)) line(x + 1, y, x + 1, y + TS);
          if (!isWall(c + 1, r)) line(x + TS - 1, y, x + TS - 1, y + TS);
        }
      }
      // La puerta de la casa
      bgc.strokeStyle = COL.ghost[1];
      bgc.shadowColor = COL.ghost[1];
      const dy = HOUSE.door.r * TS + HALF;
      line(HOUSE.door.c * TS, dy, (HOUSE.door.c + 2) * TS, dy);
      bgc.shadowBlur = 0;
    }

    function drawDots() {
      const pulse = 3.4 + Math.sin(phaseTick * 0.12) * 1;
      ctx.shadowBlur = 0;
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          const t = grid[r][c];
          if (t === ".") {
            ctx.fillStyle = COL.dot;
            ctx.fillRect(c * TS + HALF - 1, r * TS + HALF - 1, 2, 2);
          } else if (t === "o") {
            ctx.fillStyle = COL.pac;
            ctx.shadowColor = COL.pac;
            ctx.shadowBlur = 10;
            ctx.beginPath();
            ctx.arc(cx(c), cy(r), pulse, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;
          }
        }
      }
    }

    function drawPac() {
      let m = 0.03 + 0.17 * (1 + Math.sin(tick * 0.35)) / 2;
      let ang = ANG[pac.dir];
      if (phase === "dead") {
        m = Math.min(phaseTick / 90, 1);
        ang = -Math.PI / 2;
        if (m >= 1) return;
      }
      ctx.save();
      ctx.translate(pac.x, pac.y);
      ctx.rotate(ang);
      ctx.fillStyle = COL.pac;
      ctx.shadowColor = COL.pac;
      ctx.shadowBlur = 10;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.arc(0, 0, HALF - 1, m * Math.PI, (2 - m) * Math.PI);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
      ctx.shadowBlur = 0;
    }

    function drawGhost(g: Ghost) {
      const R = HALF - 1;
      const x = g.x;
      const y = g.y + (g.state === "house" ? Math.sin(phaseTick * 0.11) * 2 : 0);
      const fright = frightTicks > 0 && g.state === "out";
      const flash = fright && frightTicks < 150 && Math.floor(frightTicks / 14) % 2 === 0;

      if (g.state !== "eyes") {
        const body = flash ? "#ffffff" : fright ? COL.fright : COL.ghost[g.kind];
        ctx.fillStyle = body;
        ctx.shadowColor = body;
        ctx.shadowBlur = 9;
        ctx.beginPath();
        ctx.arc(x, y - 1, R, Math.PI, 0);
        const b = y + R;
        ctx.lineTo(x + R, b);
        for (let i = 1; i <= 6; i++) {
          ctx.lineTo(x + R - (2 * R * i) / 6, b - (i % 2 ? 3 : 0));
        }
        ctx.closePath();
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      if (fright) {
        // Asustado: ojos y boca fijos, sin mirar a ningún lado.
        ctx.fillStyle = flash ? "#ff3d9a" : "#ffffff";
        ctx.fillRect(x - 4, y - 3, 2, 2);
        ctx.fillRect(x + 2, y - 3, 2, 2);
        ctx.fillRect(x - 4, y + 2, 8, 1);
        return;
      }

      ctx.fillStyle = "#ffffff";
      for (const s of [-3.2, 3.2]) {
        ctx.beginPath();
        ctx.ellipse(x + s, y - 2, 2.4, 2.9, 0, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.fillStyle = COL.void;
      for (const s of [-3.2, 3.2]) {
        ctx.beginPath();
        ctx.arc(x + s + DX[g.dir] * 1.2, y - 2 + DY[g.dir] * 1.4, 1.3, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      // Al completar el nivel el laberinto parpadea.
      const hide = phase === "clear" && Math.floor(phaseTick / 11) % 2 === 1;
      if (!hide) ctx.drawImage(bg, 0, 0);
      drawDots();
      if (phase !== "dead" && phase !== "clear") for (const g of ghosts) drawGhost(g);
      drawPac();

      if (phase === "ready") {
        ctx.textAlign = "center";
        ctx.font = "11px 'Press Start 2P', monospace";
        ctx.fillStyle = COL.pac;
        ctx.shadowColor = COL.pac;
        ctx.shadowBlur = 12;
        ctx.fillText("READY", W / 2, cy(17) + 4);
        ctx.shadowBlur = 0;
      }
    }

    // ---------------------------------------------------------------- bucle
    const STEP = 1000 / 60;
    let raf = 0, acc = 0, last = 0, running = false;

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (!last) last = now;
      acc += Math.min(now - last, 250);   // tras un parón no se acelera todo
      last = now;
      while (acc >= STEP) {
        acc -= STEP;
        if (phase === "play") { phaseTick++; update(); }
        else advance();
      }
      draw();
    }

    function start() {
      if (running) return;
      running = true;
      last = 0; acc = 0;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    // Se toca `style.display` a mano: la clase `hidden` de Tailwind y el `flex`
    // del propio overlay son la misma propiedad y ganaría el orden del CSS.
    function overlay(msg: string, btn: string) {
      if (elMsg) elMsg.textContent = msg;
      if (elStart) elStart.textContent = btn;
      if (elOverlay) elOverlay.style.display = "";
    }
    function hideOverlay() {
      if (elOverlay) elOverlay.style.display = "none";
    }

    function pause() {
      if (phase === "idle" || phase === "over") return;
      if (running) { stop(); overlay("Pausa", "Continuar"); }
      else { hideOverlay(); start(); }
    }

    // ---------------------------------------------------------------- input
    elStart?.addEventListener("click", () => {
      if (phase === "idle" || phase === "over") newGame();
      hideOverlay();
      start();
    });
    elPause?.addEventListener("click", pause);

    for (const b of document.querySelectorAll<HTMLElement>("[data-dir]")) {
      b.addEventListener("pointerdown", (e) => {
        e.preventDefault();
        want = Number(b.dataset.dir);
      });
    }

    const KEYS: Record<string, number | undefined> = {
      ArrowUp: 0, ArrowLeft: 1, ArrowDown: 2, ArrowRight: 3,
      w: 0, a: 1, s: 2, d: 3,
    };

    addEventListener("keydown", (e) => {
      // Solo robamos teclas mientras se juega de verdad. Si no, la página
      // tiene que poder scrollear con las flechas como siempre.
      if (!running) return;
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      const k = KEYS[e.key] ?? KEYS[e.key.toLowerCase()];
      if (k !== undefined) { want = k; e.preventDefault(); return; }
      if (e.key === " " || e.key === "Escape") { pause(); e.preventDefault(); }
    });

    // Fuera de pantalla o de pestaña: se pausa. No gasta batería de fondo.
    new IntersectionObserver(
      ([entry]) => { if (!entry.isIntersecting && running) pause(); },
      { threshold: 0.25 },
    ).observe(canvas);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden && running) pause();
    });

    // -------------------------------------------------------------- arranque
    resetBoard();
    resetActors();
    paintMaze(bgc);
    syncHud();
    overlay("Comecocos", "Start");
    draw();

    // Con la fuente ya cargada el laberinto no cambia, pero el READY sí.
    document.fonts?.ready.then(() => { if (!running) draw(); });
  }
</script>
