---
/**
 * The Windows XP Start menu, Luna theme. A picture, not a menu.
 *
 * Nothing in here is clickable and that is the point: it is a mock of what XP
 * showed, put on screen so the Start button has somewhere to go. The entries
 * are XP's own defaults and not this site's sections — the site's navigation
 * lives in the Menu window, and a Start menu that half-worked would send the
 * visitor looking for the other half.
 *
 * Because it is decoration the whole panel is `aria-hidden`: a screen reader
 * reading out a list of things that cannot be done is worse than silence. The
 * Start button keeps `aria-expanded`, so the state is still announced.
 * `startmenu.test.mjs` fails if an <a>, <button> or <input> ever appears here.
 *
 * The colours were approximations until they were not. Header, footer, the two
 * separators, the orange line and the two column blues now come off Luna's own
 * resource bitmaps, read out of the XFCE total conversion at
 * github.com/rozniak/xfce-winxp-tc (`themes/luna/blue/`). Every rule that
 * carries a measured number says where it came from. What is still by eye is
 * the geometry: the panel's width, its radius and the item padding.
 */
import { HEIGHT } from "./taskbar-colors.mjs";

/**
 * The icons are XP's own, taken from the set at
 * github.com/softwarehistorysociety/XPIcons and downscaled to 64px into
 * `public/xp/icons/start/`. They were drawn here as inline SVG until the owner
 * asked for the real ones, which is the call already taken for the wallpaper
 * and for the games in the folder.
 *
 * ⚠️ The artwork is Microsoft's. It is here the way the wallpaper is: a period
 * recreation of a dead operating system, not something this repository has a
 * licence to. `startmenu.test.mjs` checks that every name below has a file.
 */
const icon = (name: string) => `/xp/icons/start/${name}.png`;

/** The one glyph still drawn: XP's "this opens a submenu" triangle. */
const ARROW = '<path d="M5 3.5 10.5 8 5 12.5z" fill="#2c6fd8"/>';

/** `sub` is the grey second line the two pinned entries have. `arrow` is XP's
    "this opens a submenu" triangle. */
const PINNED = [
  { icon: "ie", name: "Internet", sub: "Internet Explorer" },
  { icon: "mail", name: "E-mail", sub: "Outlook Express" },
];
/* Not a list of favourites: this is the frequently-used list a freshly
   installed XP came with, in its order, before anyone had used the machine
   enough to change it. Which is what this panel is a picture of. */
const RECENT = [
  { icon: "msn", name: "MSN Explorer" },
  { icon: "media", name: "Windows Media Player" },
  { icon: "moviemaker", name: "Windows Movie Maker" },
  { icon: "tour", name: "Tour Windows XP" },
  { icon: "transfer", name: "Files and Settings Transfer Wizard" },
];
const PLACES = [
  { icon: "documents", name: "My Documents" },
  { icon: "recent", name: "My Recent Documents", arrow: true },
  { icon: "pictures", name: "My Pictures" },
  { icon: "music", name: "My Music" },
  { icon: "computer", name: "My Computer" },
];
const SYSTEM = [
  { icon: "panel", name: "Control Panel" },
  { icon: "defaults", name: "Set Program Access and Defaults" },
  { icon: "connect", name: "Connect To", arrow: true },
  { icon: "printers", name: "Printers and Faxes" },
];
const HELP = [
  { icon: "help", name: "Help and Support" },
  { icon: "search", name: "Search" },
  { icon: "run", name: "Run..." },
];
---

{/* `--bar-h` is set here and not inherited: the panel is a SIBLING of the bar,
    and it has to be, because the bar's arrival animation leaves a `transform`
    on it — and a transformed ancestor turns `position: fixed` into something
    positioned against that ancestor instead of the viewport. */}
<div
  class="xp-startmenu"
  id="xp-startmenu"
  style={`--bar-h:${HEIGHT}px`}
  aria-hidden="true"
  hidden
>
  <div class="sm-head">
    {/* The account picture: `chess.bmp`, the one XP shipped, at its native
        48x48. It used to be three chess pieces drawn here, on the grounds that
        the original is a photograph licensed from Corbis (Mark Karrass took it)
        rather than Microsoft artwork to borrow. The owner asked for the real
        one. The same call as the wallpaper, and the same caveat. */}
    <span class="sm-avatar">
      <img src="/xp/chess.png" alt="" width="48" height="48" />
    </span>
    <span class="sm-user">Administrator</span>
  </div>

  <div class="sm-body">
    <div class="sm-left">
      <ul class="sm-list">
        {
          PINNED.map((e) => (
            <li class="sm-item sm-item--big">
              <img class="sm-icon sm-icon--big" src={icon(e.icon)} alt="" width="64" height="64" />
              <span class="sm-text">
                <span class="sm-name">{e.name}</span>
                <span class="sm-sub">{e.sub}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <hr class="sm-rule" />

      <ul class="sm-list">
        {
          RECENT.map((e) => (
            <li class="sm-item">
              <img class="sm-icon" src={icon(e.icon)} alt="" width="64" height="64" />
              <span class="sm-name">{e.name}</span>
            </li>
          ))
        }
      </ul>

      <div class="sm-all">
        <span class="sm-name">All Programs</span>
        <svg class="sm-arrow" viewBox="0 0 16 16" role="presentation" set:html={ARROW} />
      </div>
    </div>

    <div class="sm-right">
      <ul class="sm-list">
        {
          PLACES.map((e) => (
            <li class="sm-item">
              <img class="sm-icon" src={icon(e.icon)} alt="" width="64" height="64" />
              <span class="sm-name">{e.name}</span>
              {e.arrow && <svg class="sm-arrow" viewBox="0 0 16 16" role="presentation" set:html={ARROW} />}
            </li>
          ))
        }
      </ul>

      <hr class="sm-rule sm-rule--right" />

      <ul class="sm-list">
        {
          SYSTEM.map((e) => (
            <li class="sm-item">
              <img class="sm-icon" src={icon(e.icon)} alt="" width="64" height="64" />
              <span class="sm-name">{e.name}</span>
              {e.arrow && <svg class="sm-arrow" viewBox="0 0 16 16" role="presentation" set:html={ARROW} />}
            </li>
          ))
        }
      </ul>

      <hr class="sm-rule sm-rule--right" />

      <ul class="sm-list">
        {
          HELP.map((e) => (
            <li class="sm-item">
              <img class="sm-icon" src={icon(e.icon)} alt="" width="64" height="64" />
              <span class="sm-name">{e.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="sm-foot">
    <span class="sm-foot-item">
      <img class="sm-icon" src={icon("logoff")} alt="" width="64" height="64" />
      <span class="sm-name">Log Off</span>
    </span>
    <span class="sm-foot-item">
      <img class="sm-icon" src={icon("shutdown")} alt="" width="64" height="64" />
      <span class="sm-name">Turn Off Computer</span>
    </span>
  </div>
</div>

<style>
  /* Anchored to the bottom-left corner, sitting ON the bar rather than under
     it: `bottom: var(--bar-h)` is what puts its lower edge exactly where the
     bar's upper edge is. Above everything, the bar included, because in XP the
     menu is the frontmost thing on screen while it is open. */
  .xp-startmenu {
    position: fixed;
    left: 0;
    bottom: var(--bar-h);
    z-index: 11;
    width: 400px;
    max-width: 100vw;
    border: 1px solid #0831d9;
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    box-shadow: 2px -2px 8px rgba(0, 0, 0, 0.35);
    font-family: Tahoma, "DejaVu Sans", Verdana, sans-serif;
    font-size: 12px;
    color: #000000;
    overflow: hidden;
    user-select: none;
  }
  .xp-startmenu[hidden] {
    display: none;
  }

  /* ── The header: the account ─────────────────────────────────────────── */
  /* ⚠️ Measured off Luna's own `start_userpane_body.png`, 108x58, which is why
     the header is 58px and not a round number. It runs DARK at the top and
     light at the bottom, the opposite way round to what it looks like from
     memory: #1666cf at the first row, its darkest at row 7, then climbing to
     #4792ec at row 57. The blue hairline under it is row 0 of the columns'
     own border bitmap. */
  .sm-head {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 58px;
    padding: 0 10px;
    background: linear-gradient(
      to bottom,
      #1666cf 0,
      #0c5fcb 12%,
      #1a6bd2 40%,
      #2c7ce0 69%,
      #4792ec 100%
    );
    border-bottom: 1px solid #1b6bd1;
  }
  .sm-avatar {
    display: block;
    padding: 2px;
    border: 2px solid #ffffff;
    border-radius: 4px;
    background: #4a8ce8;
    line-height: 0;
  }
  .sm-avatar img {
    display: block;
    width: 42px;
    height: 42px;
  }
  .sm-user {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    /* Luna's own value. XP set it in Franklin Gothic Medium, which is not a
       font a browser can count on, so the face stays Tahoma. */
    text-shadow: 0 1px 2px #000000;
  }

  /* ── The two columns ─────────────────────────────────────────────────── */
  .sm-body {
    display: flex;
    align-items: stretch;
  }
  /* The orange line is two colours, not one, and that is not a mistake in the
     capture: over the white column Luna draws it #ff9e44 and over the blue one
     #e9b587, so it reads as the same line seen through two surfaces. Putting it
     on the columns instead of on the header is what makes that possible. */
  .sm-left {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    padding: 6px 0 0;
    background: #ffffff;
    border-top: 2px solid #ff9e44;
    color: #373737;
  }
  .sm-right {
    flex: 0 0 176px;
    padding: 6px 0;
    /* The pale blue column. Lighter than the header and much lighter than the
       bar: in XP it reads as a second surface, not as a shadow. */
    background: #d3e5fa;
    border-top: 2px solid #e9b587;
    border-left: 1px solid #b6cff0;
    color: #0a246a;
  }

  .sm-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sm-item,
  .sm-all,
  .sm-foot-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    /* No :hover and no cursor change. It is a picture: pretending it reacts
       would be a promise the panel cannot keep. */
    min-height: 26px;
  }
  .sm-item--big {
    padding: 6px 10px;
  }
  /* 24 and 32 are XP's, not a guess: the two pinned entries get the large size
     and everything else the small one. */
  .sm-icon {
    flex: none;
    width: 24px;
    height: 24px;
  }
  .sm-icon--big {
    width: 32px;
    height: 32px;
  }
  .sm-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .sm-name {
    font-size: 12px;
  }
  .sm-item--big .sm-name {
    font-weight: bold;
  }
  .sm-sub {
    color: #808080;
    font-size: 11px;
  }
  .sm-arrow {
    flex: none;
    width: 10px;
    height: 10px;
    margin-left: auto;
  }

  /* Both separators fade out at their ends rather than reaching the edge, and
     each fades into its own column, which is why they are gradients and not
     borders. Luna's values. */
  .sm-rule {
    height: 1px;
    margin: 5px 10px;
    border: 0;
    background: linear-gradient(
      to right,
      #ffffff 0,
      #d3d3c8 25%,
      #d3d3c8 75%,
      #ffffff 100%
    );
  }
  .sm-rule--right {
    background: linear-gradient(
      to right,
      #d3e5fa 0,
      #81b6ff 35%,
      #81b6ff 65%,
      #d3e5fa 100%
    );
  }

  /* "All Programs" sits at the bottom of the white column, pushed there by
     `margin-top: auto` so the column can be as tall as the blue one. */
  .sm-all {
    margin-top: auto;
    padding: 7px 10px;
    border-top: 1px solid #d3d3c8;
    font-weight: bold;
  }
  .sm-all .sm-arrow {
    margin-left: 4px;
  }

  /* ── The footer ──────────────────────────────────────────────────────── */
  .sm-foot {
    display: flex;
    justify-content: flex-end;
    gap: 14px;
    padding: 6px 12px;
    /* `start_logoffpane_body.png`, 89x39: light at the top, and it drops off a
       cliff in the last two rows rather than easing out. */
    background: linear-gradient(
      to bottom,
      #438be3 0,
      #307fe3 33%,
      #1b6fdc 62%,
      #1062cf 90%,
      #0c56c0 100%
    );
    color: #ffffff;
  }
  .sm-foot-item {
    padding: 0;
    gap: 6px;
    min-height: 0;
  }

  /* ── The opening ─────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .xp-startmenu:not([hidden]) {
      animation: xp-startmenu-open 140ms ease-out both;
      transform-origin: left bottom;
    }
    @keyframes xp-startmenu-open {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
