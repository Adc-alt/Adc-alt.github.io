---
/**
 * The Windows XP Start menu, Luna theme. A picture, not a menu.
 *
 * Nothing in here is clickable and that is the point: it is a mock of what XP
 * showed, put on screen so the Start button has somewhere to go. The entries
 * are XP's own defaults and not this site's sections — the site's navigation
 * lives in the Menu window, and a Start menu that half-worked would send the
 * visitor looking for the other half.
 *
 * Because it is decoration the whole panel is `aria-hidden`: a screen reader
 * reading out a list of things that cannot be done is worse than silence. The
 * Start button keeps `aria-expanded`, so the state is still announced.
 * `startmenu.test.mjs` fails if an <a>, <button> or <input> ever appears here.
 *
 * ⚠️ The colours are approximations, like the windows' and unlike the taskbar's:
 * nothing here was measured off a capture. Do not treat them as reference.
 */
import { HEIGHT } from "./taskbar-colors.mjs";

/* 16x16 so a path is a couple of numbers. The icons are drawn here on purpose:
   XP's are Microsoft's artwork and copying them is not the same as copying a
   layout. They are meant to read at 24px, not to be admired. */
const ICONS: Record<string, string> = {
  ie: '<circle cx="8" cy="8" r="6.5" fill="#2f6fc4"/><ellipse cx="8" cy="8" rx="6.5" ry="2.6" fill="none" stroke="#eaf3ff" stroke-width="1.1"/><path d="M8 1.5v13" stroke="#eaf3ff" stroke-width="1.1"/>',
  mail: '<rect x="1" y="3" width="14" height="10" rx="1" fill="#f2f6fb" stroke="#4a6b96"/><path d="M1.6 3.7 8 8.6l6.4-4.9" fill="none" stroke="#4a6b96"/>',
  media: '<circle cx="8" cy="8" r="6.5" fill="#d75f1d"/><path d="M6.4 4.9 11.4 8l-5 3.1z" fill="#fff"/>',
  notepad:
    '<rect x="3" y="1.5" width="10" height="13" fill="#fdfdfd" stroke="#7a8ba0"/><path d="M5 5h6M5 7.5h6M5 10h4" stroke="#8a9bb0" stroke-width="1"/>',
  paint:
    '<path d="M8 1.5a6.5 6.5 0 1 0 0 13c1 0 1.4-.7 1-1.4-.5-.9.2-1.6 1.1-1.6h1.3A3.1 3.1 0 0 0 14.5 8 6.6 6.6 0 0 0 8 1.5z" fill="#f0e6b8" stroke="#8a7a3a"/><circle cx="5.6" cy="6" r="1.1" fill="#d33"/><circle cx="8" cy="4.6" r="1.1" fill="#39c"/><circle cx="10.4" cy="6" r="1.1" fill="#3a3"/>',
  cmd: '<rect x="1.5" y="2.5" width="13" height="11" fill="#101010" stroke="#5b6b80"/><path d="M4 6l2 2-2 2M7.5 10.5h4" stroke="#e8e8e8" stroke-width="1.2" fill="none"/>',
  folder:
    '<path d="M1.5 4.2h5l1.2 1.4h6.8v7.9H1.5z" fill="#fbc95e" stroke="#b98b1e"/><path d="M1.5 6.4h13.8" stroke="#e8b64a"/>',
  pictures:
    '<rect x="1.5" y="3" width="13" height="10" fill="#eef4fb" stroke="#7a8ba0"/><path d="M2.5 11.5 6 7.5l2.4 2.6L10.5 8l3 3.5z" fill="#6aa86a"/><circle cx="5" cy="5.6" r="1.2" fill="#e8c34a"/>',
  music:
    '<path d="M6 11.4V3.6l7-1.3v7.5" fill="none" stroke="#4a6b96" stroke-width="1.3"/><circle cx="4.6" cy="11.6" r="1.9" fill="#4a6b96"/><circle cx="11.6" cy="10" r="1.9" fill="#4a6b96"/>',
  computer:
    '<rect x="1.5" y="2.5" width="13" height="8.5" rx="1" fill="#cfe0f2" stroke="#4a6b96"/><rect x="3" y="4" width="10" height="5.5" fill="#3f6fb5"/><path d="M5.5 13.5h5l-.6-2h-3.8z" fill="#a9bccf" stroke="#4a6b96" stroke-width=".8"/>',
  panel:
    '<circle cx="8" cy="8" r="3" fill="none" stroke="#4a6b96" stroke-width="1.4"/><path d="M8 1v2.4M8 12.6V15M1 8h2.4M12.6 8H15M3 3l1.7 1.7M11.3 11.3 13 13M13 3l-1.7 1.7M4.7 11.3 3 13" stroke="#4a6b96" stroke-width="1.4"/>',
  help: '<circle cx="8" cy="8" r="6.5" fill="#3f6fb5"/><path d="M6.2 6.2a1.9 1.9 0 1 1 2.4 1.9c-.5.2-.6.6-.6 1.1" fill="none" stroke="#fff" stroke-width="1.3"/><circle cx="8" cy="11.4" r="1" fill="#fff"/>',
  search:
    '<circle cx="6.6" cy="6.6" r="4.1" fill="#eaf3ff" stroke="#4a6b96" stroke-width="1.3"/><path d="m9.8 9.8 4 4" stroke="#4a6b96" stroke-width="1.8"/>',
  run: '<rect x="1.5" y="3" width="13" height="10" rx="1" fill="#f2f6fb" stroke="#4a6b96"/><path d="M1.5 5.6h13" stroke="#4a6b96"/><path d="M4 8.4h5M4 10.4h3" stroke="#8a9bb0" stroke-width="1.1"/>',
  logoff:
    '<circle cx="8" cy="8" r="6.5" fill="#3f6fb5"/><path d="M9.6 5.2a3.6 3.6 0 1 1-3.2 0M8 3.2v4" stroke="#fff" stroke-width="1.4" fill="none"/>',
  shutdown:
    '<circle cx="8" cy="8" r="6.5" fill="#c0392b"/><path d="M9.6 5.2a3.6 3.6 0 1 1-3.2 0M8 3.2v4" stroke="#fff" stroke-width="1.4" fill="none"/>',
  more: '<path d="M5 3.5 10.5 8 5 12.5z" fill="#2c6fd8"/>',
};

/** `sub` is the grey second line the two pinned entries have. `arrow` is XP's
    "this opens a submenu" triangle. */
const PINNED = [
  { icon: "ie", name: "Internet", sub: "Internet Explorer" },
  { icon: "mail", name: "E-mail", sub: "Outlook Express" },
];
const RECENT = [
  { icon: "media", name: "Windows Media Player" },
  { icon: "notepad", name: "Notepad" },
  { icon: "paint", name: "Paint" },
  { icon: "cmd", name: "Command Prompt" },
];
const PLACES = [
  { icon: "folder", name: "My Documents" },
  { icon: "folder", name: "My Recent Documents", arrow: true },
  { icon: "pictures", name: "My Pictures" },
  { icon: "music", name: "My Music" },
  { icon: "computer", name: "My Computer" },
];
const SYSTEM = [
  { icon: "panel", name: "Control Panel" },
  { icon: "run", name: "Set Program Access and Defaults" },
  { icon: "computer", name: "Connect To", arrow: true },
  { icon: "run", name: "Printers and Faxes" },
];
const HELP = [
  { icon: "help", name: "Help and Support" },
  { icon: "search", name: "Search" },
  { icon: "run", name: "Run..." },
];
---

{/* `--bar-h` is set here and not inherited: the panel is a SIBLING of the bar,
    and it has to be, because the bar's arrival animation leaves a `transform`
    on it — and a transformed ancestor turns `position: fixed` into something
    positioned against that ancestor instead of the viewport. */}
<div
  class="xp-startmenu"
  id="xp-startmenu"
  style={`--bar-h:${HEIGHT}px`}
  aria-hidden="true"
  hidden
>
  <div class="sm-head">
    {/* The account picture: chess, the one the Administrator account came with.
        ⚠️ Drawn, not copied. XP's `chess.bmp` is a photograph licensed from
        Corbis — Mark Karrass took it — so it is somebody's stock photo and not
        Microsoft artwork to borrow. These are three pieces of our own in the
        same arrangement: a rook, a king and a pawn on a board. */}
    <span class="sm-avatar">
      <svg viewBox="0 0 32 32" width="42" height="42" role="presentation">
        <rect width="32" height="32" fill="#1b2533"></rect>
        <rect y="25" width="32" height="7" fill="#42566e"></rect>
        <rect y="25" width="8" height="7" fill="#25313f"></rect>
        <rect x="16" y="25" width="8" height="7" fill="#25313f"></rect>
        <g fill="#f2e9d4">
          {/* Rook: crenellations, a waist, a foot. */}
          <path d="M3 11h1.6v1.6h1.4V11h1.6v1.6h1.4V11H11v4H3z"></path>
          <path d="M4.4 15h5.2l-.7 8H5.1z"></path>
          <path d="M3 23h8v2.4H3z"></path>
          {/* King: the cross is what makes it read at this size. */}
          <path d="M15.2 2h1.6v1.8h1.8v1.6h-1.8V8h-1.6V5.4h-1.8V3.8h1.8z"></path>
          <circle cx="16" cy="11" r="3.4"></circle>
          <path d="M12.6 23c0-5.4 2-8 3.4-10.2C17.4 15 19.4 17.6 19.4 23z"></path>
          <path d="M11.4 23h9.2v2.4h-9.2z"></path>
          {/* Pawn. */}
          <circle cx="25" cy="14" r="2.8"></circle>
          <path d="M22.6 23c0-3.8 1.6-5.6 2.4-7.2.8 1.6 2.4 3.4 2.4 7.2z"></path>
          <path d="M21.6 23h6.8v2.4h-6.8z"></path>
        </g>
      </svg>
    </span>
    <span class="sm-user">Administrator</span>
  </div>

  <div class="sm-body">
    <div class="sm-left">
      <ul class="sm-list">
        {
          PINNED.map((e) => (
            <li class="sm-item sm-item--big">
              <svg class="sm-icon sm-icon--big" viewBox="0 0 16 16" role="presentation" set:html={ICONS[e.icon]} />
              <span class="sm-text">
                <span class="sm-name">{e.name}</span>
                <span class="sm-sub">{e.sub}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <hr class="sm-rule" />

      <ul class="sm-list">
        {
          RECENT.map((e) => (
            <li class="sm-item">
              <svg class="sm-icon" viewBox="0 0 16 16" role="presentation" set:html={ICONS[e.icon]} />
              <span class="sm-name">{e.name}</span>
            </li>
          ))
        }
      </ul>

      <div class="sm-all">
        <span class="sm-name">All Programs</span>
        <svg class="sm-arrow" viewBox="0 0 16 16" role="presentation" set:html={ICONS.more} />
      </div>
    </div>

    <div class="sm-right">
      <ul class="sm-list">
        {
          PLACES.map((e) => (
            <li class="sm-item">
              <svg class="sm-icon" viewBox="0 0 16 16" role="presentation" set:html={ICONS[e.icon]} />
              <span class="sm-name">{e.name}</span>
              {e.arrow && <svg class="sm-arrow" viewBox="0 0 16 16" role="presentation" set:html={ICONS.more} />}
            </li>
          ))
        }
      </ul>

      <hr class="sm-rule sm-rule--right" />

      <ul class="sm-list">
        {
          SYSTEM.map((e) => (
            <li class="sm-item">
              <svg class="sm-icon" viewBox="0 0 16 16" role="presentation" set:html={ICONS[e.icon]} />
              <span class="sm-name">{e.name}</span>
              {e.arrow && <svg class="sm-arrow" viewBox="0 0 16 16" role="presentation" set:html={ICONS.more} />}
            </li>
          ))
        }
      </ul>

      <hr class="sm-rule sm-rule--right" />

      <ul class="sm-list">
        {
          HELP.map((e) => (
            <li class="sm-item">
              <svg class="sm-icon" viewBox="0 0 16 16" role="presentation" set:html={ICONS[e.icon]} />
              <span class="sm-name">{e.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="sm-foot">
    <span class="sm-foot-item">
      <svg class="sm-icon" viewBox="0 0 16 16" role="presentation" set:html={ICONS.logoff} />
      <span class="sm-name">Log Off</span>
    </span>
    <span class="sm-foot-item">
      <svg class="sm-icon" viewBox="0 0 16 16" role="presentation" set:html={ICONS.shutdown} />
      <span class="sm-name">Turn Off Computer</span>
    </span>
  </div>
</div>

<style>
  /* Anchored to the bottom-left corner, sitting ON the bar rather than under
     it: `bottom: var(--bar-h)` is what puts its lower edge exactly where the
     bar's upper edge is. Above everything, the bar included, because in XP the
     menu is the frontmost thing on screen while it is open. */
  .xp-startmenu {
    position: fixed;
    left: 0;
    bottom: var(--bar-h);
    z-index: 11;
    width: 400px;
    max-width: 100vw;
    border: 1px solid #0831d9;
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    box-shadow: 2px -2px 8px rgba(0, 0, 0, 0.35);
    font-family: Tahoma, "DejaVu Sans", Verdana, sans-serif;
    font-size: 12px;
    color: #000000;
    overflow: hidden;
    user-select: none;
  }
  .xp-startmenu[hidden] {
    display: none;
  }

  /* ── The header: the account ─────────────────────────────────────────── */
  .sm-head {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 58px;
    padding: 0 10px;
    background: linear-gradient(to bottom, #1c60d8 0, #2f7ae5 38%, #1b4fbe 100%);
    border-bottom: 2px solid #d8770a;
  }
  .sm-avatar {
    display: block;
    padding: 2px;
    border: 2px solid #ffffff;
    border-radius: 4px;
    background: #4a8ce8;
    line-height: 0;
  }
  .sm-user {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
  }

  /* ── The two columns ─────────────────────────────────────────────────── */
  .sm-body {
    display: flex;
    align-items: stretch;
  }
  .sm-left {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    padding: 6px 0 0;
    background: #ffffff;
  }
  .sm-right {
    flex: 0 0 176px;
    padding: 6px 0;
    /* The pale blue column. Lighter than the header and much lighter than the
       bar: in XP it reads as a second surface, not as a shadow. */
    background: #d3e5fa;
    border-left: 1px solid #b6cff0;
  }

  .sm-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sm-item,
  .sm-all,
  .sm-foot-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    /* No :hover and no cursor change. It is a picture: pretending it reacts
       would be a promise the panel cannot keep. */
    min-height: 26px;
  }
  .sm-item--big {
    padding: 6px 10px;
  }
  .sm-icon {
    flex: none;
    width: 22px;
    height: 22px;
  }
  .sm-icon--big {
    width: 30px;
    height: 30px;
  }
  .sm-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .sm-name {
    font-size: 12px;
  }
  .sm-item--big .sm-name {
    font-weight: bold;
  }
  .sm-sub {
    color: #6a6a6a;
    font-size: 11px;
  }
  .sm-arrow {
    flex: none;
    width: 10px;
    height: 10px;
    margin-left: auto;
  }

  .sm-rule {
    margin: 5px 10px;
    border: 0;
    border-top: 1px solid #c3d3e6;
  }
  .sm-rule--right {
    border-top-color: #a8c4e8;
  }

  /* "All Programs" sits at the bottom of the white column, pushed there by
     `margin-top: auto` so the column can be as tall as the blue one. */
  .sm-all {
    margin-top: auto;
    padding: 7px 10px;
    border-top: 1px solid #c3d3e6;
    font-weight: bold;
  }
  .sm-all .sm-arrow {
    margin-left: 4px;
  }

  /* ── The footer ──────────────────────────────────────────────────────── */
  .sm-foot {
    display: flex;
    justify-content: flex-end;
    gap: 14px;
    padding: 6px 12px;
    background: linear-gradient(to bottom, #2f7ae5 0, #1c60d8 100%);
    color: #ffffff;
  }
  .sm-foot-item {
    padding: 0;
    gap: 6px;
    min-height: 0;
  }

  /* ── The opening ─────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .xp-startmenu:not([hidden]) {
      animation: xp-startmenu-open 140ms ease-out both;
      transform-origin: left bottom;
    }
    @keyframes xp-startmenu-open {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
