---
/**
 * The song behind the Music shortcut. No window, no player: the shortcut plays
 * it and plays it again to stop.
 *
 * WHY THERE IS NOTHING TO SEE. The owner asked for a shortcut that plays, not
 * for a player. So this renders an empty host that lives off the left edge of
 * the screen, and the frame that actually plays is built inside it on the first
 * double click and destroyed on the second.
 *
 * ⚠️ Off-screen, NOT `display: none` and NOT `hidden`. A frame that is not
 * displayed is not loaded, so nothing would play at all; a frame that is merely
 * somewhere else plays fine. The other half of that same fact is why stopping
 * has to mean destroying it: there is no reaching into a cross-origin frame to
 * pause it, which is the lesson the pinball table taught.
 *
 * The song is not in this repository — the recording is copyrighted — so it
 * comes from YouTube's own embed, and nothing is asked of Google until the
 * shortcut is used. On a site whose pitch is no analytics and no cookies, an
 * embed that loaded by itself would be a contradiction.
 */
import { MUSIC_HOST_ID } from "./sections.mjs";

const VIDEO = "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?autoplay=1&rel=0";
---

<div id={MUSIC_HOST_ID} class="music-host" data-src={VIDEO} aria-hidden="true"></div>

<script>
  import { MUSIC_HOST_ID } from "./sections.mjs";

  const host = document.getElementById(MUSIC_HOST_ID);

  /* `xp:show` is what a desktop shortcut dispatches at whatever it opens. There
     is no window here to open, so the same event is the play switch — and,
     pressed again, the stop switch. Without the second half the song could not
     be stopped at all: nothing else on the desktop would show it exists. */
  host?.addEventListener("xp:show", () => {
    if (host.firstChild) {
      host.replaceChildren();
      return;
    }
    const frame = document.createElement("iframe");
    frame.src = host.dataset.src ?? "";
    frame.title = "Never Gonna Give You Up";
    frame.allow = "autoplay; encrypted-media";
    // ⚠️ No `referrerPolicy = "no-referrer"`, however tempting on a page that
    // takes privacy seriously. YouTube checks who is embedding it and answers
    // "Error 153" to a frame that will not say: the song never starts.
    host.append(frame);
  });
</script>

<style>
  .music-host {
    position: fixed;
    left: -10000px;
    top: 0;
    width: 320px;
    height: 180px;
    /* Nothing here is for looking at, and it must never catch a click. */
    pointer-events: none;
  }
  .music-host :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
