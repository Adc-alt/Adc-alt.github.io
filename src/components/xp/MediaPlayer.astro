---
/**
 * A media player with exactly one thing in it.
 *
 * WHY THERE IS A BUTTON AND NOT JUST THE VIDEO. Two reasons, and the second is
 * the one that matters. The song is not ours to host — the recording is
 * copyrighted, so it is played from YouTube's own embed rather than copied into
 * this repository. And an embed that loads by itself would fetch from Google on
 * every single visit, on a site whose whole pitch is that it has no analytics
 * and no cookies. Nothing leaves this page until the play button is pressed.
 *
 * ⚠️ The frame is DESTROYED when the window closes, not hidden. A hidden
 * cross-origin iframe keeps playing and there is no way to reach in and stop
 * it — the same lesson the pinball table taught. `display: none` is what all
 * four ways out of a window come down to (close, minimise, the taskbar button,
 * opening something else over it), and a `ResizeObserver` sees every one of
 * them as a 0x0 box.
 */
const VIDEO = "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?autoplay=1&rel=0";
const TITLE = "Rick Astley — Never Gonna Give You Up";
---

<div class="wmp">
  <div class="wmp-stage">
    {/* The URL rides on the button so nothing in the script has to know it. */}
    <button type="button" class="wmp-play" data-src={VIDEO}>
      <span class="wmp-play-icon" aria-hidden="true">▶</span>
      <span class="wmp-play-title">{TITLE}</span>
      <span class="wmp-play-note">Plays from YouTube. Nothing is fetched until you press this.</span>
    </button>
  </div>
</div>

<script>
  const stage = document.querySelector<HTMLElement>(".wmp-stage");
  const button = stage?.querySelector<HTMLButtonElement>(".wmp-play");

  if (stage && button) {
    button.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.src = button.dataset.src ?? "";
      frame.className = "wmp-frame";
      frame.title = "Never Gonna Give You Up";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      // ⚠️ No `referrerPolicy = "no-referrer"` here, however tempting. YouTube
      // checks which site is embedding it and refuses to play for one that
      // will not say: the player comes up "Error 153" instead of the song.
      // `replaceChildren` and not `innerHTML`: the button is put back later,
      // listener and all, so it must survive being taken out.
      stage.replaceChildren(frame);
    });

    new ResizeObserver(([entry]) => {
      const box = entry?.contentRect;
      if (box && box.width === 0 && box.height === 0 && stage.querySelector("iframe")) {
        stage.replaceChildren(button);
      }
    }).observe(stage);
  }
</script>

<style>
  .wmp {
    /* The player chrome of the era: a dark surround around the picture. */
    background: #1b2733;
    padding: 6px;
  }
  /* ⚠️ `aspect-ratio` and not `height: 100%`. The window body is auto-height,
     so a percentage height resolves against nothing: the button would still
     size itself by its text, and the iframe that replaces it would come out
     zero pixels tall. */
  .wmp-stage {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000000;
  }
  .wmp-play {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    height: 100%;
    padding: 12px;
    background: none;
    border: 0;
    color: #d8e6f8;
    font: 12px Tahoma, "DejaVu Sans", Verdana, sans-serif;
    text-align: center;
    cursor: pointer;
  }
  .wmp-play-icon {
    font-size: 34px;
    line-height: 1;
    color: #ffffff;
  }
  .wmp-play:hover .wmp-play-icon {
    color: #f79429;
  }
  .wmp-play-title {
    font-weight: bold;
  }
  .wmp-play-note {
    color: #8fa6bd;
  }
  .wmp-play:focus-visible {
    outline: 1px dotted #ffffff;
    outline-offset: -4px;
  }
  .wmp-stage :global(.wmp-frame) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
