---
/**
 * The Games index, one section of the reading pane. Same shape as the Projects
 * index and for the same reason: the list comes from `GAMES` in `sections.mjs`,
 * which is also what `Sections.astro` renders the sections from, so a link here
 * cannot point at a game that does not exist.
 */
import { GAMES, gameSectionId } from "./sections.mjs";

const BLURB: Record<string, string> = {
  minesweeper:
    "Beginner, Intermediate and Expert, the three boards Windows shipped. Written for this site; the rules are a module of their own with tests, because a flood fill that stops one cell short still looks perfectly fine on screen.",
  solitaire:
    "Klondike, with drag and drop. Turning one card at a time rather than the three Windows defaulted to — draw-three makes most deals unwinnable, which is a poor thing to put in front of a visitor.",
  pinball:
    "The real one, running on WebAssembly. Not mine and not hosted here: it is a decompilation of the original by k4zmu2a, ported by alula, and the frame stays empty until you ask for it.",
};
---

<div class="xp-doc">
  <h1>Games</h1>

  <p class="lede">
    The three that came with the machine. Two of them I wrote; the third is
    somebody else's build of the original, framed rather than copied.
  </p>

  <hr />

  <ul class="index">
    {
      GAMES.map((game) => (
        <li>
          <h2>
            <a href={`#${gameSectionId(game.id)}`}>{game.label}</a>
          </h2>
          <p>{BLURB[game.id]}</p>
        </li>
      ))
    }
  </ul>
</div>
