---
/**
 * El índice de proyectos. Cada título abre la ventana de ese proyecto, que se
 * renderiza en el build igual que ésta (fase 1 §13: el contenido no lo genera
 * el JavaScript).
 *
 * El id de la ventana de un proyecto se compone aquí y en `index.astro`. Sale
 * de `ventanaDe()`, en un solo sitio, porque si los dos se desalinean el
 * enlace deja de abrir nada y no falla el build.
 */
import { getCollection } from "astro:content";
import { ESTADO, ventanaDe } from "./proyectos.mjs";

const proyectos = (
  await getCollection("proyectos", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
---

<div class="xp-doc">
  <h1>Proyectos</h1>

  <p class="lede">
    Cosas que he construido: qué problema resolvían y cómo están hechas por
    dentro. Cada una abre en su ventana.
  </p>

  <hr />

  <ul class="indice">
    {
      proyectos.map((p) => (
        <li>
          <h2>
            <a href={`#${ventanaDe(p.id)}`}>{p.data.title}</a>
          </h2>
          <p class="apunte">
            {p.data.year} · {ESTADO[p.data.status]} · {p.data.stack.join(" · ")}
          </p>
          <p>{p.data.summary}</p>
        </li>
      ))
    }
  </ul>
</div>
