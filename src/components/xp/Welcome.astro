---
/**
 * The contents of the window that opens by itself: the front door of the site.
 *
 * There are no desktop icons and no Start menu (owner's call, phase 2 §3), so
 * THIS WINDOW IS THE ONLY NAVIGATION. If it runs out of links, the site runs
 * out of ways to reach anything.
 *
 * The shortcuts are real `<a href="#window-id">` and not buttons: with
 * JavaScript the window manager intercepts them and opens the window, and
 * without it they are anchors that jump to the window, which in stacked mode
 * is visible (§3.1).
 */
import { getCollection } from "astro:content";
import { SITE, SOCIAL } from "../../consts";

const year = new Date().getFullYear();

const projects = await getCollection("projects", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
const entries = await getCollection("blog", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const shortcuts = [
  {
    href: "#window-projects",
    title: "Projects",
    caption: plural(projects.length, "project", "projects") + ", from the inside",
  },
  { href: "#window-about", title: "About me", caption: "Who I am and what I work with" },
  {
    href: "#window-blog",
    title: "Blog",
    caption: plural(entries.length, "post", "posts") + " about what I build",
  },
];
---

<div class="xp-doc">
  <h1>Welcome to my page</h1>

  <p class="lede">
    I'm {SITE.name}, a {SITE.role.toLowerCase()}. {SITE.tagline}
  </p>

  <p>
    This is a Windows XP desktop and also my portfolio: everything opens in its
    own window. They drag by the title bar, minimise to the bar at the bottom
    and close.
  </p>

  <ul class="shortcuts">
    {
      shortcuts.map((s) => (
        <li>
          <a class="shortcut" href={s.href}>
            <b>{s.title}</b>
            <span>{s.caption}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <hr />

  {/* Contact goes here and not tucked away in About: it is what someone
      arriving from a job application is looking for, and this is the window
      that is already open. */}
  <p class="row">
    {
      SOCIAL.map((s) => (
        <a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>
          {s.label}
        </a>
      ))
    }
  </p>

  {/* This is NOT decoration: the boot font is CC BY-SA 4.0 and the credit is
      required. It used to live in the site footer, which disappeared with the
      arcade look; it has to be somewhere visible, and this is the window that
      is always open. */}
  <p class="note credits">
    © {year} {SITE.name}. Built with Astro, no analytics and no cookies.<br />
    Boot typeface: AcPlus IBM VGA 8x16 by <a
      href="https://int10h.org/oldschool-pc-fonts/"
      rel="noopener">VileR</a
    >, <a href="/fonts/LICENSE-oldschool-pc-fonts.txt">CC BY-SA 4.0</a>. The
    wallpaper and the Start flag are Microsoft's, here as a homage.
  </p>
</div>

<style>
  .xp-doc .credits {
    margin-bottom: 0;
  }
</style>
