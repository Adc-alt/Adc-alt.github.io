---
/**
 * El contenido de la ventana que abre sola: la puerta del sitio.
 *
 * No hay iconos en el escritorio ni menú Inicio (decisión del usuario, fase 2
 * §3), así que ESTA VENTANA ES LA ÚNICA NAVEGACIÓN. Si se queda sin enlaces,
 * el sitio se queda sin forma de llegar a nada.
 *
 * Los accesos son `<a href="#id-de-ventana">` de verdad y no botones: con
 * JavaScript el gestor los intercepta y abre la ventana, y sin él son anclas
 * que saltan a la ventana, que en modo apilado está visible (§3.1).
 */
import { getCollection } from "astro:content";
import { SITE, SOCIAL } from "../../consts";

const year = new Date().getFullYear();

const proyectos = await getCollection("proyectos", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
const entradas = await getCollection("blog", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);

const plural = (n: number, uno: string, varios: string) =>
  `${n} ${n === 1 ? uno : varios}`;

const accesos = [
  {
    href: "#ventana-proyectos",
    titulo: "Proyectos",
    pie: plural(proyectos.length, "proyecto", "proyectos") + ", por dentro",
  },
  { href: "#ventana-perfil", titulo: "Perfil", pie: "Quién soy y con qué trabajo" },
  {
    href: "#ventana-blog",
    titulo: "Blog",
    pie: plural(entradas.length, "entrada", "entradas") + " sobre lo que construyo",
  },
];
---

<div class="xp-doc">
  <h1>Welcome to my page</h1>

  <p class="lede">
    Soy {SITE.name}, {SITE.role.toLowerCase()}. {SITE.tagline}
  </p>

  <p>
    Esto es un escritorio de Windows XP y a la vez mi portfolio: cada cosa abre
    en su ventana. Se arrastran por la barra de título, se minimizan a la barra
    de abajo y se cierran.
  </p>

  <ul class="accesos">
    {
      accesos.map((a) => (
        <li>
          <a class="acceso" href={a.href}>
            <b>{a.titulo}</b>
            <span>{a.pie}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <hr />

  {/* El contacto va aquí y no escondido en Perfil: es lo que busca quien
      entra desde una candidatura, y esta ventana es la que está abierta. */}
  <p class="fila">
    {
      SOCIAL.map((s) => (
        <a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>
          {s.label}
        </a>
      ))
    }
  </p>

  {/* Esto NO es adorno: la fuente del arranque es CC BY-SA 4.0 y el crédito es
      obligatorio. Vivía en el pie del sitio, que desapareció con la estética
      arcade; tiene que estar en algún sitio visible, y ésta es la ventana que
      siempre está abierta. */}
  <p class="apunte creditos">
    © {year} {SITE.name}. Hecho con Astro, sin analítica y sin cookies.<br />
    Tipografía del arranque: AcPlus IBM VGA 8x16 de <a
      href="https://int10h.org/oldschool-pc-fonts/"
      rel="noopener">VileR</a
    >, <a href="/fonts/LICENSE-oldschool-pc-fonts.txt">CC BY-SA 4.0</a>. El fondo
    y la bandera de Inicio son de Microsoft, aquí como homenaje.
  </p>
</div>

<style>
  .xp-doc .creditos {
    margin-bottom: 0;
  }
</style>
