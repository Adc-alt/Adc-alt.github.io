---
/**
 * The Home section: the first thing the reading pane shows.
 *
 * It used to be a window of its own and the site's only navigation. The Menu
 * window is that now, so what is left here is the introduction — the shortcut
 * grid moved out rather than being duplicated.
 */
import { SITE, SOCIAL } from "../../consts";

const year = new Date().getFullYear();
---

<div class="xp-doc">
  <h1>Welcome to my page</h1>

  <p class="lede">
    I'm {SITE.name}, a {SITE.role.toLowerCase()}. {SITE.tagline}
  </p>

  <p>
    This is a Windows XP desktop and also my portfolio: everything opens in its
    own window. They drag by the title bar, minimise to the bar at the bottom
    and close.
  </p>

  <hr />

  {/* Contact goes here and not tucked away in About: it is what someone
      arriving from a job application is looking for, and this is the window
      that is already open. */}
  <p class="row">
    {
      SOCIAL.map((s) => (
        <a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>
          {s.label}
        </a>
      ))
    }
  </p>

  {/* This is NOT decoration: the boot font is CC BY-SA 4.0 and the credit is
      required. It used to live in the site footer, which disappeared with the
      arcade look; it has to be somewhere visible, and this is the window that
      is always open. */}
  <p class="note credits">
    © {year} {SITE.name}. Built with Astro, no analytics and no cookies.<br />
    Boot typeface: AcPlus IBM VGA 8x16 by <a
      href="https://int10h.org/oldschool-pc-fonts/"
      rel="noopener">VileR</a
    >, <a href="/fonts/LICENSE-oldschool-pc-fonts.txt">CC BY-SA 4.0</a>. The
    wallpaper and the Start flag are Microsoft's, here as a homage.
  </p>
</div>

<style>
  .xp-doc .credits {
    margin-bottom: 0;
  }
</style>
