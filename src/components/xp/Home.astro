---
/**
 * The Home section: the first thing the reading pane shows.
 *
 * It used to be a window of its own and the site's only navigation. The Menu
 * window is that now, so what is left here is the introduction — the shortcut
 * grid moved out rather than being duplicated.
 */
import { SITE, SOCIAL } from "../../consts";
---

<div class="xp-doc">
  <h1>Welcome to my page</h1>

  <p class="lede">
    I'm {SITE.name}, a {SITE.role.toLowerCase()}. {SITE.tagline}
  </p>

  <p>
    This is a Windows XP desktop and also my portfolio. The windows drag by
    their title bar, minimise to the bar at the bottom and close; the menu on
    the left changes what this one shows.
  </p>

  <hr />

  {/* Contact goes here and not tucked away in About: it is what someone
      arriving from a job application is looking for, and this is the window
      that is already open. */}
  <p class="row">
    {
      SOCIAL.map((s) => (
        <a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>
          {s.label}
        </a>
      ))
    }
  </p>
</div>
