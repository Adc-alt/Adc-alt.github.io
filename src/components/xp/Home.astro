---
/**
 * The Home section: the first thing the reading pane shows.
 *
 * It used to be a window of its own and the site's only navigation. The Menu
 * window is that now: `Nav.astro` renders a plain list of links, not a copy of
 * the shortcut grid this section used to have — that grid was deleted, not
 * moved, so what is left here is just the introduction.
 */
import { NOW, SITE, SOCIAL } from "../../consts";
---

<div class="xp-doc">
  <h1>Welcome aboard!</h1>

  <p class="lede">
    I'm {SITE.name}, a {SITE.role.toLowerCase()}. {SITE.tagline}
  </p>

  <p class="note">{NOW.text}</p>

  <p>
    This is a Windows XP desktop and also my portfolio. The windows drag by
    their title bar, minimise to the bar at the bottom and close; the menu on
    the left changes what this one shows.
  </p>

  <hr />

  {/* Contact goes here and not tucked away in About: it is what someone
      arriving from a job application is looking for, and Home is the section
      already on screen when they land — the Contact window repeats it because
      that one stays open even if this section, or this whole pane, gets
      closed. */}
  <p class="row">
    {
      SOCIAL.map((s) => (
        <a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>
          {s.label}
        </a>
      ))
    }
  </p>
</div>
