---
/**
 * The blog feed: every entry one after another, with no per-entry URL.
 *
 * With two entries, a page per post would be two pages of one paragraph and a
 * link back; the feed reads in one go and the window already has its own
 * scroll. Once there are enough of them, the filename already works as a slug.
 *
 * The document styles live in `src/styles/xp-doc.css`, shared with the other
 * four windows.
 */
import { getCollection, render } from "astro:content";

const posts = (
  await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const entries = await Promise.all(
  posts.map(async (post) => ({ ...post, Content: (await render(post)).Content })),
);

const date = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<div class="xp-doc">
  <h1>Blog</h1>

  <p class="lede">What I am building, and the bugs that cost me a whole afternoon.</p>

  <hr />

  {
    entries.map(({ id, data, Content }) => (
      <article class="entry">
        <h2 id={id}>{data.title}</h2>
        <p class="note">
          <time datetime={data.date.toISOString().slice(0, 10)}>{date.format(data.date)}</time>
        </p>
        <Content />
      </article>
    ))
  }
</div>

<style>
  .entry {
    margin: 0 0 2.4rem;
  }
  .entry h2 {
    margin-bottom: 0.2rem;
  }
  .entry:last-child {
    margin-bottom: 0;
  }
</style>
