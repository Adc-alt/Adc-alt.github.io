---
/**
 * El feed del blog: todas las entradas seguidas, sin URL propia por entrada.
 *
 * Con dos entradas, una página por post serían dos páginas de un párrafo y un
 * enlace de vuelta; el feed se lee de un tirón y la ventana ya tiene su propio
 * scroll. Cuando haya suficientes, el nombre del fichero ya sirve de slug.
 *
 * Los estilos del documento están en `src/styles/xp-doc.css`, compartidos con
 * las otras cuatro ventanas.
 */
import { getCollection, render } from "astro:content";

const posts = (
  await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const entradas = await Promise.all(
  posts.map(async (post) => ({ ...post, Content: (await render(post)).Content })),
);

const fecha = new Intl.DateTimeFormat("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<div class="xp-doc">
  <h1>Blog</h1>

  <p class="lede">
    Lo que voy construyendo y los fallos que me cuestan una tarde entera.
  </p>

  <hr />

  {
    entradas.map(({ id, data, Content }) => (
      <article class="entrada">
        <h2 id={id}>{data.title}</h2>
        <p class="apunte">
          <time datetime={data.date.toISOString().slice(0, 10)}>{fecha.format(data.date)}</time>
        </p>
        <Content />
      </article>
    ))
  }
</div>

<style>
  .entrada {
    margin: 0 0 2.4rem;
  }
  .entrada h2 {
    margin-bottom: 0.2rem;
  }
  .entrada:last-child {
    margin-bottom: 0;
  }
</style>
