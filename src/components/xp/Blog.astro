---
/**
 * El contenido de la ventana: bienvenida y feed del blog.
 *
 * Todas las entradas seguidas, sin URL propia por entrada. Con dos entradas,
 * una página por post serían dos páginas de un párrafo y un enlace de vuelta;
 * el feed se lee de un tirón y la ventana ya tiene su propio scroll. Cuando
 * haya suficientes, el nombre del fichero ya sirve de slug.
 */
import { getCollection, render } from "astro:content";
import { SITE, NAV } from "../../consts";

const posts = (
  await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const entradas = await Promise.all(
  posts.map(async (post) => ({ ...post, Content: (await render(post)).Content })),
);

const fecha = new Intl.DateTimeFormat("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<div class="xp-doc">
  <h1>Welcome to my page</h1>

  <p class="lede">
    Soy {SITE.name}, {SITE.role.toLowerCase()}. Esto es un escritorio de Windows XP
    y a la vez mi sitio: aquí escribo sobre lo que construyo y sobre los fallos que
    me cuestan una tarde entera.
  </p>

  {/* El escritorio todavía no tiene iconos ni menú Inicio, así que sin estos
      enlaces la ventana sería un callejón sin salida. */}
  <p class="atajos">
    {
      NAV.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
  </p>

  <hr />

  {
    entradas.map(({ id, data, Content }) => (
      <article class="entrada">
        <h2 id={id}>{data.title}</h2>
        <p class="fecha">
          <time datetime={data.date.toISOString().slice(0, 10)}>{fecha.format(data.date)}</time>
        </p>
        <Content />
      </article>
    ))
  }
</div>

<style>
  /* Tipografía de documento de Windows: Tahoma para la interfaz, y aquí un
     cuerpo algo mayor porque esto es texto para leer, no etiquetas. */
  .xp-doc {
    max-width: 62ch;
  }
  .xp-doc h1 {
    margin: 0 0 0.35rem;
    font-size: 1.7rem;
    line-height: 1.15;
    color: #0a246a;
  }
  .lede {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    color: #3a3a32;
  }

  .atajos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 0 0 1.2rem;
    font-size: 0.9rem;
  }

  hr {
    height: 0;
    margin: 0 0 1.6rem;
    border: 0;
    /* El separador grabado de Windows: una línea oscura y otra clara debajo. */
    border-top: 1px solid #aca899;
    border-bottom: 1px solid #ffffff;
  }

  .entrada {
    margin: 0 0 2.4rem;
  }
  .entrada:last-child {
    margin-bottom: 0;
  }
  .entrada h2 {
    margin: 0 0 0.2rem;
    font-size: 1.15rem;
    line-height: 1.3;
    color: #0a246a;
  }
  .fecha {
    margin: 0 0 0.9rem;
    font-size: 0.8rem;
    color: #6b675c;
  }

  /* El Markdown renderizado. `:global` porque lo genera <Content /> y no lleva
     el atributo de ámbito; va anidado bajo .entrada, que sí es nuestro. */
  .xp-doc :global(p) {
    margin: 0 0 0.9rem;
  }
  .xp-doc :global(ul) {
    margin: 0 0 0.9rem;
    padding-left: 1.4rem;
  }
  .xp-doc :global(li) {
    margin-bottom: 0.35rem;
  }
  .xp-doc :global(strong) {
    font-weight: bold;
  }
  .xp-doc :global(a) {
    color: #0000ee;
    text-decoration: underline;
  }
  .xp-doc :global(a:visited) {
    color: #551a8b;
  }
  .xp-doc :global(code) {
    padding: 0 0.2em;
    background: #ffffff;
    border: 1px solid #c8c4b4;
    font-family: "Courier New", monospace;
    font-size: 0.9em;
  }
  .xp-doc :global(pre) {
    margin: 0 0 0.9rem;
    padding: 0.7rem 0.9rem;
    /* El hueco hundido de Windows: blanco con filo oscuro arriba y a la
       izquierda. */
    background: #ffffff;
    border: 1px solid #7f9db9;
    box-shadow: inset 1px 1px 0 rgba(0, 0, 0, 0.12);
    overflow-x: auto;
  }
  .xp-doc :global(pre code) {
    padding: 0;
    background: none;
    border: 0;
  }
</style>
