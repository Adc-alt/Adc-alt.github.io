---
/**
 * A Windows XP window, Luna theme.
 *
 * ⚠️ PROVENANCE WARNING, different from the rest of this directory: the taskbar
 * colours are MEASURED off screenshots (§4 of the phase 1 spec). These are NOT.
 * They are the public Luna approximation that circulates on the web (the one
 * xp.css and friends use), eyeballed against memory. If a native capture ever
 * turns up, this gets measured and promoted to a module with a test, like the
 * others.
 *
 * The content is build-time HTML. The JavaScript only opens, closes, drags,
 * minimises and maximises.
 *
 * TWO MODES, and the order matters (phase 2 §4):
 *
 *   - **Stacked** is the BASE: windows in a column, all visible, and the page
 *     scrolls. It is what a phone gets and what anyone without JavaScript gets,
 *     on any screen.
 *   - **Desktop** is the ENHANCEMENT: absolute, draggable, they open and close.
 *     It lives inside `@media (min-width: 721px)` and hangs off `html.js`,
 *     which an inline script in the layout sets.
 *
 * Written the other way round the same rules would need two copies, and a
 * JavaScript failure would leave the site blank instead of in reading mode.
 *
 * Hiding is `display: none`, which already removes the window from the tab
 * order and the accessibility tree: no need for `inert` on top.
 */
import { enterDelay, initialPosition } from "./windows.mjs";
import { HEIGHT as BAR_H } from "./taskbar-colors.mjs";

interface Props {
  /** Title of the title bar and of the taskbar button. */
  title: string;
  /** Unique identifier. It is what links point at: `href="#id"`. */
  id: string;
  width?: number;
  height?: number;
  /** Whether it opens by itself on load. */
  open?: boolean;
  /** Position in the arrival sequence: 0 arrives first. */
  order?: number;
  /** Whether it takes part in the row layout (phase 3 §4.1). */
  row?: boolean;
  /** Half the body padding. For the small windows, where 22px eats the content. */
  tight?: boolean;
  /** Build-time position. Overrides the centred default; the script re-lays it anyway. */
  x?: number;
  y?: number;
}

const {
  title,
  id,
  width = 720,
  height = 520,
  open = false,
  order = 0,
  row = false,
  tight = false,
  x,
  y,
} = Astro.props;

/* Build-time position, computed against a 1440x900 reference desktop. In
   desktop mode the script recomputes it against the real screen; in stacked
   mode it is not used. Passing x/y explicitly is how `index.astro` hands over
   the row it already knows, so a returning visitor — who gets no boot screen —
   does not see the windows land centred and then jump. */
const fallback = initialPosition({ w: width, h: height }, { vw: 1440, vh: 900, barH: BAR_H });
const pos = { x: x ?? fallback.x, y: y ?? fallback.y };
---

<section
  class="xp-window"
  id={id}
  data-open={open ? "true" : "false"}
  data-row={row ? "true" : undefined}
  data-tight={tight ? "true" : undefined}
  tabindex="-1"
  style={`--x:${pos.x}px;--y:${pos.y}px;--w:${width}px;--h:${height}px;--bar-h:${BAR_H}px;--enter-delay:${enterDelay(order)}ms`}
  aria-labelledby={`${id}-title`}
>
  <div class="xp-titlebar">
    <img class="xp-titleicon" src="/xp/win-flag.png" width="52" height="48" alt="" />
    <h2 class="xp-titletext" id={`${id}-title`}>{title}</h2>

    {/* The three buttons are real <button>s. Minimise and maximise change state
        and so carry aria-pressed; close does not come back, so it does not. In
        stacked mode they are not drawn: there they mean nothing. */}
    <div class="xp-winbtns">
      <button class="xp-winbtn xp-min" type="button" aria-pressed="false" aria-label="Minimise"
        ><span aria-hidden="true">─</span></button
      >
      <button class="xp-winbtn xp-max" type="button" aria-pressed="false" aria-label="Maximise"
        ><span aria-hidden="true">□</span></button
      >
      <button class="xp-winbtn xp-close" type="button" aria-label="Close"
        ><span aria-hidden="true">✕</span></button
      >
    </div>
  </div>

  <div class="xp-winbody">
    <slot />
  </div>
</section>

<script>
  import { cascadePosition, clampPosition, rowPositions } from "./windows.mjs";

  /* 721px: below that the desktop gives up and everything goes to stacked mode
     (phase 2 §4). The same number is in the CSS of this file. */
  const DESKTOP = matchMedia("(min-width: 721px)");

  /** The real height of the taskbar, measured in the DOM and not repeated here. */
  const barHeight = () =>
    document.querySelector(".xp-taskbar")?.getBoundingClientRect().height ?? 0;

  const tasks = document.querySelector(".xp-tasks");

  /** window id → how to open it. The link handler looks it up here. */
  const windows = new Map<string, () => void>();

  /** Depth counter. It goes up and never down: last clicked, front-most. */
  let zTop = 5;

  document.querySelectorAll<HTMLElement>(".xp-window").forEach((win) => {
    const titlebar = win.querySelector<HTMLElement>(".xp-titlebar");
    const btnMin = win.querySelector<HTMLButtonElement>(".xp-min");
    const btnMax = win.querySelector<HTMLButtonElement>(".xp-max");
    const btnClose = win.querySelector<HTMLButtonElement>(".xp-close");
    const titleText = win.querySelector<HTMLElement>(".xp-titletext");
    if (!titlebar || !btnMin || !btnMax || !btnClose || !titleText) return;

    const px = (name: string) => parseFloat(getComputedStyle(win).getPropertyValue(name)) || 0;
    const desk = () => ({ vw: innerWidth, vh: innerHeight, barH: barHeight() });
    const size = () => ({ w: win.offsetWidth, h: win.offsetHeight });
    const move = (p: { x: number; y: number }) => {
      win.style.setProperty("--x", `${p.x}px`);
      win.style.setProperty("--y", `${p.y}px`);
    };
    const reclamp = () => move(clampPosition({ ...size(), x: px("--x"), y: px("--y") }, desk()));

    // ── The taskbar button ────────────────────────────────────────────────
    // Created by the script and not by the HTML: without JS nothing can be
    // minimised or closed, so a button that restores would have nothing to do.
    const task = document.createElement("button");
    task.type = "button";
    task.className = "xp-task";
    task.textContent = titleText.textContent;

    const toFront = () => {
      if (win.classList.contains("is-front")) return;
      win.style.zIndex = String(++zTop);
      document
        .querySelectorAll(".xp-window.is-front")
        .forEach((other) => other.classList.remove("is-front"));
      document
        .querySelectorAll(".xp-task-active")
        .forEach((other) => other.classList.remove("xp-task-active"));
      win.classList.add("is-front");
      task.classList.add("xp-task-active");
    };

    const restore = () => {
      win.classList.remove("is-min");
      btnMin.setAttribute("aria-pressed", "false");
    };

    const open = () => {
      if (win.dataset.open !== "true") {
        // Counted BEFORE opening this one: the cascade places it behind the
        // ones already there. And `data-open` is set before measuring, because
        // a window in display:none measures 0x0.
        const alreadyOpen = document.querySelectorAll('.xp-window[data-open="true"]').length;
        win.dataset.open = "true";
        restore();
        if (DESKTOP.matches) {
          tasks?.appendChild(task);
          move(cascadePosition(alreadyOpen, size(), desk()));
        }
      }
      toFront();
      win.focus();
    };

    const close = () => {
      win.dataset.open = "false";
      win.classList.remove("is-min", "is-front");
      // The button does NOT go (phase 3 §4.3). In XP it would, but in XP there
      // are desktop icons and a Start menu to get the window back; here there is
      // nothing else, and closing the Menu window under XP's rule would leave a
      // visitor with a site and no way to navigate it until they reloaded.
      task.classList.remove("xp-task-active");
      task.focus();
    };

    const minimise = () => {
      win.classList.add("is-min");
      win.classList.remove("is-front");
      btnMin.setAttribute("aria-pressed", "true");
      task.classList.remove("xp-task-active");
      task.focus();
    };

    // A click on the taskbar button does what it does in Windows, plus one
    // thing XP does not need: it also brings back a window that was closed.
    task.addEventListener("click", () => {
      const outOfSight =
        win.dataset.open !== "true" || win.classList.contains("is-min");
      if (outOfSight || !win.classList.contains("is-front")) {
        win.dataset.open = "true";
        restore();
        toFront();
        win.focus();
      } else {
        minimise();
      }
    });

    // ── The three buttons ─────────────────────────────────────────────────
    btnMin.addEventListener("click", minimise);
    btnClose.addEventListener("click", close);
    btnMax.addEventListener("click", () => {
      const on = !win.classList.contains("is-max");
      win.classList.toggle("is-max", on);
      btnMax.setAttribute("aria-pressed", String(on));
      // On restore, the stored position may have fallen outside if the screen
      // changed while the window was maximised.
      if (!on) reclamp();
    });

    // The only way to retitle a window from outside. It has to go through here
    // because the taskbar button's text is copied once at start-up: retitling
    // just the title bar leaves the button saying something else.
    win.addEventListener("xp:title", (e) => {
      const next = (e as CustomEvent<string>).detail;
      if (!next) return;
      titleText.textContent = next;
      task.textContent = next;
    });

    // Pressing anywhere in the window brings it to the front, like in Windows.
    // On capture so it lands before the buttons inside.
    win.addEventListener("pointerdown", () => toFront(), true);

    // ── Dragging ──────────────────────────────────────────────────────────
    // Pointers and not mouse: the same code covers finger and stylus. The
    // capture is what stops a fast drag getting lost when the cursor outruns
    // the window.
    let from: { px: number; py: number; x: number; y: number } | null = null;

    titlebar.addEventListener("pointerdown", (e) => {
      const onButton = (e.target as HTMLElement).closest(".xp-winbtn");
      if (onButton || win.classList.contains("is-max") || !DESKTOP.matches) return;
      from = { px: e.clientX, py: e.clientY, x: px("--x"), y: px("--y") };
      titlebar.setPointerCapture(e.pointerId);
    });

    titlebar.addEventListener("pointermove", (e) => {
      if (!from) return;
      e.preventDefault();
      move(
        clampPosition(
          { ...size(), x: from.x + (e.clientX - from.px), y: from.y + (e.clientY - from.py) },
          desk(),
        ),
      );
    });

    const endDrag = () => {
      from = null;
    };
    titlebar.addEventListener("pointerup", endDrag);
    titlebar.addEventListener("pointercancel", endDrag);

    // When the screen is resized the window can end up outside.
    addEventListener("resize", () => {
      if (DESKTOP.matches && win.dataset.open === "true") reclamp();
    });

    /** The row if this window is in one and it fits; the cascade otherwise. */
    const placement = (index: number) =>
      placeRow(win) ?? cascadePosition(index, size(), desk());

    // ── Start-up ──────────────────────────────────────────────────────────
    windows.set(win.id, open);

    if (win.dataset.open === "true" && DESKTOP.matches) {
      // Counted BEFORE appending, as phase 2 did: it is the cascade's index,
      // and it has to be different for each window. Counting open windows
      // instead would give every one of them the same number at start-up,
      // because they are all already `data-open="true"` in the HTML, and the
      // cascade would stack them on one spot.
      const alreadyPlaced = tasks?.children.length ?? 0;
      tasks?.appendChild(task);
      move(placement(alreadyPlaced));
      toFront();
    }
  });

  /**
   * Where a window goes when it first appears.
   *
   * Row windows are laid out together: each one reads every `[data-row]` window
   * in DOM order, computes the whole row and takes its own slot. Doing the same
   * arithmetic three times is cheaper than a shared layout pass and keeps each
   * window's script self-contained.
   */
  function placeRow(win: HTMLElement): { x: number; y: number } | null {
    const row = [...document.querySelectorAll<HTMLElement>('.xp-window[data-row="true"]')];
    const index = row.indexOf(win);
    if (index < 0) return null;
    // offsetWidth/offsetHeight and not getBoundingClientRect: the arrival
    // animation holds a `scale(0.92)` on the window through its delay, which
    // the rect would report and the offsets would not.
    const sizes = row.map((w) => ({ w: w.offsetWidth, h: w.offsetHeight }));
    const positions = rowPositions(sizes, {
      vw: innerWidth,
      vh: innerHeight,
      barH: barHeight(),
    });
    return positions ? positions[index] : null;
  }

  // ── The links that open windows ─────────────────────────────────────────
  // Delegated on the document: it covers the links that exist now and any that
  // live inside a window. In stacked mode it does NOT intercept: there the
  // anchor does its usual job, which is jumping to the window, which is
  // visible. That is what gives navigation without JavaScript.
  document.addEventListener("click", (e) => {
    if (!DESKTOP.matches) return;
    const link = (e.target as HTMLElement | null)?.closest?.("a[href]");
    if (!(link instanceof HTMLAnchorElement)) return;
    const href = link.getAttribute("href") ?? "";
    if (!href.startsWith("#")) return;
    const open = windows.get(href.slice(1));
    if (!open) return;
    e.preventDefault();
    open();
  });
</script>

<style>
  /* ══ STACKED MODE — the base ══════════════════════════════════════════════
     Phone and no-JavaScript. In a column, all visible, the page scrolls. */
  .xp-window {
    position: relative;
    box-sizing: border-box;
    width: min(100%, var(--w));
    margin: 0 auto 14px;
    display: flex;
    flex-direction: column;
    /* The Luna frame: 3px of blue at the sides and the bottom, rounded corners
       at the top and square ones at the bottom. */
    background: #0831d9;
    border-radius: 8px 8px 0 0;
    padding: 0 3px 3px;
    box-shadow: 2px 3px 12px rgba(0, 0, 0, 0.45);
    font-family: Tahoma, "DejaVu Sans", Verdana, sans-serif;
  }
  /* No focus ring of its own: it is a container with tabindex="-1" that the
     script focuses on open, not something you tab to. */
  .xp-window:focus {
    outline: none;
  }

  /* ── The title bar ────────────────────────────────────────────────────── */
  .xp-titlebar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    padding: 0 3px 0 5px;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(
      to bottom,
      #0997ff 0,
      #0053ee 8%,
      #0050ee 40%,
      #0066ff 88%,
      #005bff 95%,
      #003dd7 96%,
      #003dd7 100%
    );
  }
  .xp-titleicon {
    height: 16px;
    width: auto;
    display: block;
  }
  .xp-titletext {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #ffffff;
    font: bold 13px/1 Tahoma, "DejaVu Sans", Verdana, sans-serif;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.5);
  }

  /* Hidden when stacked: minimise, maximise and close mean nothing in a column,
     and a button that does nothing is worse than no button. */
  .xp-winbtns {
    display: none;
    flex: none;
    gap: 2px;
  }
  .xp-winbtn {
    width: 21px;
    height: 21px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 3px;
    background: linear-gradient(to bottom, #2f8ef5 0, #1b60d8 50%, #0a44b5 100%);
    color: #ffffff;
    font-size: 12px;
    line-height: 1;
    cursor: default;
  }
  .xp-close {
    background: linear-gradient(to bottom, #f18f6a 0, #d9542a 45%, #b32d13 100%);
  }
  .xp-winbtn:hover {
    filter: brightness(1.18);
  }
  .xp-winbtn:active {
    filter: brightness(0.85);
  }
  .xp-winbtn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: -3px;
  }

  /* ── The body ─────────────────────────────────────────────────────────── */
  .xp-winbody {
    flex: 1 1 auto;
    min-height: 0;
    background: #ece9d8;
    color: #000000;
    padding: 18px 22px 24px;
    font-size: 14px;
    line-height: 1.55;
  }
  /* 22px of padding inside a 200px window leaves 156px of content. The Menu and
     the Contact card ask for this; the reading pane does not. */
  .xp-window[data-tight] .xp-winbody {
    padding: 8px;
  }

  /* ══ DESKTOP MODE — the enhancement ═══════════════════════════════════════
     `html.js` is set by an inline script in the layout. Without JavaScript this
     media query never applies, on any screen, and everything stays stacked. */
  @media (min-width: 721px) {
    :global(html.js) .xp-window {
      position: absolute;
      top: var(--y);
      left: var(--x);
      z-index: 5;
      width: var(--w);
      margin: 0;
      /* Never wider than the screen nor taller than the well above the taskbar:
         on a small screen the window shrinks instead of falling off. */
      max-width: calc(100vw - 16px);
      height: var(--h);
      max-height: calc(100dvh - var(--bar-h, 40px) - 16px);
    }
    :global(html.js) .xp-window[data-open="false"],
    :global(html.js) .xp-window.is-min {
      display: none;
    }
    :global(html.js) .xp-titlebar {
      /* The title bar is the handle: a text cursor here is wrong.
         `touch-action: none` is what allows dragging with a finger without the
         browser stealing the gesture — and that is exactly why it CANNOT be in
         stacked mode, where dragging the bar has to scroll the page. */
      cursor: default;
      user-select: none;
      touch-action: none;
    }
    /* The window that is not in front wears a dimmed title bar. It is how you
       tell the active one apart in Windows, and with five windows you need it.
       A filter and not a second gradient: there is no capture of the inactive
       bar to measure, and approximating twice is worse than approximating
       once. */
    :global(html.js) .xp-window:not(.is-front) .xp-titlebar {
      filter: saturate(0.4) brightness(0.92);
    }
    :global(html.js) .xp-winbtns {
      display: flex;
    }
    :global(html.js) .xp-winbody {
      /* Here it is the window that scrolls, not the page: the desktop has no
         scroll. The scrollbar is tinted by hand, and like the rest of this
         window's colours it is approximation and not measurement: the XP one is
         a relief drawing that `scrollbar-color` cannot do. */
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-color: #a7bdd9 #f1efe2;
    }
    :global(html.js) .xp-window.is-max {
      top: 0;
      left: 0;
      width: 100vw;
      max-width: 100vw;
      height: calc(100dvh - var(--bar-h, 40px));
      max-height: none;
      border-radius: 0;
      padding-left: 0;
      padding-right: 0;
    }
    :global(html.js) .xp-window.is-max .xp-titlebar {
      border-radius: 0;
    }
  }

  /* ── The arrival ──────────────────────────────────────────────────────── */
  /* `html:not([data-boot])` is the entire trick, and it is why this is an
     animation now and was a transition in phase 2.

     A CSS animation starts when the element FIRST MATCHES the rule. While the
     boot screen is up the rule does not match, so nothing is running; the
     moment `Boot.astro` removes the attribute the element starts matching and
     the delay is counted from THERE. That is what phase 2 could not do with
     @keyframes — an animation with a delay counts from page load, so it would
     have played behind the boot screen — and it is what a transition could not
     do either, because a returning visitor gets no boot screen and therefore no
     attribute change to transition off. Now both visits get the same sequence.

     `both` fill: before the delay the window holds the `from` state, so it is
     invisible while the script re-lays it against the real viewport, and the
     correction is never seen.

     Nothing here can strand the site invisible. There is no base `opacity: 0`
     for a failed script to undo: the hiding is the animation's own backwards
     fill plus one rule that only applies while the boot screen is on top. With
     reduced motion neither rule exists and every window is simply visible. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-boot]) .xp-window {
      opacity: 0;
    }
    :global(html:not([data-boot])) .xp-window {
      animation: xp-window-enter 260ms cubic-bezier(0.16, 1, 0.3, 1) var(--enter-delay, 900ms)
        both;
    }
    @keyframes xp-window-enter {
      from {
        opacity: 0;
        transform: scale(0.92) translateY(12px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
