---
/**
 * A Windows XP window, Luna theme.
 *
 * ⚠️ PROVENANCE WARNING, different from the rest of this directory: the taskbar
 * colours are MEASURED off screenshots (§4 of the phase 1 spec). These are NOT.
 * They are the public Luna approximation that circulates on the web (the one
 * xp.css and friends use), eyeballed against memory. If a native capture ever
 * turns up, this gets measured and promoted to a module with a test, like the
 * others.
 *
 * The content is build-time HTML. The JavaScript only opens, closes, drags,
 * minimises and maximises.
 *
 * TWO MODES, and the order matters (phase 2 §4):
 *
 *   - **Stacked** is the BASE: windows in a column, all visible, and the page
 *     scrolls. It is what a phone gets and what anyone without JavaScript gets,
 *     on any screen.
 *   - **Desktop** is the ENHANCEMENT: absolute, draggable, they open and close.
 *     It lives inside `@media (min-width: 1270px)` and hangs off `html.js`,
 *     which an inline script in the layout sets. 1270 is not a taste: it is the
 *     width the three-window row needs (`DESKTOP_MIN_WIDTH` in `windows.mjs`),
 *     and desktop mode means exactly "the row fits".
 *
 * Written the other way round the same rules would need two copies, and a
 * JavaScript failure would leave the site blank instead of in reading mode.
 *
 * Hiding is `display: none`, which already removes the window from the tab
 * order and the accessibility tree: no need for `inert` on top.
 */
import { enterDelay, initialPosition } from "./windows.mjs";
import { HEIGHT as BAR_H } from "./taskbar-colors.mjs";

interface Props {
  /** Title of the title bar and of the taskbar button. */
  title: string;
  /** Unique identifier. It is what links point at: `href="#id"`. */
  id: string;
  width?: number;
  height?: number;
  /** Whether it opens by itself on load. */
  open?: boolean;
  /** Position in the arrival sequence: 0 arrives first. */
  order?: number;
  /**
   * Skips the arrival stagger entirely: the window is there from the first
   * frame. For `/404`, which mounts no boot screen (you reach a 404 by
   * accident) and would otherwise show an empty desktop for the whole delay.
   */
  noEnter?: boolean;
  /** Whether it takes part in the row layout (phase 3 §4.1). */
  row?: boolean;
  /** Half the body padding. For the small windows, where 22px eats the content. */
  tight?: boolean;
  /** Build-time position. Overrides the centred default; the script re-lays it anyway. */
  x?: number;
  y?: number;
}

const {
  title,
  id,
  width = 720,
  height = 520,
  open = false,
  order = 0,
  noEnter = false,
  row = false,
  tight = false,
  x,
  y,
} = Astro.props;

/* Build-time position, computed against a 1440x900 reference desktop. In
   desktop mode the script recomputes it against the real screen; in stacked
   mode it is not used. Passing x/y explicitly is how `index.astro` hands over
   the row it already knows, so a returning visitor — who gets no boot screen —
   does not see the windows land centred and then jump. */
const fallback = initialPosition({ w: width, h: height }, { vw: 1440, vh: 900, barH: BAR_H });
const pos = { x: x ?? fallback.x, y: y ?? fallback.y };
---

<section
  class="xp-window"
  id={id}
  data-open={open ? "true" : "false"}
  data-row={row ? "true" : undefined}
  data-tight={tight ? "true" : undefined}
  tabindex="-1"
  style={`--x:${pos.x}px;--y:${pos.y}px;--w:${width}px;--h:${height}px;--bar-h:${BAR_H}px;--enter-delay:${noEnter ? 0 : enterDelay(order)}ms`}
  aria-labelledby={`${id}-title`}
>
  <div class="xp-titlebar">
    <img class="xp-titleicon" src="/xp/win-flag.png" width="52" height="48" alt="" />
    <h2 class="xp-titletext" id={`${id}-title`}>{title}</h2>

    {/* The three buttons are real <button>s. Minimise and maximise change state
        and so carry aria-pressed; close does not come back, so it does not. In
        stacked mode they are not drawn: there they mean nothing. */}
    <div class="xp-winbtns">
      <button class="xp-winbtn xp-min" type="button" aria-pressed="false" aria-label="Minimise"
        ><span aria-hidden="true">─</span></button
      >
      <button class="xp-winbtn xp-max" type="button" aria-pressed="false" aria-label="Maximise"
        ><span aria-hidden="true">□</span></button
      >
      <button class="xp-winbtn xp-close" type="button" aria-label="Close"
        ><span aria-hidden="true">✕</span></button
      >
    </div>
  </div>

  <div class="xp-winbody">
    <slot />
  </div>
</section>

<script>
  import {
    DESKTOP_MIN_WIDTH,
    cascadePosition,
    clampPosition,
    initialPosition,
    rowPositions,
  } from "./windows.mjs";

  /* Desktop mode means "the three-window row fits". Below `DESKTOP_MIN_WIDTH`
     (1270px, derived in windows.mjs from the row's own sizes) everything goes
     to stacked mode. The same number is in the CSS of this file, where a media
     query cannot read the constant. */
  const DESKTOP = matchMedia(`(min-width: ${DESKTOP_MIN_WIDTH}px)`);

  /** The real height of the taskbar, measured in the DOM and not repeated here. */
  const barHeight = () =>
    document.querySelector(".xp-taskbar")?.getBoundingClientRect().height ?? 0;

  const tasks = document.querySelector(".xp-tasks");

  /** Depth counter. It goes up and never down: last clicked, front-most. */
  let zTop = 5;

  document.querySelectorAll<HTMLElement>(".xp-window").forEach((win) => {
    const titlebar = win.querySelector<HTMLElement>(".xp-titlebar");
    const btnMin = win.querySelector<HTMLButtonElement>(".xp-min");
    const btnMax = win.querySelector<HTMLButtonElement>(".xp-max");
    const btnClose = win.querySelector<HTMLButtonElement>(".xp-close");
    const titleText = win.querySelector<HTMLElement>(".xp-titletext");
    if (!titlebar || !btnMin || !btnMax || !btnClose || !titleText) return;

    const px = (name: string) => parseFloat(getComputedStyle(win).getPropertyValue(name)) || 0;
    const desk = () => ({ vw: innerWidth, vh: innerHeight, barH: barHeight() });
    const size = () => ({ w: win.offsetWidth, h: win.offsetHeight });
    const move = (p: { x: number; y: number }) => {
      win.style.setProperty("--x", `${p.x}px`);
      win.style.setProperty("--y", `${p.y}px`);
    };
    const reclamp = () => move(clampPosition({ ...size(), x: px("--x"), y: px("--y") }, desk()));

    // ── The taskbar button ────────────────────────────────────────────────
    // Created by the script and not by the HTML: without JS nothing can be
    // minimised or closed, so a button that restores would have nothing to do.
    const task = document.createElement("button");
    task.type = "button";
    task.className = "xp-task";
    task.textContent = titleText.textContent;

    const toFront = () => {
      if (win.classList.contains("is-front")) return;
      win.style.zIndex = String(++zTop);
      document
        .querySelectorAll(".xp-window.is-front")
        .forEach((other) => other.classList.remove("is-front"));
      document
        .querySelectorAll(".xp-task-active")
        .forEach((other) => other.classList.remove("xp-task-active"));
      win.classList.add("is-front");
      task.classList.add("xp-task-active");
    };

    const restore = () => {
      win.classList.remove("is-min");
      btnMin.setAttribute("aria-pressed", "false");
    };

    const close = () => {
      win.dataset.open = "false";
      win.classList.remove("is-min", "is-front");
      // The button does NOT go (phase 3 §4.3). In XP it would, but in XP there
      // are desktop icons and a Start menu to get the window back; here there is
      // nothing else, and closing the Menu window under XP's rule would leave a
      // visitor with a site and no way to navigate it until they reloaded.
      task.classList.remove("xp-task-active");
      // Said out loud because closing can mean something to what is inside: the
      // Games folder listens for this and forgets which game was open.
      win.dispatchEvent(new CustomEvent("xp:close"));
      task.focus();
    };

    const minimise = () => {
      win.classList.add("is-min");
      win.classList.remove("is-front");
      btnMin.setAttribute("aria-pressed", "true");
      task.classList.remove("xp-task-active");
      task.focus();
    };

    // A click on the taskbar button does what it does in Windows, plus one
    // thing XP does not need: it also brings back a window that was closed.
    task.addEventListener("click", () => {
      const outOfSight =
        win.dataset.open !== "true" || win.classList.contains("is-min");
      if (outOfSight || !win.classList.contains("is-front")) {
        win.dataset.open = "true";
        restore();
        // A window can be closed at one viewport size and reopened at another,
        // and without this it comes back at coordinates that no longer exist.
        // The resize handler only reclamps windows with `data-open="true"`, so
        // a closed one is never caught up; a minimised one still counts as open
        // and IS reclamped, but under `display: none` it measures 0×0, so the
        // numbers it was clamped against were meaningless. Both need this.
        if (DESKTOP.matches) reclamp();
        toFront();
        win.focus();
      } else {
        minimise();
      }
    });

    // ── The three buttons ─────────────────────────────────────────────────
    btnMin.addEventListener("click", minimise);
    btnClose.addEventListener("click", close);
    btnMax.addEventListener("click", () => {
      const on = !win.classList.contains("is-max");
      win.classList.toggle("is-max", on);
      btnMax.setAttribute("aria-pressed", String(on));
      // On restore, the stored position may have fallen outside if the screen
      // changed while the window was maximised.
      if (!on) reclamp();
      // Said out loud for the same reason as `xp:close`: what is inside may
      // want more than a bigger box. Pinball takes this as the cue to go full
      // screen, and it can only do that because this runs inside the click —
      // `requestFullscreen()` is refused outside a gesture.
      win.dispatchEvent(new CustomEvent("xp:maximise", { detail: on }));
    });

    // The only way to retitle a window from outside. It has to go through here
    // because the taskbar button's text is copied once at start-up: retitling
    // just the title bar leaves the button saying something else.
    win.addEventListener("xp:title", (e) => {
      const next = (e as CustomEvent<string>).detail;
      if (!next) return;
      titleText.textContent = next;
      task.textContent = next;
    });

    // Brings the window back without knowing anything about who asked. The
    // reading pane needs it: closing it is allowed, and a Menu click has to
    // work afterwards — phase 3 does not intercept those clicks, so nothing
    // else would reopen it. Idempotent, and deliberately does not take focus:
    // whoever dispatched this knows better what the visitor should land on.
    win.addEventListener("xp:show", () => {
      win.dataset.open = "true";
      restore();
      // A window that was closed at load has never been through `enterDesktop`,
      // so this is where it gets its taskbar button and its first position.
      // Idempotent for the windows that already have both.
      ensurePlaced();
      if (DESKTOP.matches) reclamp();
      toFront();
    });

    /**
     * Resizes the window so its BODY is exactly `detail.w` x `detail.h`, and
     * puts it back with no detail at all.
     *
     * This is what "the game fills the window" means: an application window in
     * Windows is the size of what is inside it — Minesweeper's window is the
     * size of the board and changes when the board does. The caller measures
     * its own content and does not know or care what the title bar costs; the
     * chrome is measured here, from the difference between the window and its
     * body, so a change to the padding or the bar's height needs no edit.
     *
     * `authored` is captured once, on the first resize, because after that the
     * inline `--w` is whatever the last game asked for.
     */
    const body = win.querySelector<HTMLElement>(".xp-winbody");
    let authored: { w: string; h: string } | null = null;

    win.addEventListener("xp:resize", (e) => {
      if (!body || !DESKTOP.matches) return;
      const size = (e as CustomEvent<{ w: number; h: number } | undefined>).detail;

      if (!authored) {
        const style = getComputedStyle(win);
        authored = {
          w: style.getPropertyValue("--w").trim(),
          h: style.getPropertyValue("--h").trim(),
        };
      }
      if (!size) {
        win.style.setProperty("--w", authored.w);
        win.style.setProperty("--h", authored.h);
      } else {
        // clientWidth and not offsetWidth: the body's own border and scrollbar
        // are chrome as far as the caller is concerned.
        const chromeW = win.offsetWidth - body.clientWidth;
        const chromeH = win.offsetHeight - body.clientHeight;
        win.style.setProperty("--w", `${Math.ceil(size.w) + chromeW}px`);
        win.style.setProperty("--h", `${Math.ceil(size.h) + chromeH}px`);
      }
      /* And it recentres. A game is not a document: it opens in the middle of
         the screen, where a new window opens, rather than growing out of
         whatever corner the folder happened to be dragged to — which for the
         600px-wide games meant most of the game hanging off the right edge.

         `offsetWidth` is the guard, and it is not "am I hidden": a window can
         also have no box because it is closed or minimised, and centring
         against 0x0 would move it somewhere arbitrary for the next time it
         opens. Nothing needs clamping in that case either, so nothing happens. */
      // Spelled out rather than `size()`: `size` is the event's detail in here,
      // and the helper of that name is shadowed.
      if (win.offsetWidth)
        move(initialPosition({ w: win.offsetWidth, h: win.offsetHeight }, desk()));
    });

    // Pressing anywhere in the window brings it to the front, like in Windows.
    // On capture so it lands before the buttons inside.
    win.addEventListener("pointerdown", () => toFront(), true);

    // ── Dragging ──────────────────────────────────────────────────────────
    // Pointers and not mouse: the same code covers finger and stylus. The
    // capture is what stops a fast drag getting lost when the cursor outruns
    // the window.
    let from: { px: number; py: number; x: number; y: number } | null = null;

    titlebar.addEventListener("pointerdown", (e) => {
      const onButton = (e.target as HTMLElement).closest(".xp-winbtn");
      if (onButton || win.classList.contains("is-max") || !DESKTOP.matches) return;
      from = { px: e.clientX, py: e.clientY, x: px("--x"), y: px("--y") };
      titlebar.setPointerCapture(e.pointerId);
    });

    titlebar.addEventListener("pointermove", (e) => {
      if (!from) return;
      e.preventDefault();
      move(
        clampPosition(
          { ...size(), x: from.x + (e.clientX - from.px), y: from.y + (e.clientY - from.py) },
          desk(),
        ),
      );
    });

    const endDrag = () => {
      from = null;
    };
    titlebar.addEventListener("pointerup", endDrag);
    titlebar.addEventListener("pointercancel", endDrag);

    // When the screen is resized the window can end up outside.
    addEventListener("resize", () => {
      if (DESKTOP.matches && win.dataset.open === "true") reclamp();
    });

    /** The row if this window is in one and it fits; the cascade otherwise. */
    const placement = (index: number) =>
      placeRow(win) ?? cascadePosition(index, size(), desk());

    // ── Start-up ──────────────────────────────────────────────────────────
    /**
     * Gives the window the furniture the desktop needs: a taskbar button and a
     * position. Runs at most once — the connected button is the record that it
     * has — so calling it on a window already on the desktop cannot move one
     * the visitor has dragged somewhere.
     *
     * Not folded into `enterDesktop`, because a window that starts CLOSED never
     * goes through it: `xp:show` is that window's first appearance, and without
     * this it would arrive with no taskbar button at all — and the taskbar
     * button is the only way to bring a window back once it is closed.
     */
    const ensurePlaced = () => {
      if (!DESKTOP.matches || task.isConnected) return;
      // Counted BEFORE appending, as phase 2 did: it is the cascade's index,
      // and it has to be different for each window. Counting open windows
      // instead would give every one of them the same number at start-up,
      // because they are all already `data-open="true"` in the HTML, and the
      // cascade would stack them on one spot.
      const alreadyPlaced = tasks?.children.length ?? 0;
      tasks?.appendChild(task);
      move(placement(alreadyPlaced));
    };

    /** Puts an open window on the desktop and brings it to the front. */
    const enterDesktop = () => {
      if (win.dataset.open !== "true" || !DESKTOP.matches || task.isConnected) return;
      ensurePlaced();
      toFront();
    };

    /**
     * Undoes it. Everything `enterDesktop` puts on the window is desktop-only
     * furniture, and its CSS lives inside the desktop media query, so leaving
     * the mode with any of it still set strands the state: a taskbar button
     * that survives into the stacked column toggles `.is-min`, whose
     * `display: none` no longer applies — the button appears to do nothing, and
     * the window disappears the next time the viewport grows.
     *
     * `is-front` has to go too, not only for the dimmed title bar: `toFront()`
     * returns early when it is already set, so a window that kept it would
     * re-enter the desktop with no z-index and no active taskbar button.
     */
    const leaveDesktop = () => {
      task.remove();
      task.classList.remove("xp-task-active");
      win.dataset.open = "true";
      win.classList.remove("is-min", "is-front");
      btnMin.setAttribute("aria-pressed", "false");
    };

    enterDesktop();
    // Also when the viewport crosses DESKTOP_MIN_WIDTH after load — a rotated
    // phone, a resized window. Without the entering half the desktop turns on
    // with an empty taskbar, and since the taskbar is the only way back to a
    // closed window, closing one would be irreversible.
    DESKTOP.addEventListener("change", () => (DESKTOP.matches ? enterDesktop() : leaveDesktop()));
  });

  /**
   * The arrival happens once, and the marker that ends it has to be anchored to
   * the animation and not to a clock. The animation starts when `Boot.astro`
   * removes `data-boot`, which on a first visit is whenever the visitor presses
   * a key — `AUTO_MS` is 0, so the boot screen waits as long as it takes. A
   * timer started at page load fires long before that and switches the arrival
   * off before it ever runs.
   *
   * Only the windows that are open at start-up are counted: a window that is
   * `display: none` runs no animation, so waiting for one from it would wait
   * for ever.
   *
   * Why the marker exists at all: taking an element out of `display: none`
   * RESTARTS every animation named on it, so without this a window the visitor
   * just reopened would sit invisible for the whole delay before fading in.
   * Removing the rule afterwards is not visible — the animation's `to` state is
   * the window's natural state.
   */
  const arriving = [...document.querySelectorAll<HTMLElement>('.xp-window[data-open="true"]')];
  let pending = arriving.length;
  const arrived = () => document.documentElement.classList.add("xp-arrived");
  // Nothing to wait for: no window is open, or the visitor asked for no motion
  // and the rule that would animate does not exist. The `reduce` case matters
  // because the preference can be turned OFF mid-session — the rule starts
  // matching then, and without the marker all three windows replay the 900ms
  // entrance in the middle of a visit.
  if (!pending || matchMedia("(prefers-reduced-motion: reduce)").matches) arrived();
  for (const w of arriving) {
    const onEnd = (e: AnimationEvent) => {
      if (e.animationName !== "xp-window-enter") return;
      w.removeEventListener("animationend", onEnd);
      w.removeEventListener("animationcancel", onEnd);
      if (pending > 0 && --pending === 0) arrived();
    };
    // `animationcancel` too: taking a window to `display: none` — minimising it
    // mid-arrival, which its taskbar button already allows — cancels the
    // animation and fires only this. Counting just `animationend` leaves the
    // marker off for ever and every later reopen replays the entrance.
    w.addEventListener("animationend", onEnd);
    w.addEventListener("animationcancel", onEnd);
  }

  /**
   * Where a window goes when it first appears.
   *
   * Row windows are laid out together: each one reads every `[data-row]` window
   * in DOM order, computes the whole row and takes its own slot. Doing the same
   * arithmetic three times is cheaper than a shared layout pass and keeps each
   * window's script self-contained.
   */
  function placeRow(win: HTMLElement): { x: number; y: number } | null {
    const row = [...document.querySelectorAll<HTMLElement>('.xp-window[data-row="true"]')];
    const index = row.indexOf(win);
    if (index < 0) return null;
    // The authored --w/--h and not offsetWidth/offsetHeight: those are correct
    // even while the window is display:none or mid-animation, and they are the
    // exact numbers index.astro measured against when it computed the
    // build-time row.
    const sizes = row.map((w) => ({
      w: parseFloat(getComputedStyle(w).getPropertyValue("--w")) || w.offsetWidth,
      h: parseFloat(getComputedStyle(w).getPropertyValue("--h")) || w.offsetHeight,
    }));
    const positions = rowPositions(sizes, {
      vw: innerWidth,
      vh: innerHeight,
      barH: barHeight(),
    });
    return positions ? positions[index] : null;
  }
</script>

<style>
  /* ══ STACKED MODE — the base ══════════════════════════════════════════════
     Phone and no-JavaScript. In a column, all visible, the page scrolls. */
  .xp-window {
    position: relative;
    box-sizing: border-box;
    width: min(100%, var(--w));
    margin: 0 auto 14px;
    display: flex;
    flex-direction: column;
    /* Where the arrival animation scales FROM: the bottom edge, like a window
       rising off the taskbar, not the centre. */
    transform-origin: 50% 100%;
    /* The Luna frame: 3px of blue at the sides and the bottom, rounded corners
       at the top and square ones at the bottom. */
    background: #0831d9;
    border-radius: 8px 8px 0 0;
    padding: 0 3px 3px;
    box-shadow: 2px 3px 12px rgba(0, 0, 0, 0.45);
    font-family: Tahoma, "DejaVu Sans", Verdana, sans-serif;
  }
  /* No focus ring of its own: it is a container with tabindex="-1" that the
     script focuses on open, not something you tab to. */
  .xp-window:focus {
    outline: none;
  }

  /* ── The title bar ────────────────────────────────────────────────────── */
  .xp-titlebar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    padding: 0 3px 0 5px;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(
      to bottom,
      #0997ff 0,
      #0053ee 8%,
      #0050ee 40%,
      #0066ff 88%,
      #005bff 95%,
      #003dd7 96%,
      #003dd7 100%
    );
  }
  .xp-titleicon {
    height: 16px;
    width: auto;
    display: block;
  }
  .xp-titletext {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #ffffff;
    font: bold 13px/1 Tahoma, "DejaVu Sans", Verdana, sans-serif;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.5);
  }

  /* Hidden when stacked: minimise, maximise and close mean nothing in a column,
     and a button that does nothing is worse than no button. */
  .xp-winbtns {
    display: none;
    flex: none;
    gap: 2px;
  }
  .xp-winbtn {
    width: 21px;
    height: 21px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 3px;
    background: linear-gradient(to bottom, #2f8ef5 0, #1b60d8 50%, #0a44b5 100%);
    color: #ffffff;
    font-size: 12px;
    line-height: 1;
    cursor: default;
  }
  .xp-close {
    background: linear-gradient(to bottom, #f18f6a 0, #d9542a 45%, #b32d13 100%);
  }
  .xp-winbtn:hover {
    filter: brightness(1.18);
  }
  .xp-winbtn:active {
    filter: brightness(0.85);
  }
  .xp-winbtn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: -3px;
  }

  /* ── The body ─────────────────────────────────────────────────────────── */
  .xp-winbody {
    flex: 1 1 auto;
    min-height: 0;
    background: #ece9d8;
    color: #000000;
    padding: 18px 22px 24px;
    font-size: 14px;
    line-height: 1.55;
  }
  /* 22px of padding inside a 200px window leaves 156px of content. The Menu and
     the Contact card ask for this; the reading pane does not. */
  .xp-window[data-tight] .xp-winbody {
    padding: 8px;
  }
  /* An application window, as opposed to a document one: the thing inside runs
     edge to edge. Windows never put a margin around a Minesweeper board. */
  .xp-window.is-app .xp-winbody {
    padding: 0;
  }

  /* ══ DESKTOP MODE — the enhancement ═══════════════════════════════════════
     `html.js` is set by an inline script in the layout. Without JavaScript this
     media query never applies, on any screen, and everything stays stacked.

     1270 = 200 + 750 + 240 (the three windows) + 2×24 (ROW_GAP) + 2×16
     (ROW_MARGIN). It is `DESKTOP_MIN_WIDTH` in `windows.mjs`, written out here
     because a media query cannot read a JS constant; the script reads the
     constant, and `windows.test.mjs` pins the invariant so the two cannot
     drift. Desktop mode means "the row fits": narrower than this the three
     windows would have to cascade, which buries the Menu and Contact inside
     the reading pane. */
  @media (min-width: 1270px) {
    :global(html.js) .xp-window {
      position: absolute;
      top: var(--y);
      left: var(--x);
      z-index: 5;
      width: var(--w);
      margin: 0;
      /* Never wider than the screen nor taller than the well above the taskbar:
         on a small screen the window shrinks instead of falling off. */
      max-width: calc(100vw - 16px);
      height: var(--h);
      max-height: calc(100dvh - var(--bar-h, 40px) - 16px);
    }
    :global(html.js) .xp-window[data-open="false"],
    :global(html.js) .xp-window.is-min {
      display: none;
    }
    :global(html.js) .xp-titlebar {
      /* The title bar is the handle: a text cursor here is wrong.
         `touch-action: none` is what allows dragging with a finger without the
         browser stealing the gesture — and that is exactly why it CANNOT be in
         stacked mode, where dragging the bar has to scroll the page. */
      cursor: default;
      user-select: none;
      touch-action: none;
    }
    /* The window that is not in front wears a dimmed title bar. It is how you
       tell the active one apart in Windows, and with three side by side you
       need it.
       A filter and not a second gradient: there is no capture of the inactive
       bar to measure, and approximating twice is worse than approximating
       once. */
    :global(html.js) .xp-window:not(.is-front) .xp-titlebar {
      filter: saturate(0.4) brightness(0.92);
    }
    :global(html.js) .xp-winbtns {
      display: flex;
    }
    :global(html.js) .xp-winbody {
      /* Here it is the window that scrolls, not the page: the desktop has no
         scroll. The scrollbar is tinted by hand, and like the rest of this
         window's colours it is approximation and not measurement: the XP one is
         a relief drawing that `scrollbar-color` cannot do. */
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-color: #a7bdd9 #f1efe2;
    }
    :global(html.js) .xp-window.is-max {
      top: 0;
      left: 0;
      width: 100vw;
      max-width: 100vw;
      height: calc(100dvh - var(--bar-h, 40px));
      max-height: none;
      border-radius: 0;
      padding-left: 0;
      padding-right: 0;
    }
    :global(html.js) .xp-window.is-max .xp-titlebar {
      border-radius: 0;
    }
  }

  /* ── The arrival ──────────────────────────────────────────────────────── */
  /* `html:not([data-boot])` is the entire trick, and it is why this is an
     animation now and was a transition in phase 2.

     A CSS animation starts when the element FIRST MATCHES the rule. While the
     boot screen is up the rule does not match, so nothing is running; the
     moment `Boot.astro` removes the attribute the element starts matching and
     the delay is counted from THERE. That is what phase 2 could not do with
     @keyframes — an animation with a delay counts from page load, so it would
     have played behind the boot screen — and it is what a transition could not
     do either, because a returning visitor gets no boot screen and therefore no
     attribute change to transition off. Now both visits get the same sequence.

     `both` fill: before the delay the window holds the `from` state, so it is
     invisible while the script re-lays it against the real viewport, and the
     correction is never seen.

     `.xp-arrived` and `html.js`: taking an element out of `display: none`
     RESTARTS every animation named on it, so without a way to stop matching
     the rule, closing and reopening (or minimising and restoring) a window
     would replay the whole entrance and hold it at opacity 0 for the delay
     again. The script adds `.xp-arrived` once the sequence is over, and from
     then on the rule stops applying — nothing moves when it does, because the
     animation's `to` state is already the window's natural, un-animated one.
     `html.js` is not decoration either: without it, a no-JS visitor — who
     never gets `.xp-arrived` — would sit through a delay the animation exists
     to hide a script re-laying, which they have no script to run.

     This fails open in every direction that is under this rule's own control:
     there is no base `opacity: 0` for a failed script to undo, the hiding is
     the animation's own backwards fill plus one rule that only applies while
     the boot screen is on top, and under reduced motion neither rule exists so
     every window is simply visible. The one thing it depends on outside itself
     is `Boot.astro` removing `data-boot` — phase 1 and 2 had the same
     dependency, and `Boot.astro` installs its exit listeners before anything
     that can throw, precisely so that removal is guaranteed. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-boot]) .xp-window {
      opacity: 0;
    }
    :global(html.js:not([data-boot]):not(.xp-arrived)) .xp-window {
      animation: xp-window-enter 260ms cubic-bezier(0.16, 1, 0.3, 1) var(--enter-delay, 900ms)
        both;
    }
    @keyframes xp-window-enter {
      from {
        opacity: 0;
        transform: scale(0.92) translateY(12px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
