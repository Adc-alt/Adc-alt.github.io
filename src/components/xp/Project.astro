---
/**
 * A whole project, inside its window. This is what used to be
 * `/proyectos/<id>/`.
 */
import { render, type CollectionEntry } from "astro:content";
import { STATUS, sectionId } from "./sections.mjs";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, stack, year, status, repo, demo } = project.data;
---

<div class="xp-doc">
  {/* A real anchor, like every other bit of navigation here: with JavaScript the
      switcher takes it, without it the page jumps to the Projects section,
      which is visible. */}
  <p class="note back"><a href={`#${sectionId("projects")}`}>← Projects</a></p>
  <h1>{title}</h1>
  <p class="lede">{summary}</p>

  <dl class="card">
    <div>
      <dt>Year</dt>
      <dd>{year}</dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd>{STATUS[status]}</dd>
    </div>
    <div>
      <dt>Stack</dt>
      <dd>{stack.join(" · ")}</dd>
    </div>
  </dl>

  {
    (repo || demo) && (
      <p class="row">
        {demo && (
          <a href={demo} rel="noopener">
            See it live
          </a>
        )}
        {repo && (
          <a href={repo} rel="noopener">
            Repository
          </a>
        )}
      </p>
    )
  }

  <hr />

  <Content />
</div>
