---
/**
 * Klondike, and not mine either.
 *
 * WHAT CHANGED. This used to be a game written for this site: a pack of cards,
 * a drag, and every rule of Klondike in `solitaire.mjs`. The owner asked for it
 * to come from somewhere else, the way the pinball table does, so all of that
 * is gone and what is left is the frame around somebody else's game.
 *
 * It is jhatzimalis' single-file Solitaire, MIT, on GitHub Pages. Chosen over
 * the better-known solitaire sites for one reason: they open with a consent
 * dialog listing a couple of hundred advertising partners, and framing one
 * would hand every one of them a visitor who came to a site whose colophon
 * promises no analytics and no cookies. This one has no ads and no trackers,
 * and GitHub Pages sends no `x-frame-options`, so it can be framed at all.
 *
 * It does NOT load on its own, for the same reason the table does not: a frame
 * built on page load would call their server for everybody who so much as
 * glances at this page.
 *
 * ⚠️ The load/unload dance below is deliberately the same shape as the one in
 * `Pinball.astro` rather than a shared component. Two are not a pattern; when a
 * third framed game turns up, that is the time to pull it out.
 */
import MenuBar, { type Menu } from "./MenuBar.astro";
import AboutBox from "./AboutBox.astro";

const SRC = "https://jhatzimalis.github.io/solitaire/";

/* XP's Game menu. Undo, Deck and Options are drawn disabled rather than
   dropped, the same way Minesweeper's are: an item you cannot use still tells
   you it exists. They are also the three that CANNOT work from here — the game
   is a document from another origin, and there is no reaching into one. */
const MENUS: Menu[] = [
  {
    label: "Game",
    items: [
      { label: "Deal", cmd: "deal", key: "F2" },
      { sep: true },
      { label: "Undo", disabled: true },
      { label: "Deck...", disabled: true },
      { label: "Options...", disabled: true },
      { sep: true },
      { label: "Exit", cmd: "exit" },
    ],
  },
  {
    label: "Help",
    items: [
      { label: "Contents", disabled: true },
      { sep: true },
      { label: "About Solitaire", cmd: "about" },
    ],
  },
];
---

<div class="sol">
  <MenuBar id="sol-menu" menus={MENUS} />

  <div class="sol-stage">
    {/* The URL rides on the button rather than in the script: the script is
        bundled and shared, the markup is where this component's own data goes. */}
    <button type="button" class="sol-play" data-src={SRC}>
      <span class="sol-play-icon" aria-hidden="true">▶</span>
      <span>Deal</span>
      <span class="sol-play-note">Loads the game from GitHub Pages</span>
    </button>
  </div>

  <AboutBox id="sol-about" title="About Solitaire">
    <p>
      Klondike. Build the four piles at the top up from the ace in one suit, and
      the columns down in alternating colours. Click inside the frame first, or
      the keys go to this page instead.
    </p>
    <p>
      <strong>The game is not mine.</strong> It is <a
        href="https://github.com/jhatzimalis/solitaire" rel="noopener">jhatzimalis'
      Solitaire</a>, MIT, loaded from their GitHub Pages site. There is no copy
      of it in this repository, and nothing is asked of them until you press
      Deal.
    </p>
    <p>
      <em>Game → Deal</em> loads it again from the start, because a new deal is
      the only thing this side can ask of it: the rest of this menu belongs to a
      document from another origin, which is why the rest of this menu is grey.
    </p>
  </AboutBox>
</div>

<script>
  const root = document.querySelector<HTMLElement>(".sol");
  const stage = root?.querySelector<HTMLElement>(".sol-stage");
  const button = stage?.querySelector<HTMLButtonElement>(".sol-play");

  if (root && stage && button) {
    /* Every deal is a fresh load, so the URL has to be a different one each
       time: assigning the same one back is not reliably a navigation, and a
       fragment never is. GitHub Pages ignores the query. */
    let deals = 0;

    const deal = () => {
      const frame =
        stage.querySelector("iframe") ?? document.createElement("iframe");
      frame.src = `${button.dataset.src}?deal=${++deals}`;
      frame.title = "Solitaire";
      frame.className = "sol-frame";
      stage.replaceChildren(frame);
      frame.focus();
    };

    /**
     * Throws the frame away and puts the button back.
     *
     * Not housekeeping: a cross-origin frame keeps RUNNING when it is merely
     * hidden, and the only thing this side can do to a document it is not
     * allowed to touch is stop it existing.
     */
    const unload = () => {
      if (!stage.querySelector("iframe")) return;
      // The button was taken out of the DOM by `deal`, not destroyed: it is the
      // same element, listener and all, going back where it was.
      stage.replaceChildren(button);
    };

    button.addEventListener("click", deal);
    root.addEventListener("xpmenu", (e) => {
      const cmd = (e as CustomEvent<string>).detail;
      if (cmd === "deal") deal();
      else if (cmd === "about") root.querySelector<HTMLDialogElement>("#sol-about")?.showModal();
      // "exit" is not handled here: the window this lives in owns it.
    });

    /* The menu prints F2, so F2 has to work. `offsetWidth` is the guard and it
       is deliberately not "is my panel hidden": the game can also be off screen
       because the Games window was closed or minimised, and an unrendered
       element measures 0 in every one of those cases. */
    addEventListener("keydown", (e) => {
      if (e.key !== "F2" || !stage.offsetWidth) return;
      e.preventDefault();
      deal();
    });

    /* The one hook that catches every way this game can leave the screen: Game
       → Exit, opening a different game, closing the window, minimising it. All
       four end in `display: none` somewhere up the tree, and the only thing
       they have in common is that the stage stops having a box. */
    new ResizeObserver(([entry]) => {
      const box = entry?.contentRect;
      if (box && box.width === 0 && box.height === 0) unload();
    }).observe(stage);

    // Whoever owns the window listens for this and fits the window to the game.
    root.dispatchEvent(new CustomEvent("xp:fit", { bubbles: true }));
  }
</script>

<style>
  /* Menu bar on top, frame under it: the two parts of the window. */
  .sol {
    display: flex;
    flex-direction: column;

    /* How big the window opens. The game inside is responsive and lays itself
       out to whatever it is given, so this is a choice rather than a
       constraint; it is roughly the size XP opened Solitaire at. */
    --sol-w: 690;
    --sol-h: 480;
  }
  /* The frame IS the client area: the window is sized to this, so no margin. A
     fixed width rather than a percentage because the panel around it is sized
     by its content, and a percentage of a max-content box has nothing to
     resolve against. */
  .sol-stage {
    position: relative;
    width: calc(var(--sol-w) * 1px);
    max-width: 100%;
    aspect-ratio: var(--sol-w) / var(--sol-h);
    background: #0a5c2e;
  }

  .sol-play {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    background: none;
    border: 0;
    color: #ffffff;
    font: inherit;
    cursor: default;
  }
  .sol-play-icon {
    font-size: 2.4rem;
    line-height: 1;
  }
  .sol-play-note {
    font-size: 0.75rem;
    color: #b6d8c2;
  }
  .sol-play:hover .sol-play-icon {
    color: #ffc83d;
  }
  .sol-play:focus-visible {
    outline: 2px solid #ffc83d;
    outline-offset: -4px;
  }

  /* Created by the script, so it carries no scope attribute of its own. */
  .sol-stage :global(.sol-frame) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
