---
/**
 * The project index, one section of the reading pane. Each title opens that
 * project in the same pane, which is rendered at build time just like this one
 * (phase 1 §13: the content is not generated by JavaScript).
 *
 * The section id is composed by `projectSectionId()` in one single place,
 * because `Sections.astro` mints it and this file links it: if the two drift
 * apart the link stops showing anything and the build does not fail.
 */
import { getCollection } from "astro:content";
import { STATUS, projectSectionId } from "./sections.mjs";

const projects = (
  await getCollection("projects", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
---

<div class="xp-doc">
  <h1>Projects</h1>

  <p class="lede">
    Things I have built: what problem they solved and how they work inside. Each
    title opens here, in this pane, with a way back to this list.
  </p>

  <hr />

  <ul class="index">
    {
      projects.map((p) => (
        <li>
          {p.data.cover && (
            /* aria-hidden and out of the tab order on purpose: it goes to the
               same place as the title two lines down, and a second link to the
               same section is a second stop for a screen reader and for the
               keyboard with nothing new at the end of it. The picture is worth
               having for the eye and worth skipping for everyone else, which
               is also why its alt is empty. */
            <a
              class="cover"
              href={`#${projectSectionId(p.id)}`}
              aria-hidden="true"
              tabindex="-1"
            >
              <img src={p.data.cover} alt="" width="480" height="360" loading="lazy" decoding="async" />
            </a>
          )}
          <div class="entry">
            <h2>
              <a href={`#${projectSectionId(p.id)}`}>{p.data.title}</a>
            </h2>
            <p class="note">
              {p.data.year} · {STATUS[p.data.status]} · {p.data.stack.join(" · ")}
            </p>
            <p>{p.data.summary}</p>
          </div>
        </li>
      ))
    }
  </ul>
</div>
