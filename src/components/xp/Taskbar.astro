---
/**
 * The Windows XP taskbar, Luna theme.
 *
 * The colours are NOT decided here: they are measured off screenshots and the
 * whole derivation lives in ./taskbar-colors.mjs, with a test. If something
 * here looks like an odd colour, look there before changing it.
 *
 *   Measurements and reasons → docs/superpowers/specs/2026-08-15-xp-desktop-phase1-design.md §4, §7
 *
 * The gradient is injected via `style` instead of being written in the <style>
 * block because a CSS block cannot read the module: this way the CSS and the
 * test look at exactly the same list of stops.
 */
import {
  gradient,
  hex,
  HEIGHT,
  START_BODY,
  START_EDGE,
  startHighlight,
  TRAY_BODY,
  TRAY_FOOT,
  TRAY_EDGE,
} from "./taskbar-colors.mjs";
import StartMenu from "./StartMenu.astro";

const bar = gradient();
// The first two rows are the measured light band (§4.2) and are given in px,
// not %, because they are a pixel detail: if the bar changes height, the
// highlight has to keep measuring the same. The rest is in % and stretches.
const startBg = `linear-gradient(to bottom, ${hex(startHighlight())} 0, ${hex(startHighlight())} 3px, ${hex(START_BODY)} 10px, ${hex(START_BODY)} 72%, ${hex(START_EDGE)} 100%)`;
const startBgDown = `linear-gradient(to bottom, ${hex(START_EDGE)} 0, ${hex(START_EDGE)} 45%, ${hex(START_BODY)} 100%)`;
const trayBg = `linear-gradient(to bottom, ${hex(TRAY_BODY)} 0, ${hex(TRAY_BODY)} 90%, ${hex(TRAY_FOOT)} 100%)`;
const trayEdge = hex(TRAY_EDGE);
---

<div
  class="xp-taskbar"
  style={`--bar:${bar};--bar-h:${HEIGHT}px;--start-bg:${startBg};--start-down:${startBgDown};--tray-bg:${trayBg};--tray-edge:${trayEdge}`}
>
  {/* A real <button> and not a <div>: focusable with a keyboard and announced
      by a screen reader. It opens the Start menu, which is a picture — see
      StartMenu.astro for why the panel itself is aria-hidden and this is not. */}
  <button class="xp-start" type="button" aria-expanded="false" aria-controls="xp-startmenu">
    {/* The flag is decoration: the button's accessible name is already "start",
        so the empty alt stops a reader saying the same thing twice. */}
    <img class="xp-flag" src="/xp/win-flag.png" width="52" height="48" alt="" />
    start
  </button>

  {/* The window area. Empty in the HTML: the buttons are created by the script
      in Window.astro on start-up, because a button that restores a minimised
      window makes no sense if there is no JavaScript to minimise it. */}
  <div class="xp-tasks"></div>

  <div class="xp-tray">
    {/* Hidden in the HTML and revealed by the script, like the clock next to it:
        with no JavaScript nothing makes a sound, so a mute button would be a
        control over something that cannot happen. */}
    <button class="xp-mute" type="button" aria-pressed="false" hidden>
      <span class="xp-sr">Mute the click</span>
      <svg viewBox="0 0 16 16" width="16" height="16" role="presentation">
        <path d="M1.5 6h2.6L7.5 3v10L4.1 10H1.5z" fill="currentColor"></path>
        {/* Both drawn, and the CSS shows one: the waves when the sound is on,
            the cross when it is off. */}
        <g class="xp-wave" fill="none" stroke="currentColor" stroke-width="1.3">
          <path d="M9.6 5.4a3.6 3.6 0 0 1 0 5.2"></path>
          <path d="M11.7 3.6a6.4 6.4 0 0 1 0 8.8"></path>
        </g>
        <g class="xp-cross" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M10 6l4 4M14 6l-4 4"></path>
        </g>
      </svg>
    </button>

    {/* No `datetime` in the built HTML: the clock is the VISITOR's time, not the
        build server's. The script fills it in on start-up. */}
    <time class="xp-clock" id="xp-clock"></time>
  </div>
</div>

<StartMenu />

<script>
  import { formatTime, msToNextMinute } from "./clock.mjs";
  import { DESKTOP_MIN_WIDTH } from "./windows.mjs";

  /* Windows' own navigation click, 64ms, converted to mono 22kHz — 2.9kB, small
     enough that it is not worth an encoder. It is Microsoft's sound, like the
     wallpaper and the flag already in /xp/. */
  const CLICK_SRC = "/xp/click.wav";
  const MUTE_KEY = "xp_muted";

  const el = document.getElementById("xp-clock");
  if (el) {
    const tick = () => {
      const now = new Date();
      el.textContent = formatTime(now);
      // The text is local and the `datetime` is ISO/UTC: the two name the same
      // instant, so a screen reader gets it exactly right without depending on
      // reading the contrast of the tray (§10.1).
      el.setAttribute("datetime", now.toISOString());
      setTimeout(tick, msToNextMinute(now));
    };
    tick();
  }

  // ── The click ─────────────────────────────────────────────────────────────
  // Same query as Window.astro's, from the same constant: the sound belongs to
  // the desktop, and in stacked mode there is no desktop to click on.
  const DESKTOP = matchMedia(`(min-width: ${DESKTOP_MIN_WIDTH}px)`);

  const audio = new Audio(CLICK_SRC);
  audio.preload = "auto";

  // localStorage throws in some privacy modes and the whole bar would die with
  // it. Same guard as the boot screen's.
  const store = (fn: (s: Storage) => void) => {
    try {
      fn(localStorage);
    } catch {
      /* private mode: the setting just does not survive the tab */
    }
  };

  let muted = false;
  store((s) => {
    muted = s.getItem(MUTE_KEY) === "1";
  });

  const mute = document.querySelector<HTMLButtonElement>(".xp-mute");

  const paintMute = () => {
    mute?.setAttribute("aria-pressed", String(muted));
    mute?.classList.toggle("is-muted", muted);
  };

  /** The button only exists where the sound does. */
  const showMute = () => {
    if (mute) mute.hidden = !DESKTOP.matches;
  };
  paintMute();
  showMute();
  DESKTOP.addEventListener("change", showMute);

  mute?.addEventListener("click", () => {
    muted = !muted;
    store((s) => s.setItem(MUTE_KEY, muted ? "1" : "0"));
    paintMute();
    // Unmuting plays the click, muting does not: the sound is the confirmation
    // that it is back, and there is nothing to confirm about silence.
    if (!muted) play();
  });

  function play() {
    if (muted || !DESKTOP.matches) return;
    audio.currentTime = 0;
    // Rejects until the browser has seen a gesture, and there is nothing to do
    // about that or to report: the first click is the gesture.
    audio.play().catch(() => {});
  }

  // One delegated listener instead of one per window: `pointerdown` on capture
  // so it fires before anything inside can stop it, and before the window's own
  // handlers move things around.
  addEventListener(
    "pointerdown",
    (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      // The mute button is handled above, on click, and would otherwise beep on
      // the way down while you are silencing it.
      if (t.closest(".xp-mute")) return;
      if (t.closest(".xp-window, .xp-taskbar")) play();
    },
    true,
  );

  // ── The Start menu ────────────────────────────────────────────────────────
  const start = document.querySelector<HTMLButtonElement>(".xp-start");
  const menu = document.getElementById("xp-startmenu");

  const setMenu = (open: boolean) => {
    if (!menu || !start) return;
    menu.hidden = !open;
    start.setAttribute("aria-expanded", String(open));
    start.classList.toggle("is-open", open);
  };

  start?.addEventListener("click", () => {
    // Stacked mode keeps the Start button depressing and opening nothing, which
    // is what it did before this existed: a 400px-wide panel of things you
    // cannot click would cover the page it is sitting on.
    if (!DESKTOP.matches) return;
    setMenu(menu?.hidden ?? false);
  });

  // Anywhere else closes it, like XP. On capture and on the document so it also
  // catches a click inside a window, which stops propagation for its own
  // reasons.
  addEventListener(
    "pointerdown",
    (e) => {
      if (menu?.hidden) return;
      const t = e.target;
      if (t instanceof Element && (t.closest(".xp-startmenu") || t.closest(".xp-start"))) return;
      setMenu(false);
    },
    true,
  );

  addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || menu?.hidden) return;
    setMenu(false);
    start?.focus();
  });

  // Stacked mode has no desktop for the menu to sit on, and at 400px it would
  // cover the page. The button stops announcing itself as collapsed there too:
  // `aria-expanded` on a control that cannot expand tells a screen reader there
  // is something to open.
  const syncStart = () => {
    if (!start) return;
    if (DESKTOP.matches) start.setAttribute("aria-expanded", String(!menu?.hidden));
    else {
      setMenu(false);
      start.removeAttribute("aria-expanded");
    }
  };
  syncStart();
  DESKTOP.addEventListener("change", syncStart);
</script>

<style>
  .xp-taskbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    /* HEIGHT from taskbar-colors.mjs, via a variable (--bar-h): 14-15 rows in a
       capture downscaled 2:1, and XP's own default at 96 dpi (§4.2). The --bar
       gradient derives from that same number, so the two cannot drift apart. */
    height: var(--bar-h);
    z-index: 10;
    display: flex;
    align-items: stretch;
    background: var(--bar);
    /* Tahoma is XP's. No font is served: if the visitor does not have it, they
       fall back to the closest thing they do have. */
    font-family: Tahoma, "DejaVu Sans", Verdana, sans-serif;
    /* You do not text-select a desktop. */
    user-select: none;
  }

  /* ── The Start button ────────────────────────────────────────────────────
     Flush with the bar, top and bottom. The native 1920x1080 capture reads it
     at 97x30 on a bar of 30 — that is, no margin; the earlier 94x28 came from
     the other capture (§4.2) and left 1px of blue above and below that XP does
     not have. With the bar at 40 it is settled in favour of the native capture.

     The width is no longer a number: the content sets it. With the flag inside,
     a fixed width means recalculating it every time the font or the icon is
     touched, and the result is the same ~105px button.

     The rounding on the right is NOT circular, and that is why `border-radius`
     comes in two groups: in that same capture the border moves 4px
     horizontally and takes about 10 rows to do it. The 8px circular value we
     started with did the opposite: a lot of bulge in very little height. */
  .xp-start {
    flex: none;
    align-self: stretch;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0 18px 2px 8px;
    border: 0;
    border-radius: 0 4px 4px 0 / 0 10px 10px 0;
    background: var(--start-bg);
    color: #ffffff;
    font: italic bold 19px/1 Tahoma, "DejaVu Sans", Verdana, sans-serif;
    text-align: left;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.45);
    /* Arrow cursor, not a hand: in Windows, buttons do not change the pointer. */
    cursor: default;
  }
  /* The flag is served at double size (52x48) and painted at half, so it does
     not come out blurry on a retina screen. `width: auto` keeps its
     proportions, which are not square. */
  .xp-flag {
    display: block;
    height: 26px;
    width: auto;
  }
  /* Pressed, and STAYS pressed while the menu is open: in XP the button is the
     menu's hinge, not a thing you tap. `.is-open` is set by the script. */
  .xp-start:active,
  .xp-start.is-open {
    background: var(--start-down);
    padding-top: 2px;
    padding-bottom: 0;
  }
  .xp-start:focus-visible {
    /* Inwards: an outline pointing outwards falls off the bottom of the bar. */
    outline: 2px solid #ffffff;
    outline-offset: -4px;
  }

  /* In stacked mode this stays empty: there, windows neither minimise nor close
     (Window.astro hides its three buttons), so its script creates no taskbar
     buttons. The gap is still there, which is what pushes the tray right. */
  .xp-tasks {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 0 4px 0 6px;
    overflow: hidden;
  }

  /* `:global` because these buttons are created by Window.astro's script and so
     do not carry this component's scope attribute. They are nested under
     `.xp-tasks`, which is ours, so the rule does not escape the bar. */
  .xp-tasks :global(.xp-task) {
    flex: 0 1 168px;
    min-width: 0;
    height: 30px;
    padding: 0 8px;
    border: 0;
    border-radius: 3px;
    /* Lighter than the bar and with a light inner edge at the top: it is a
       raised button. The active one below does exactly the opposite. */
    background: linear-gradient(to bottom, #4a91ef 0, #3a80e8 45%, #2c6fd8 100%);
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.35),
      inset -1px -1px 0 rgba(0, 0, 0, 0.2);
    color: #ffffff;
    font: 13px/1 Tahoma, "DejaVu Sans", Verdana, sans-serif;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
    cursor: default;
  }
  .xp-tasks :global(.xp-task-active) {
    /* Depressed: inverted gradient and an inner shadow. It is the state of the
       window that is open and in view. */
    background: linear-gradient(to bottom, #1f56b8 0, #2b6ad0 55%, #3f86e4 100%);
    box-shadow: inset 1px 1px 2px rgba(0, 0, 0, 0.45);
    font-weight: bold;
  }
  .xp-tasks :global(.xp-task:focus-visible) {
    outline: 2px solid #ffffff;
    outline-offset: -3px;
  }

  /* ── The tray ────────────────────────────────────────────────────────────
     133px: the 100 measured (§4.3, edge included) times the same 40/30 by which
     the bar has grown, so the proportion does not change. What makes it look
     sunken is the dark EDGE on the left, not the fill: the fill is LIGHTER than
     the bar and more cyan. Paint it darker, which is what instinct asks for,
     and it breaks.

     `box-sizing: border-box` because otherwise the 1px `border-left` adds to
     `width` and it comes out 101px: the measurement in §4.3 is the total width,
     not the inner well. */
  .xp-tray {
    flex: none;
    width: 133px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    /* The speaker sits to the LEFT of the clock, which is where XP put its tray
       icons. The gap comes out of the 133px rather than widening the tray: that
       width is measured (§4.3) and the clock is short enough to give it up. */
    gap: 8px;
    border-left: 1px solid var(--tray-edge);
    background: var(--tray-bg);
    color: #ffffff;
    font-size: 14px;
  }

  /* A tray icon, not a button with a body: no background, no border, and the
     arrow cursor Windows uses everywhere on the bar. */
  .xp-mute {
    flex: none;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    line-height: 0;
    cursor: default;
  }
  .xp-mute[hidden] {
    display: none;
  }
  .xp-mute:focus-visible {
    outline: 1px solid #ffffff;
    outline-offset: 2px;
  }
  /* One of the two groups drawn in the icon, never both. */
  .xp-mute .xp-cross,
  .xp-mute.is-muted .xp-wave {
    display: none;
  }
  .xp-mute.is-muted .xp-cross {
    display: inline;
  }
  /* The accessible name, off screen. The icon carries the meaning visually and
     `aria-pressed` carries the state. */
  .xp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .xp-clock {
    /* Without JS the tray stays empty, and that is acceptable: it is decoration,
       not content (§9). */
    letter-spacing: 0.02em;
  }

  /* ── The arrival ─────────────────────────────────────────────────────────
     Same mechanism as the windows and for the same reason: an animation that
     starts when the element first matches `html:not([data-boot])`, so it runs
     when the boot screen leaves on a first visit AND from the first paint on a
     repeat visit, which has no boot screen to leave. With phase 2's transition
     a returning visitor found the bar already in place and the "desktop, then
     the bar, then the windows" beat only existed once per browser.

     The 400ms delay is what sells the scene (phase 1 §8). Its total, 800ms, is
     `TASKBAR_ENTER_MS` in windows.mjs, which is what the window sequence is
     written against — change one and change the other. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-boot]) .xp-taskbar {
      transform: translateY(100%);
    }
    :global(html:not([data-boot])) .xp-taskbar {
      animation: xp-taskbar-enter 400ms cubic-bezier(0.16, 1, 0.3, 1) 400ms both;
    }
    @keyframes xp-taskbar-enter {
      from {
        transform: translateY(100%);
      }
      to {
        transform: translateY(0);
      }
    }
  }
</style>
