---
/**
 * The Contact window: the one pane whose content never changes.
 *
 * ⚠️ The colophon that used to close this window is gone at the owner's
 * request. Part of it was not decoration: the boot typeface is CC BY-SA 4.0 and
 * the credit is a licence obligation, not a courtesy. It has NOT been deleted,
 * only moved out of the visitor's way — the credit and the licence now travel
 * with the work itself, in the page's own source next to the `@font-face` that
 * loads it, in the README, and in the full licence shipped at
 * `/fonts/LICENSE-oldschool-pc-fonts.txt`. Deleting any of those three, while
 * the site still serves the font, would put it in breach. The only clean way to
 * carry no credit at all is to stop serving the font.
 */
import { SOCIAL } from "../../consts";
---

<div class="xp-doc">
  <ul class="xp-contact">
    {
      SOCIAL.map((s) => (
        <li>
          <a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>
            {s.label}
          </a>
          <span>{s.value}</span>
        </li>
      ))
    }
  </ul>

</div>

<style>
  .xp-contact {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xp-contact li {
    margin: 0 0 0.6rem;
  }
  .xp-contact span {
    display: block;
    font-size: 0.75rem;
    color: #6b675c;
    /* An address is one long unbreakable token in a 240px window. */
    overflow-wrap: anywhere;
  }
</style>
