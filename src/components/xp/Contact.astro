---
/**
 * The Contact window: the one pane whose content never changes.
 *
 * ⚠️ The colophon that used to close this window is gone at the owner's
 * request. Part of it was not decoration: the boot typeface is CC BY-SA 4.0 and
 * the credit is a licence obligation, not a courtesy. It has NOT been deleted,
 * only moved out of the visitor's way — the credit and the licence now travel
 * with the work itself, in the page's own source next to the `@font-face` that
 * loads it, in the README, and in the full licence shipped at
 * `/fonts/LICENSE-oldschool-pc-fonts.txt`. Deleting any of those three, while
 * the site still serves the font, would put it in breach. The only clean way to
 * carry no credit at all is to stop serving the font.
 */
import { SOCIAL } from "../../consts";

/**
 * The three marks, keyed by the `icon` of each entry in `SOCIAL`.
 *
 * Drawn here and not fetched: `contact.test.mjs` forbids an image tag and any
 * outside URL in this file, and it is right to. An icon set on a CDN is a
 * third party watching everyone who opens the page, and an icon set copied
 * into the repo is a licence to keep track of. That test reads the raw file,
 * comments included, so the tag cannot even be named in one.
 *
 * `box` per mark because they are not all drawn on the same grid, and
 * resampling a 16px drawing onto a 24px one is how a mark goes soft.
 *
 * The envelope is the same object as the one flying between the two computers
 * above, which is the point: `evenodd` is what cuts the flap out of the body
 * rather than drawing a second shape on top of it in a colour that would only
 * be right on this window's beige.
 */
type Mark = { box: string; d: string; rule?: "evenodd" };

const MARK: Record<string, Mark> = {
  mail: {
    box: "0 0 16 16",
    rule: "evenodd",
    d: "M0 3h16v10H0zM0 3.6 8 9.1 16 3.6V5.1L8 10.6 0 5.1z",
  },
  github: {
    box: "0 0 16 16",
    d: "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z",
  },
  linkedin: {
    box: "0 0 16 16",
    d: "M0.3 2.4a2 2 0 1 0 4 0 2 2 0 1 0-4 0zM0.3 5.6h4v10.1h-4zM6.2 15.7V5.6h3.6v1.2c.6-.9 1.5-1.4 2.7-1.4 1.9 0 3.3 1.3 3.3 3.8v6.5h-3.6V9.9c0-1-.5-1.6-1.3-1.6s-1.1.6-1.1 1.6v5.8z",
  },
};
---

<div class="xp-doc">
  {/* The two machines and the envelope are the reference sprite, pixel for
      pixel: read out of the GIF's frames and re-emitted as rects, one per run
      of identical pixels. Six colours, straight off a VGA palette. Rebuilt as
      vector rather than copied as a file so it stays sharp at any size, keeps
      its transparency over the window's beige, and can be stopped — a GIF
      ignores anyone who asked for less motion. */}
  <svg
    class="mailer"
    viewBox="0 0 100 32"
    width="100"
    height="32"
    shape-rendering="crispEdges"
    role="img"
    aria-label="Two computers sending an envelope back and forth"
  >
    <defs>
      <g id="pc">
        <rect y="16" width="5" height="1" fill="#000000"></rect>
        <rect y="17" width="1" height="11" fill="#000000"></rect>
        <rect x="1" y="28" width="1" height="1" fill="#000000"></rect>
        <rect x="2" y="29" width="1" height="1" fill="#000000"></rect>
        <rect x="3" y="30" width="1" height="1" fill="#000000"></rect>
        <rect x="4" y="1" width="1" height="15" fill="#000000"></rect>
        <rect x="4" y="31" width="27" height="1" fill="#000000"></rect>
        <rect x="5" width="19" height="1" fill="#000000"></rect>
        <rect x="5" y="17" width="1" height="1" fill="#000000"></rect>
        <rect x="6" y="18" width="1" height="1" fill="#000000"></rect>
        <rect x="7" y="19" width="19" height="1" fill="#000000"></rect>
        <rect x="9" y="5" width="16" height="1" fill="#000000"></rect>
        <rect x="9" y="6" width="1" height="11" fill="#000000"></rect>
        <rect x="9" y="17" width="16" height="1" fill="#000000"></rect>
        <rect x="24" y="1" width="1" height="1" fill="#000000"></rect>
        <rect x="24" y="6" width="1" height="11" fill="#000000"></rect>
        <rect x="25" y="2" width="1" height="1" fill="#000000"></rect>
        <rect x="26" y="3" width="1" height="15" fill="#000000"></rect>
        <rect x="26" y="18" width="2" height="1" fill="#000000"></rect>
        <rect x="28" y="19" width="1" height="1" fill="#000000"></rect>
        <rect x="29" y="20" width="1" height="1" fill="#000000"></rect>
        <rect x="30" y="21" width="1" height="10" fill="#000000"></rect>
        <rect x="2" y="17" width="3" height="1" fill="#bebebe"></rect>
        <rect x="3" y="18" width="3" height="1" fill="#bebebe"></rect>
        <rect x="4" y="19" width="3" height="1" fill="#bebebe"></rect>
        <rect x="5" y="20" width="24" height="1" fill="#bebebe"></rect>
        <rect x="5" y="22" width="25" height="1" fill="#bebebe"></rect>
        <rect x="5" y="23" width="21" height="2" fill="#bebebe"></rect>
        <rect x="5" y="25" width="25" height="6" fill="#bebebe"></rect>
        <rect x="6" y="1" width="18" height="1" fill="#bebebe"></rect>
        <rect x="7" y="2" width="18" height="1" fill="#bebebe"></rect>
        <rect x="8" y="4" width="18" height="1" fill="#bebebe"></rect>
        <rect x="8" y="5" width="1" height="13" fill="#bebebe"></rect>
        <rect x="8" y="18" width="18" height="1" fill="#bebebe"></rect>
        <rect x="25" y="5" width="1" height="13" fill="#bebebe"></rect>
        <rect x="26" y="19" width="2" height="1" fill="#bebebe"></rect>
        <rect x="28" y="23" width="2" height="2" fill="#bebebe"></rect>
        <rect x="1" y="18" width="1" height="1" fill="#7e7e7e"></rect>
        <rect x="1" y="19" width="2" height="1" fill="#7e7e7e"></rect>
        <rect x="1" y="20" width="3" height="1" fill="#7e7e7e"></rect>
        <rect x="1" y="21" width="4" height="7" fill="#7e7e7e"></rect>
        <rect x="2" y="28" width="3" height="1" fill="#7e7e7e"></rect>
        <rect x="3" y="29" width="2" height="1" fill="#7e7e7e"></rect>
        <rect x="4" y="30" width="1" height="1" fill="#7e7e7e"></rect>
        <rect x="5" y="2" width="1" height="1" fill="#7e7e7e"></rect>
        <rect x="5" y="3" width="2" height="14" fill="#7e7e7e"></rect>
        <rect x="6" y="17" width="1" height="1" fill="#7e7e7e"></rect>
        <rect x="1" y="17" width="1" height="1" fill="#ffffff"></rect>
        <rect x="2" y="18" width="1" height="1" fill="#ffffff"></rect>
        <rect x="3" y="19" width="1" height="1" fill="#ffffff"></rect>
        <rect x="4" y="20" width="1" height="1" fill="#ffffff"></rect>
        <rect x="5" y="1" width="1" height="1" fill="#ffffff"></rect>
        <rect x="5" y="21" width="25" height="1" fill="#ffffff"></rect>
        <rect x="6" y="2" width="1" height="1" fill="#ffffff"></rect>
        <rect x="7" y="3" width="19" height="1" fill="#ffffff"></rect>
        <rect x="7" y="4" width="1" height="15" fill="#ffffff"></rect>
        <rect x="10" y="6" width="14" height="11" fill="#047e7e"></rect>
        <rect x="26" y="23" width="2" height="2" fill="#7e0000"></rect>
      </g>
    </defs>
    {/* The envelope goes FIRST, before the two machines, and that order is the
        whole trick: painted afterwards, the machines cover it, so an envelope
        that slides to x=8 or x=75 is not "hidden", it is BEHIND the monitor.
        That is what makes it read as going into the computer and coming back
        out, rather than sliding past the front of it.

        For a monitor to hide it, the monitor has to be solid where the
        envelope passes. It is: between y=6 and y=16 the left machine paints an
        unbroken wall from x=7 (the white edge) to x=26 (the black one), screen
        included, and the right one is its mirror, x=73 to x=92.

        Two groups because a CSS transform and a `transform` attribute are the
        same property: the outer one puts the envelope at its drawing origin,
        the inner one is the only thing that animates. */}
    <g transform="translate(18 6)">
      <g class="envelope">
        <rect y="2" width="2" height="1" fill="#dbdb29"></rect>
        <rect y="3" width="3" height="1" fill="#dbdb29"></rect>
        <rect y="4" width="5" height="1" fill="#dbdb29"></rect>
        <rect y="5" width="7" height="2" fill="#dbdb29"></rect>
        <rect y="7" width="16" height="2" fill="#dbdb29"></rect>
        <rect x="2" y="1" width="12" height="1" fill="#dbdb29"></rect>
        <rect x="3" y="2" width="10" height="1" fill="#dbdb29"></rect>
        <rect x="5" y="3" width="6" height="1" fill="#dbdb29"></rect>
        <rect x="7" y="4" width="2" height="1" fill="#dbdb29"></rect>
        <rect x="9" y="5" width="7" height="2" fill="#dbdb29"></rect>
        <rect x="11" y="4" width="5" height="1" fill="#dbdb29"></rect>
        <rect x="13" y="3" width="3" height="1" fill="#dbdb29"></rect>
        <rect x="14" y="2" width="2" height="1" fill="#dbdb29"></rect>
        <rect width="17" height="1" fill="#000000"></rect>
        <rect y="1" width="2" height="1" fill="#000000"></rect>
        <rect y="9" width="17" height="1" fill="#000000"></rect>
        <rect x="2" y="2" width="1" height="1" fill="#000000"></rect>
        <rect x="3" y="3" width="2" height="1" fill="#000000"></rect>
        <rect x="5" y="4" width="2" height="1" fill="#000000"></rect>
        <rect x="9" y="4" width="2" height="1" fill="#000000"></rect>
        <rect x="11" y="3" width="2" height="1" fill="#000000"></rect>
        <rect x="13" y="2" width="1" height="1" fill="#000000"></rect>
        <rect x="14" y="1" width="3" height="1" fill="#000000"></rect>
        <rect x="16" y="2" width="1" height="7" fill="#000000"></rect>
        <rect x="7" y="5" width="2" height="2" fill="#7e0000"></rect>
      </g>
    </g>
    {/* The right-hand one is the same drawing flipped: the sprite is mirror
        symmetric in the original too, so the two face each other and their
        power lights sit on the inside. */}
    <use href="#pc"></use>
    <use href="#pc" transform="translate(100,0) scale(-1,1)"></use>
  </svg>

  <ul class="xp-contact">
    {
      SOCIAL.map((s) => (
        <li>
          <a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>
            {/* aria-hidden and no title: the mark repeats the word next to it,
                and a screen reader that announces both reads "Email Email". */}
            <svg
              class="ic"
              viewBox={MARK[s.icon].box}
              width="16"
              height="16"
              fill-rule={MARK[s.icon].rule}
              aria-hidden="true"
              focusable="false"
            >
              <path d={MARK[s.icon].d} />
            </svg>
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>

</div>

<style>
  .mailer {
    display: block;
    /* ⚠️ Whole multiples of the viewBox only: 100px is 1:1 — the size the
       sprite was drawn at — and 200px would be 2:1. Anything between, 150px
       say, spreads 100 source pixels over a fractional number of screen ones,
       and `crispEdges` answers that by making some pixels wider than others. */
    width: 100%;
    max-width: 100px;
    height: auto;
    margin: 0 auto 0.9rem;
  }
  /* Stepped, not smooth: a sliding envelope at 2× shimmers along its own
     edges, and the thing being imitated moved in whole pixels anyway.

     67 steps for 67 user units of travel, so every step is exactly one pixel.
     `steps()` applies to each keyframe interval on its own, which is why the
     two dwells can sit in the same list without stealing any of them. */
  .envelope {
    animation: mail 4s steps(67) infinite;
  }

  /* The envelope is 17 wide and starts at x=18. The two ends are the two
     positions where all 17 of those pixels are behind a monitor:

       -10  ->  x 8..25,  inside the left machine  (its wall is 7..27)
        57  ->  x 75..92, inside the right one     (73..93)

     57 rather than 56 because the envelope is an odd number of pixels wide in
     an even gap: 57 is the one that puts it exactly where a mirror would.

     The dwell at each end is what sells it. Without those 12%, the envelope
     turns round the instant it is out of sight and reads as a bounce off the
     glass instead of something that went in, was read, and came back. */
  @keyframes mail {
    0%,
    6% {
      transform: translateX(-10px);
    }
    44%,
    56% {
      transform: translateX(57px);
    }
    94%,
    100% {
      transform: translateX(-10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* Parked in the open air between the two, which is the only part of the
       trip that is worth looking at as a still. Anywhere near an end and the
       drawing would be two computers and no envelope. */
    .envelope {
      animation: none;
      transform: translateX(24px);
    }
  }

  .xp-contact {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xp-contact li {
    margin: 0 0 0.55rem;
  }
  /* The mark and the word are one target, so the 16px square is part of what
     you can click and not a decoration sitting next to it. */
  .xp-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .xp-contact .ic {
    /* `flex: none` because a flex item with an intrinsic size is allowed to be
       squashed by a long label, and a squashed mark is a smudge. */
    flex: none;
    /* No font-size in this file: a test in `xp-doc.test.mjs` keeps it out, and
       16px is written on the element itself. `currentColor` is what makes the
       mark follow the link through hover and visited without a second rule. */
    fill: currentColor;
  }
</style>
