---
/**
 * 3D Pinball: Space Cadet — the only game here that is not mine.
 *
 * The engine is a decompilation of the original, compiled to WebAssembly
 * (k4zmu2a's work, ported to Emscripten by alula). The engine is MIT. The GAME
 * — the table, the sprites, the sounds — is Microsoft's and is not
 * redistributable, which is why upstream ships the code without it and why
 * there is no copy of it in this repository: every byte of it is fetched from
 * their server, and only once you ask for it.
 *
 * ⚠️ The frame no longer points at their page — it points at `/xp/pinball.html`,
 * which is ours and loads their engine. See the long comment in that file: a
 * frame from another origin is a room you cannot enter, and this game needed
 * two things done inside it — the music turned off, and its own window chrome
 * left out of a full screen that is supposed to be the game.
 *
 * It does NOT load on its own. The frame appears only when the visitor asks for
 * it, for two reasons: it is several megabytes off a stranger's bandwidth, and
 * loading a third party unasked would quietly hand them the IP address of
 * everyone who so much as glances at this page — which the colophon in the
 * Contact window promises not to do.
 */
import MenuBar, { type Menu } from "./MenuBar.astro";
import AboutBox from "./AboutBox.astro";

const SRC = "/xp/pinball.html";

/* Short, because it has to be honest. Almost everything the real Game and
   Options menus offered is drawn by the game inside its own canvas, and a menu
   out here cannot reach into a picture. What this side controls is whether to
   load the game at all, and how much of the screen it gets. */
const MENUS: Menu[] = [
  {
    label: "Game",
    items: [
      { label: "Load the game", cmd: "load" },
      { label: "New Game", key: "F2", disabled: true },
      { label: "Pause", disabled: true },
      { sep: true },
      { label: "Exit", cmd: "exit" },
    ],
  },
  {
    label: "Options",
    items: [
      /* The one item here that is really ours: full screen is the page's own
         doing, not the game's. XP put it in this menu under this name with
         this key, so here it is. */
      { label: "Full Screen", cmd: "full", key: "F4", mark: "check", checked: false },
      { sep: true },
      /* Named exactly as the game names them, because these are pointers to
         the real ones: the game draws this same menu inside its own canvas,
         and that is where they can be switched. Music arrives already off. */
      { label: "Player Controls...", key: "F8", disabled: true },
      { label: "Sound", disabled: true },
      { label: "Music", disabled: true },
    ],
  },
  {
    label: "Help",
    items: [
      { label: "Contents", disabled: true },
      { sep: true },
      { label: "About 3D Pinball", cmd: "about" },
    ],
  },
];
---

<div class="pin">
  <MenuBar id="pin-menu" menus={MENUS} />

  <div class="pin-stage">
    {/* The URL rides on the button rather than in the script: the script is
        bundled and shared, the markup is where this component's own data goes. */}
    <button type="button" class="pin-play" data-src={SRC}>
      <span class="pin-play-icon" aria-hidden="true">▶</span>
      <span>Load the game</span>
      <span class="pin-play-note">No music. Maximise the window for full screen</span>
    </button>
  </div>

  {/* The notice is not decoration and it is not optional, so it does not live
      only in a comment. Help -> About is where Windows kept this, and it is the
      only place left now that the game fills the window. */}
  <AboutBox id="pin-about" title="About 3D Pinball">
    <p>
      <kbd>Z</kbd> and <kbd>/</kbd> are the flippers — the original's keys, not
      the arrows — and holding <kbd>Space</kbd> pulls the plunger. Nudge the
      table with <kbd>X</kbd>, <kbd>.</kbd> and <kbd>↑</kbd>, and tilt it if you
      lean on them. <kbd>F2</kbd> is a new game and <kbd>F3</kbd> pauses. Click
      inside the frame first, or the keys go to this page instead.
      <kbd>Esc</kbd> leaves full screen.
    </p>
    <p>
      <strong>The music is off.</strong> The game has no switch anyone can
      reach from outside, so the page turns it off the way you would: it opens
      the game's own <em>Options</em> menu and clicks <em>Music</em>, once, as
      soon as the table appears. The sound effects stay. Both live in that menu
      — the one the game draws inside itself — which is why the copies of them
      above are greyed. Leaving the game stops it entirely: the frame is thrown
      away the moment it goes off screen.
    </p>
    <p>
      <strong>The game is not mine.</strong> The engine is a decompilation of
      the original by <a
        href="https://github.com/k4zmu2a/SpaceCadetPinball"
        rel="noopener">k4zmu2a</a>, compiled to WebAssembly by <a
        href="https://github.com/alula/SpaceCadetPinball" rel="noopener">alula</a>,
      and it is loaded, along with the game's data, from their server.
    </p>
    <p>
      The game's own data is Microsoft's and is not redistributable, so there is
      no copy of it in this repository — and nothing is fetched from them until
      you press Load.
    </p>
  </AboutBox>
</div>

<script>
  const root = document.querySelector<HTMLElement>(".pin");
  const stage = root?.querySelector<HTMLElement>(".pin-stage");
  const button = stage?.querySelector<HTMLButtonElement>(".pin-play");

  if (root && stage && button) {
    const item = (cmd: string) => root.querySelector<HTMLButtonElement>(`[data-cmd="${cmd}"]`);

    const load = () => {
      if (stage.querySelector("iframe")) return;
      const frame = document.createElement("iframe");
      frame.src = button.dataset.src ?? "";
      frame.title = "3D Pinball: Space Cadet";
      frame.allow = "autoplay; fullscreen";
      frame.className = "pin-frame";
      stage.replaceChildren(frame);
      frame.focus();
      // The menu item has done its one job; leave it greyed rather than let it
      // look like it still would.
      item("load")?.setAttribute("disabled", "");
    };

    /**
     * Throws the frame away and puts the button back.
     *
     * Not housekeeping: a cross-origin frame keeps RUNNING when you hide it,
     * and the first thing you notice is that the game's music follows you out
     * of the room. Nothing on this side can turn that off — the audio belongs
     * to a document this page is not allowed to touch — so the only way to
     * stop it is to stop the document.
     */
    const unload = () => {
      if (!stage.querySelector("iframe")) return;
      // The button was taken out of the DOM by `load`, not destroyed: it is the
      // same element, listener and all, going back where it was.
      stage.replaceChildren(button);
      item("load")?.removeAttribute("disabled");
    };

    const full = () => {
      load();
      if (document.fullscreenElement === stage) document.exitFullscreen();
      // A rejection is a browser that will not do it — iOS never does it for
      // anything but a video. The game stays in its window, which still plays.
      else stage.requestFullscreen().catch(() => {});
    };

    // Load opens the game and nothing else. It used to go straight to full
    // screen in the same gesture, which is what the original did off F4 — but
    // a game that swallows the whole display before you have seen the window
    // it came out of is a surprise, and the way back out is a key nobody was
    // told about. It opens at the size the original opened at; growing it is a
    // second, deliberate press.
    button.addEventListener("click", load);

    /* And that press is the window's own maximise button. The window says
       `xp:maximise` from inside its click handler, so the browser still counts
       this as the gesture that full screen requires. Only while a game is
       actually loaded: maximising an empty window is just a bigger window. */
    const win = root.closest<HTMLElement>(".xp-window");
    win?.addEventListener("xp:maximise", (e) => {
      if (!stage.querySelector("iframe")) return;
      if ((e as CustomEvent<boolean>).detail) stage.requestFullscreen().catch(() => {});
      else if (document.fullscreenElement === stage) document.exitFullscreen();
    });
    root.addEventListener("xpmenu", (e) => {
      const cmd = (e as CustomEvent<string>).detail;
      if (cmd === "load") load();
      else if (cmd === "full") full();
      else if (cmd === "about") root.querySelector<HTMLDialogElement>("#pin-about")?.showModal();
      // "exit" is not handled here: the window this lives in owns it.
    });

    /* Nothing here resizes anything. The frame is the stage, the stage becomes
       the screen, and the game inside renders at whatever size it is given —
       which is the entire reason it stopped being framed from their page. */

    // The tick on Options -> Full Screen is only true while it is true, and the
    // browser can end full screen on its own (Esc, another tab).
    document.addEventListener("fullscreenchange", () => {
      const on = document.fullscreenElement === stage;
      item("full")?.setAttribute("aria-pressed", String(on));
      /* Esc ends full screen without telling the window, which would leave a
         window maximised over the whole desktop with a 600px game in the
         corner of it. Pressing its button is how the two are put back in step,
         and it cannot loop: the window sets `aria-pressed` to false before it
         says `xp:maximise`, so this finds nothing to press the second time. */
      if (!on) win?.querySelector<HTMLButtonElement>(".xp-max[aria-pressed='true']")?.click();
    });

    /* The menu prints F4, so F4 has to work. `offsetWidth` is the guard and it
       is deliberately not "is my panel hidden": the game can also be off screen
       because the Games window was closed or minimised, and an unrendered
       element measures 0 in every one of those cases. */
    addEventListener("keydown", (e) => {
      if (e.key !== "F4" || !stage.offsetWidth) return;
      e.preventDefault();
      full();
    });

    /* ⚠️ The one hook that catches every way this game can leave the screen:
       Game -> Exit, opening a different game, closing the window, minimising
       it. All four end in `display: none` somewhere up the tree, and the only
       thing they have in common is that the stage stops having a box. An
       IntersectionObserver would ALSO fire on scrolling the game out of view,
       which would kill a game that is merely behind the edge of the screen. */
    new ResizeObserver(([entry]) => {
      const box = entry?.contentRect;
      if (box && box.width === 0 && box.height === 0) unload();
    }).observe(stage);

    // 600x416 is what the original window opened at, and the window is sized to
    // it. Whoever owns the window listens for this.
    root.dispatchEvent(new CustomEvent("xp:fit", { bubbles: true }));
  }
</script>

<style>
  /* Menu bar on top, frame under it: the two parts of the window. */
  .pin {
    display: flex;
    flex-direction: column;

    /* The client area of the original window: 600x416 of table, plus the 24px
       menu bar the game draws along the top of it. Nothing depends on these
       being right any more — the game fills whatever it is given — so they are
       a choice about how big the window opens, not a constraint. */
    --pin-w: 600;
    --pin-h: 440;
  }
  /* The frame IS the client area: the window is sized to this, so no margin. A
     fixed width rather than a percentage because the panel around it is sized
     by its content, and a percentage of a max-content box has nothing to
     resolve against. */
  .pin-stage {
    position: relative;
    width: calc(var(--pin-w) * 1px);
    max-width: 100%;
    aspect-ratio: var(--pin-w) / var(--pin-h);
    background: #000000;
  }

  .pin-play {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    background: none;
    border: 0;
    color: #ffffff;
    font: inherit;
    cursor: default;
  }
  .pin-play-icon {
    font-size: 2.4rem;
    line-height: 1;
  }
  .pin-play-note {
    font-size: 0.75rem;
    color: #b9c7d8;
  }
  .pin-play:hover .pin-play-icon {
    color: #ffc83d;
  }
  .pin-play:focus-visible {
    outline: 2px solid #ffc83d;
    outline-offset: -4px;
  }

  /* Created by the script, so it carries no scope attribute of its own. */
  .pin-stage :global(.pin-frame) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Full screen needs no rule of its own: the browser stretches the stage to
     the whole display, the frame is already 100% of the stage, and the game
     re-renders at that size. It was a pile of arithmetic while the page inside
     belonged to someone else. */

</style>
