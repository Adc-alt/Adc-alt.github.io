---
/**
 * 3D Pinball: Space Cadet — the only game here that is not mine and not hosted
 * here either.
 *
 * The engine is a decompilation of the original, compiled to WebAssembly
 * (k4zmu2a's work, ported to Emscripten by alula). The engine is MIT. The GAME
 * — the table, the sprites, the sounds — is Microsoft's and is not
 * redistributable, which is why upstream ships the code without it and why
 * there is no copy of it in this repository. What is here is a frame around
 * somebody else's build.
 *
 * It does NOT load on its own. The frame appears only when the visitor asks for
 * it, for two reasons: it is several megabytes off a stranger's bandwidth, and
 * loading a third party unasked would quietly hand them the IP address of
 * everyone who so much as glances at this page — which the colophon in the
 * Contact window promises not to do.
 */
import MenuBar, { type Menu } from "./MenuBar.astro";
import AboutBox from "./AboutBox.astro";

const SRC = "https://pinball.alula.me/";

/* Short, because it has to be honest. Almost everything the real Game and
   Options menus offered lives INSIDE somebody else's frame, and a menu here
   cannot reach across it — sound and music included. What this side does
   control is whether to load the frame at all, and how big it is. */
const MENUS: Menu[] = [
  {
    label: "Game",
    items: [
      { label: "Load the game", cmd: "load" },
      { label: "New Game", key: "F2", disabled: true },
      { label: "Pause", disabled: true },
      { sep: true },
      { label: "Exit", cmd: "exit" },
    ],
  },
  {
    label: "Options",
    items: [
      /* The one item here that is really ours: full screen is the page's own
         doing, not the game's. XP put it in this menu under this name with
         this key, so here it is. */
      { label: "Full Screen", cmd: "full", key: "F4", mark: "check", checked: false },
      { sep: true },
      { label: "Player Controls...", disabled: true },
      { label: "Sounds", disabled: true },
      { label: "Music", disabled: true },
    ],
  },
  {
    label: "Help",
    items: [
      { label: "Contents", disabled: true },
      { sep: true },
      { label: "About 3D Pinball", cmd: "about" },
    ],
  },
];
---

<div class="pin">
  <MenuBar id="pin-menu" menus={MENUS} />

  <div class="pin-stage">
    {/* The URL rides on the button rather than in the script: the script is
        bundled and shared, the markup is where this component's own data goes. */}
    <button type="button" class="pin-play" data-src={SRC}>
      <span class="pin-play-icon" aria-hidden="true">▶</span>
      <span>Load the game</span>
      <span class="pin-play-note">Full screen, from pinball.alula.me. Esc to come back</span>
    </button>
  </div>

  {/* The notice is not decoration and it is not optional, so it does not live
      only in a comment. Help -> About is where Windows kept this, and it is the
      only place left now that the game fills the window. */}
  <AboutBox id="pin-about" title="About 3D Pinball">
    <p>
      Arrow keys or <kbd>Z</kbd> and <kbd>/</kbd> for the flippers, hold
      <kbd>Space</kbd> to pull the plunger. Click inside the frame first, or the
      keys go to this page instead. <kbd>Esc</kbd> leaves full screen.
    </p>
    <p>
      <strong>The sound is the game's, not this page's.</strong> Turn the music
      or the effects off in the game's own <em>Options</em> menu, the one drawn
      inside the frame — a page cannot reach into a frame it does not own, so
      the copies of those items in the menu above are greyed. Leaving the game
      does stop it: the frame is thrown away when it goes off screen.
    </p>
    <p>
      <strong>Not mine and not hosted here.</strong> The engine is a
      decompilation of the original by <a
        href="https://github.com/k4zmu2a/SpaceCadetPinball"
        rel="noopener">k4zmu2a</a>, compiled to WebAssembly by <a
        href="https://github.com/alula/SpaceCadetPinball" rel="noopener">alula</a>,
      and it runs off their server.
    </p>
    <p>
      The game's own data is Microsoft's and is not redistributable, so there is
      no copy of it in this repository — and nothing is fetched from them until
      you press Load.
    </p>
  </AboutBox>
</div>

<script>
  const root = document.querySelector<HTMLElement>(".pin");
  const stage = root?.querySelector<HTMLElement>(".pin-stage");
  const button = stage?.querySelector<HTMLButtonElement>(".pin-play");

  if (root && stage && button) {
    const item = (cmd: string) => root.querySelector<HTMLButtonElement>(`[data-cmd="${cmd}"]`);

    const load = () => {
      if (stage.querySelector("iframe")) return;
      const frame = document.createElement("iframe");
      frame.src = button.dataset.src ?? "";
      frame.title = "3D Pinball: Space Cadet";
      frame.allow = "autoplay; fullscreen";
      frame.className = "pin-frame";
      stage.replaceChildren(frame);
      frame.focus();
      // The menu item has done its one job; leave it greyed rather than let it
      // look like it still would.
      item("load")?.setAttribute("disabled", "");
    };

    /**
     * Throws the frame away and puts the button back.
     *
     * Not housekeeping: a cross-origin frame keeps RUNNING when you hide it,
     * and the first thing you notice is that the game's music follows you out
     * of the room. Nothing on this side can turn that off — the audio belongs
     * to a document this page is not allowed to touch — so the only way to
     * stop it is to stop the document.
     */
    const unload = () => {
      if (!stage.querySelector("iframe")) return;
      // The button was taken out of the DOM by `load`, not destroyed: it is the
      // same element, listener and all, going back where it was.
      stage.replaceChildren(button);
      item("load")?.removeAttribute("disabled");
    };

    const full = () => {
      load();
      if (document.fullscreenElement === stage) document.exitFullscreen();
      // A rejection is a browser that will not do it — iOS never does it for
      // anything but a video. The game stays in its window, which still plays.
      else stage.requestFullscreen().catch(() => {});
    };

    // Loading and going full screen are one gesture: the game pops out centred
    // on the whole screen, which is what the real one did off F4.
    button.addEventListener("click", full);
    root.addEventListener("xpmenu", (e) => {
      const cmd = (e as CustomEvent<string>).detail;
      if (cmd === "load") load();
      else if (cmd === "full") full();
      else if (cmd === "about") root.querySelector<HTMLDialogElement>("#pin-about")?.showModal();
      // "exit" is not handled here: the window this lives in owns it.
    });

    // The tick on Options -> Full Screen is only true while it is true, and the
    // browser can end full screen on its own (Esc, another tab).
    document.addEventListener("fullscreenchange", () => {
      item("full")?.setAttribute("aria-pressed", String(document.fullscreenElement === stage));
    });

    /* The menu prints F4, so F4 has to work. `offsetWidth` is the guard and it
       is deliberately not "is my panel hidden": the game can also be off screen
       because the Games window was closed or minimised, and an unrendered
       element measures 0 in every one of those cases. */
    addEventListener("keydown", (e) => {
      if (e.key !== "F4" || !stage.offsetWidth) return;
      e.preventDefault();
      full();
    });

    /* ⚠️ The one hook that catches every way this game can leave the screen:
       Game -> Exit, opening a different game, closing the window, minimising
       it. All four end in `display: none` somewhere up the tree, and the only
       thing they have in common is that the stage stops having a box. An
       IntersectionObserver would ALSO fire on scrolling the game out of view,
       which would kill a game that is merely behind the edge of the screen. */
    new ResizeObserver(([entry]) => {
      const box = entry?.contentRect;
      if (box && box.width === 0 && box.height === 0) unload();
    }).observe(stage);

    // 600x416 is what the original window opened at, and the window is sized to
    // it. Whoever owns the window listens for this.
    root.dispatchEvent(new CustomEvent("xp:fit", { bubbles: true }));
  }
</script>

<style>
  /* Menu bar on top, frame under it: the two parts of the window. */
  .pin {
    display: flex;
    flex-direction: column;
  }
  /* Exactly the 600x416 the original window opened at, and no margin: the
     window is sized to this, so the frame IS the client area. A fixed width
     rather than a percentage because the panel around it is sized by its
     content, and a percentage of a max-content box has nothing to resolve
     against. */
  .pin-stage {
    position: relative;
    width: 600px;
    max-width: 100%;
    aspect-ratio: 600 / 416;
    background: #000000;
  }

  .pin-play {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    background: none;
    border: 0;
    color: #ffffff;
    font: inherit;
    cursor: default;
  }
  .pin-play-icon {
    font-size: 2.4rem;
    line-height: 1;
  }
  .pin-play-note {
    font-size: 0.75rem;
    color: #b9c7d8;
  }
  .pin-play:hover .pin-play-icon {
    color: #ffc83d;
  }
  .pin-play:focus-visible {
    outline: 2px solid #ffc83d;
    outline-offset: -4px;
  }

  /* Created by the script, so it carries no scope attribute of its own. */
  .pin-stage :global(.pin-frame) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Full screen. The browser forces the stage to 100% of the display and puts
     it in the top layer, so all that is left to do here is centre what is
     inside it — the stage is already black, which makes the bars the
     letterboxing needs. */
  .pin-stage:fullscreen {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pin-stage:fullscreen :global(.pin-frame) {
    /* Blown up to the tallest 600x416 that fits, and no taller. `100vh` is the
       stage's own height HERE and only here, which is the whole point: the
       letterbox has to be measured against the screen, not against the 600px
       the stage is while it lives in a window. */
    width: min(100%, calc(100vh * 600 / 416));
    height: auto;
    aspect-ratio: 600 / 416;
  }

</style>
