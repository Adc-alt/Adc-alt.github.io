---
/**
 * Bio and tooling. This is what used to be `/perfil/`.
 */
import { SOCIAL } from "../../consts";

/* Short on purpose: a portfolio gets skimmed, and a list nobody finishes
   reading says less than a list of six. What is here is what is on the CV and
   in the projects below, which is the same thing. */
const loadout = [
  { group: "Embedded and firmware", items: ["Bare-metal C/C++", "ESP32", "ATmega328P", "RP2040", "FPGAs", "EEPROM microcode"] },
  { group: "Hardware and lab", items: ["Altium Designer", "KiCad", "Board bring-up", "SPICE", "Oscilloscope", "Logic analyser", "Multimeter"] },
  { group: "Software", items: ["Python", "NumPy", "OpenCV", "TypeScript", "Linux", "Git"] },
  { group: "Automation", items: ["OMRON PLC", "Siemens TIA Portal", "HMI"] },
];
---

<div class="xp-doc">
  <h1>About me</h1>

  <p>
    I'm an electronics and embedded systems engineer in Málaga. I design power
    electronics boards for satellites, and before that I spent about fifteen
    months in industrial automation. What that work looks like from the inside
    is in <a href="#section-experience">Experience</a>; this page is the rest of
    me.
  </p>
  <p>
    B.Sc. in Electronics, Robotics and Mechatronics Engineering from the
    University of Málaga, with a thesis on the ICP technique for indoor motion
    estimation. Cambridge C1 in English, CCNAv7, and Spanish as a native. German
    only just started.
  </p>

  <hr />

  <h2>What I work with</h2>

  <dl class="card tools">
    {
      loadout.map((row) => (
        <div>
          <dt>{row.group}</dt>
          <dd>{row.items.join(" · ")}</dd>
        </div>
      ))
    }
  </dl>

  <hr />

  <h2>Get in touch</h2>
  <p>If something here fits what you need, write to me. I answer everything.</p>
  <p class="row">
    {
      SOCIAL.map((s) => (
        <a href={s.href} rel={s.href.startsWith("http") ? "me noopener" : undefined}>
          {s.label}
        </a>
      ))
    }
  </p>

  {/* The moon that used to sit at the foot of the Blog, which is what a
      personal site had in 1999 and what this desktop is a homage to. The Blog
      went and the moon did not: About is the section about the person rather
      than the engineer, so this is where it belonged all along. Decorative and
      nothing else, so the alt is empty: a screen reader should walk past it,
      not describe it.

      ⚠️ `loading="lazy"` is not a nicety here. Every section of the reading
      pane is in the DOM from the first byte and the ones you are not reading
      are `hidden`, so an eager image in this one would be 474 KB fetched by
      every visitor who never opens About. Lazy images inside a box that is not
      rendered are not fetched at all. */}
  <p class="moon">
    <img src="/media/moon.gif" width="300" height="341" alt="" loading="lazy" decoding="async" />
  </p>
</div>

<style>
  /* The shared card lays out in a row; this one is a list of groups, so each
     gets its own line. It is the only thing this document does not share with
     the others, and that is why it is the only thing written here. */
  /* `.xp-doc` in front on purpose: `.card` comes from the global sheet, and
     without the ancestor the two rules tie on specificity — which one wins then
     depends on the order the bundler happens to concatenate the files in. */
  .xp-doc .tools {
    display: block;
  }
  .xp-doc .tools > div {
    margin-bottom: 0.7rem;
  }

  .moon {
    margin: 2.4rem 0 0;
    text-align: center;
  }
  .moon img {
    /* It is 300 wide and the column can be narrower than that on a phone. */
    max-width: 100%;
    height: auto;
  }
</style>
