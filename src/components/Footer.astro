---
import { SITE, SOCIAL } from "../consts";

const year = new Date().getFullYear();
---

<footer class="relative z-10 mt-24 border-t border-[var(--edge)]">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-6 px-5 py-10 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="space-y-1.5">
      <p class="hud-label">Insert coin to continue</p>
      <p class="text-xs text-faint">
        © {year} {SITE.name}. Hecho con Astro, sin analítica y sin cookies.
      </p>
      {/* Crédito obligatorio de la CC BY-SA 4.0 de la fuente del arranque. */}
      <p class="text-xs text-faint">
        Tipografía del arranque: IBM VGA 8x16 de{" "}
        <a
          href="https://int10h.org/oldschool-pc-fonts/"
          rel="noopener"
          class="underline decoration-dotted underline-offset-2 transition-colors hover:text-neon-cyan"
          >VileR</a
        >, <a
          href="/fonts/LICENSE-oldschool-pc-fonts.txt"
          class="underline decoration-dotted underline-offset-2 transition-colors hover:text-neon-cyan"
          >CC BY-SA 4.0</a
        >.
      </p>
    </div>

    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {
        SOCIAL.map((s) => (
          <li>
            <a
              href={s.href}
              class="font-display text-[0.55rem] tracking-widest text-dim uppercase transition-colors hover:text-neon-magenta"
              rel={s.href.startsWith("http") ? "me noopener" : undefined}
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
