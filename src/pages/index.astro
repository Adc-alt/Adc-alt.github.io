---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Comecocos from "../components/Comecocos.astro";
import { SITE } from "../consts";

const all = await getCollection("proyectos", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);

const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Marcadores derivados de datos reales, no inventados. Sin acentos: van en
// tipografía display (ver consts.ts).
const stats = [
  { label: "Proyectos", value: String(all.length).padStart(2, "0") },
  {
    label: "Stack",
    value: String(new Set(all.flatMap((p) => p.data.stack)).size).padStart(2, "0"),
  },
  { label: "Estado", value: "ONLINE" },
];
---

<Base>
  {/* ================= HERO ================= */}
  <section class="relative overflow-hidden px-5 pt-16 pb-16 sm:pt-24 sm:pb-20">
    {/* Suelo en perspectiva */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-56 overflow-hidden"
    >
      <div class="grid-floor absolute inset-x-[-50%] bottom-0 h-56"></div>
    </div>

    <div class="relative mx-auto max-w-5xl">
      <p class="hud-label anim-rise mb-6 flex items-center gap-2">
        <span
          class="inline-block h-1.5 w-1.5 bg-neon-lime"
          style="box-shadow:0 0 8px var(--color-neon-lime)"
          aria-hidden="true"></span>
        Player 1 · Ready
      </p>

      <h1 class="anim-rise mb-6 leading-[1.25]" style="animation-delay:80ms">
        <span
          class="chromatic block text-[clamp(1.35rem,7vw,3.4rem)] text-ink"
          >ANTONIO</span
        >
        <span
          class="neon-cyan block text-[clamp(1.35rem,7vw,3.4rem)]"
          >DELGADO</span
        >
      </h1>

      <p
        class="anim-rise mb-2 max-w-xl text-base text-dim"
        style="animation-delay:160ms"
      >
        {SITE.role}. {SITE.tagline}
      </p>

      <p
        class="anim-rise mb-8 font-display text-[0.55rem] tracking-widest text-neon-amber uppercase sm:text-[0.6rem]"
        style="animation-delay:200ms"
      >
        <span class="anim-blink">▮</span> Insert coin
      </p>

      <div
        class="anim-rise flex flex-wrap gap-3"
        style="animation-delay:260ms"
      >
        <a href="/proyectos/" class="btn-arcade">Start &gt;</a>
        <a href="/perfil/" class="btn-ghost">Perfil</a>
      </div>
    </div>
  </section>

  {/* ================= HIGH SCORES ================= */}
  <section class="relative px-5">
    <div class="mx-auto max-w-5xl">
      <dl
        class="panel grid grid-cols-1 divide-y divide-[var(--edge)] sm:grid-cols-3 sm:divide-x sm:divide-y-0"
      >
        {
          stats.map((s) => (
            <div class="px-4 py-4 text-center sm:px-6 sm:py-5">
              <dt class="hud-label mb-1 sm:mb-2">{s.label}</dt>
              <dd class="neon-amber font-display text-[clamp(0.7rem,2.6vw,0.95rem)]">
                {s.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ================= LA RECREATIVA ================= */}
  <section class="relative px-5 pt-24">
    <div class="mx-auto max-w-5xl">
      <SectionTitle kicker="Bonus stage" title="Comecocos" />
      <p class="mb-8 max-w-xl text-sm text-dim">
        Escrito a mano en canvas, sin librerías. Los cuatro fantasmas tienen la
        personalidad del original: uno te persigue, otro te corta el paso, otro
        va a por donde vas a estar y el último se raja cuando te acercas.
      </p>
      <Comecocos />
    </div>
  </section>

  {/* ================= DESTACADOS ================= */}
  <section class="relative px-5 pt-24">
    <div class="mx-auto max-w-5xl">
      <SectionTitle kicker="Select your fighter" title="Proyectos destacados" />

      {
        featured.length > 0 ? (
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {featured.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        ) : (
          <p class="panel p-6 text-sm text-dim">
            Todavía no hay proyectos destacados. Marca <code>featured: true</code> en
            algún <code>.md</code> de <code>src/content/proyectos/</code>.
          </p>
        )
      }

      <div class="mt-8">
        <a
          href="/proyectos/"
          class="font-display text-[0.6rem] tracking-widest text-dim uppercase transition-colors hover:text-neon-cyan"
        >
          Ver todos &gt;
        </a>
      </div>
    </div>
  </section>
</Base>
