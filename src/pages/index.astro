---
/**
 * The site: a Windows XP desktop with the portfolio inside windows.
 *
 * Every window is rendered here, at build time. The JavaScript only opens,
 * closes and drags them — if it generated the content, a search engine would
 * see an empty desktop (phase 1 §13).
 *
 * Spec: docs/superpowers/specs/2026-08-15-xp-desktop-phase2-design.md
 */
import { getCollection } from "astro:content";
import XP from "../layouts/XP.astro";
import Boot from "../components/Boot.astro";
import Window from "../components/xp/Window.astro";
import Welcome from "../components/xp/Welcome.astro";
import Projects from "../components/xp/Projects.astro";
import Project from "../components/xp/Project.astro";
import About from "../components/xp/About.astro";
import Blog from "../components/xp/Blog.astro";
import { windowIdFor } from "../components/xp/projects.mjs";

const projects = (
  await getCollection("projects", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
---

<XP>
  <Boot slot="overlay" />

  {/* The only one that opens by itself, and the only navigation there is: no
      icons and no Start menu, everything else opens from inside this one. */}
  {/* 560 is not a round number: measured in the browser, the welcome content
      takes 515px and the usable well is 33 less than the window height. It is
      the only window that cares — the rest are documents and scroll by nature —
      because a scrollbar on the first screen of the site says "this does not
      fit here" before anyone has read a word. */}
  <Window id="window-welcome" title="Welcome to my page" width={720} height={560} open>
    <Welcome />
  </Window>

  <Window id="window-projects" title="Projects" width={660} height={480}>
    <Projects />
  </Window>

  <Window id="window-about" title="About me" width={640} height={520}>
    <About />
  </Window>

  <Window id="window-blog" title="Blog" width={740} height={560}>
    <Blog />
  </Window>

  {
    projects.map((p) => (
      <Window id={windowIdFor(p.id)} title={p.data.title} width={720} height={560}>
        <Project project={p} />
      </Window>
    ))
  }
</XP>
