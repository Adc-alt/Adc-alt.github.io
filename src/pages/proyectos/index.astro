---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const proyectos = (
  await getCollection("proyectos", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
---

<Base
  title="Proyectos"
  description="Cosas que he construido: qué problema resolvían y cómo están hechas por dentro."
>
  <section class="px-5 pt-16">
    <div class="mx-auto max-w-5xl">
      <SectionTitle
        kicker={`Stage select · ${String(proyectos.length).padStart(2, "0")} disponibles`}
        title="Proyectos"
      />

      {
        proyectos.length > 0 ? (
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {proyectos.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        ) : (
          <div class="panel panel-corners p-8 text-center">
            <p class="font-display text-[0.7rem] text-neon-amber">NO DATA</p>
            <p class="mt-3 text-sm text-dim">
              Añade un <code>.md</code> en <code>src/content/proyectos/</code>.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Base>
