---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = (async () => {
  const proyectos = await getCollection("proyectos", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return proyectos.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, stack, year, status, repo, demo, accent } = project.data;

const accentVar = {
  cyan: "var(--color-neon-cyan)",
  magenta: "var(--color-neon-magenta)",
  amber: "var(--color-neon-amber)",
  lime: "var(--color-neon-lime)",
}[accent];

const statusLabel = { live: "ACTIVO", wip: "EN CURSO", archived: "ARCHIVADO" }[status];
---

<Base title={title} description={summary}>
  <article class="px-5 pt-14">
    <div class="mx-auto max-w-3xl" style={`--accent:${accentVar}`}>
      <a
        href="/proyectos/"
        class="hud-label mb-8 inline-block transition-colors hover:text-neon-cyan"
      >
        &lt; Volver
      </a>

      <header class="mb-10 border-b border-[var(--edge)] pb-8">
        <h1 class="mb-4 text-lg leading-relaxed sm:text-xl" style="color:var(--accent)">
          {title}
        </h1>
        <p class="mb-6 text-base text-dim">{summary}</p>

        <dl class="flex flex-wrap gap-x-8 gap-y-3">
          <div>
            <dt class="hud-label">Fecha</dt>
            <dd class="mt-1 text-sm">{year}</dd>
          </div>
          <div>
            <dt class="hud-label">Estado</dt>
            <dd class="mt-1 text-sm">{statusLabel}</dd>
          </div>
          <div class="min-w-full sm:min-w-0">
            <dt class="hud-label">Stack</dt>
            <dd class="mt-1 text-sm">{stack.join(" · ")}</dd>
          </div>
        </dl>

        {
          (repo || demo) && (
            <div class="mt-7 flex flex-wrap gap-3">
              {demo && (
                <a href={demo} class="btn-arcade" rel="noopener">
                  Ver en vivo &gt;
                </a>
              )}
              {repo && (
                <a href={repo} class="btn-ghost" rel="noopener">
                  Repo
                </a>
              )}
            </div>
          )
        }
      </header>

      <div class="prose-arcade">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  /* Estilos del Markdown renderizado. Alcance limitado a esta página:
     no hay plugin de tipografía, son doce reglas y no hace falta más. */
  .prose-arcade :global(h2) {
    font-size: 0.78rem;
    line-height: 1.6;
    margin: 2.5rem 0 1rem;
    color: var(--color-ink);
  }
  .prose-arcade :global(h3) {
    font-size: 0.68rem;
    margin: 2rem 0 0.75rem;
    color: var(--color-dim);
  }
  .prose-arcade :global(p) {
    margin: 0 0 1.15rem;
    color: var(--color-dim);
  }
  .prose-arcade :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-arcade :global(ul) {
    margin: 0 0 1.15rem;
    padding-left: 1.1rem;
    list-style: none;
  }
  .prose-arcade :global(li) {
    position: relative;
    margin-bottom: 0.5rem;
    color: var(--color-dim);
  }
  .prose-arcade :global(li)::before {
    content: "▸";
    position: absolute;
    left: -1.1rem;
    color: var(--accent);
  }
  .prose-arcade :global(a) {
    color: var(--color-neon-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-arcade :global(code) {
    background: var(--color-panel-hi);
    border: 1px solid var(--edge);
    padding: 0.1rem 0.35rem;
    font-size: 0.85em;
    color: var(--color-neon-amber);
  }
  .prose-arcade :global(pre) {
    background: var(--color-panel);
    border: 1px solid var(--edge);
    padding: 1rem;
    overflow-x: auto;
    margin: 0 0 1.15rem;
  }
  .prose-arcade :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
  }
  .prose-arcade :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    margin: 0 0 1.15rem;
    color: var(--color-faint);
  }
</style>
