---
/**
 * La página que sirve GitHub Pages cuando la ruta no existe. Sin arranque: a
 * un 404 se llega por accidente, y no es momento de una animación.
 */
import XP from "../layouts/XP.astro";
import Window from "../components/xp/Window.astro";
---

<XP title="No se encuentra la página" noindex>
  <Window id="ventana-404" title="Error" width={480} height={260} open>
    <div class="xp-doc">
      <h1>No se encuentra la página</h1>
      <p>
        La dirección que has pedido no existe en este sitio. Puede que fuera de
        la versión anterior: el portfolio se rehizo entero y varias rutas
        desaparecieron.
      </p>
      <p class="fila">
        <a href="/">Ir al escritorio</a>
      </p>
    </div>
  </Window>
</XP>
