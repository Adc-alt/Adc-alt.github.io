---
import Base from "../layouts/Base.astro";
---

<Base title="404" description="Esta página no existe.">
  <section class="grid min-h-[70vh] place-items-center px-5 text-center">
    <div>
      <p class="neon-magenta font-display text-2xl sm:text-4xl">GAME</p>
      <p class="neon-magenta mt-3 font-display text-2xl sm:text-4xl">OVER</p>

      <p class="hud-label mt-8">Error 404 · Ruta no encontrada</p>

      <p class="mt-6 font-display text-[0.65rem] tracking-widest text-neon-amber">
        Continue? <span class="anim-blink">▮</span>
      </p>

      <div class="mt-8">
        <a href="/" class="btn-arcade">Volver al inicio</a>
      </div>
    </div>
  </section>
</Base>
