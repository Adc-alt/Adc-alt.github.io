---
/**
 * The page GitHub Pages serves when the route does not exist. No boot screen:
 * you reach a 404 by accident, and that is no moment for an animation.
 */
import XP from "../layouts/XP.astro";
import Window from "../components/xp/Window.astro";
---

<XP title="Page not found" noindex>
  {/* `noEnter`: with no boot screen to hide it behind, the arrival stagger is
      just an empty desktop for a second and a half on a page nobody meant to
      land on. */}
  <Window id="window-404" title="Error" width={480} height={260} open noEnter>
    <div class="xp-doc">
      <h1>Page not found</h1>
      <p>
        The address you asked for does not exist on this site. It may be from the
        previous version: the portfolio was rebuilt from scratch and several
        routes went away.
      </p>
      <p class="row">
        <a href="/">Go to the desktop</a>
      </p>
    </div>
  </Window>
</XP>
