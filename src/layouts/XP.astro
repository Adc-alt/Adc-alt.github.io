---
/**
 * The desktop. It is the layout for the whole site: since phase 2 there is no
 * other.
 *
 * No @fontsource is imported: the only font served is the boot one, and
 * `Boot.astro` declares its own @font-face. Everything else is Tahoma, which
 * the visitor either has or falls back to the closest thing they do have.
 *
 * TWO MODES (phase 2 §4). Stacked is the base and desktop is the enhancement:
 * the desktop rules live inside `@media (min-width: 1270px)` — the width the
 * three-window row needs, `DESKTOP_MIN_WIDTH` in `xp/windows.mjs` — and hang
 * off `html.js`. Without JavaScript they never apply and the site reads as a
 * column of windows, which is also what a phone and a narrow window get.
 *
 * Spec: docs/superpowers/specs/2026-08-15-xp-desktop-phase2-design.md
 */
import "../styles/xp-doc.css";
import Wallpaper from "../components/xp/Wallpaper.astro";
import Taskbar from "../components/xp/Taskbar.astro";
import { SITE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = SITE.tagline, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.role}`;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={SITE.url + "/"} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#245edc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* The key to desktop mode. It goes here, before the markup and inline, so
        the mode is decided by the first paint: set from a module, the windows
        would show stacked for one frame before laying themselves out. Without
        JavaScript it is never set, and that is the whole mechanism of stacked
        mode. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    {/* The full-screen slot (the boot screen), first child of <body>. The order
        matters: the boot screen's anti-flash script lives inside this slot and
        has to set html[data-boot] BEFORE the taskbar is parsed, or the taskbar
        shows for one frame before hiding. */}
    <slot name="overlay" />

    {/* id="content" is not decorative: when it finishes, the boot screen looks
        for that id to hand keyboard focus back. */}
    <main id="content" class="xp-desktop">
      <Wallpaper />
      <slot />
    </main>

    <Taskbar />
  </body>
</html>

<style is:global>
  /* `Boot.astro` uses var(--font-mono) to fall back to a system monospace if
     "AcPlus IBM VGA 8x16" is not available. A var() pointing at an undefined
     variable invalidates the WHOLE declaration at computed-value time — it does
     not fall through to the next name in the list, it throws the entire list
     away and inherits the parent's font — so the variable has to exist here. */
  :root {
    --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  html,
  body {
    margin: 0;
    padding: 0;
  }
  body {
    /* A solid reserve in case the wallpaper never paints. It is the mid tone of
       the Bliss sky, so a failure looks like a plain sky and not like a white
       screen. The fallback gradient lives in Wallpaper.astro; this is the layer
       underneath, for the gap between the <body> and the image. */
    background: #4b8fd4;
  }

  /* ── Stacked mode: the page scrolls ───────────────────────────────────── */
  .xp-desktop {
    position: relative;
    min-height: 100dvh;
    /* The gap at the bottom is for the taskbar, which is fixed: without it the
       last window ends up underneath. 40 is HEIGHT from taskbar-colors.mjs. */
    padding: 12px 12px calc(40px + 16px);
    box-sizing: border-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      /* The Menu entries are real anchors, so with JavaScript off they jump to
         the section and this makes the jump visible. With JavaScript the
         switcher hides every other section and there is nothing to scroll to —
         this only ever fires on the no-JS page. */
      scroll-behavior: smooth;
    }
  }

  /* ── Desktop mode: a desktop has no scroll ──────────────────────────────
     1270 = 200 + 750 + 240 (the three windows) + 2×24 (ROW_GAP) + 2×16
     (ROW_MARGIN) — `DESKTOP_MIN_WIDTH` in `components/xp/windows.mjs`, spelled
     out because a media query cannot read a JS constant. It has to be the same
     number as the one in `Window.astro`: below it the windows stay in the
     stacked column, and a page that hid its scrollbar without them being
     absolute would be a page you cannot scroll. */
  @media (min-width: 1270px) {
    html.js,
    html.js body {
      height: 100%;
      overflow: hidden;
    }
    html.js .xp-desktop {
      height: 100dvh;
      min-height: 0;
      padding: 0;
    }
  }
</style>
